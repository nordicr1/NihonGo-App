        lines {
          text: "    keyRulePt: \'\342\200\242 Grupo 1 (Godan): \345\276\205\343\201\244 \342\206\222 \345\276\205\343\201\243\343\201\246 (matte), \351\243\262\343\202\200 \342\206\222 \351\243\262\343\202\223\343\201\247 (nonde), \346\233\270\343\201\217 \342\206\222 \346\233\270\343\201\204\343\201\246 (kaite; exceto \350\241\214\343\201\217 \342\206\222 \350\241\214\343\201\243\343\201\246), \350\251\261\343\201\231 \342\206\222 \350\251\261\343\201\227\343\201\246 (hanashite).\\n\342\200\242 Grupo 2 (Ichidan): \351\243\237\343\201\271\343\202\213 \342\206\222 \351\243\237\343\201\271\343\201\246 (tabete), \350\246\213\343\202\213 \342\206\222 \350\246\213\343\201\246 (mite).\\n\342\200\242 Grupo 3 (Irregulares): \343\201\231\343\202\213 \342\206\222 \343\201\227\343\201\246 (shite), \346\235\245\343\202\213 \342\206\222 \343\201\215\343\201\246 (kite).\',"
