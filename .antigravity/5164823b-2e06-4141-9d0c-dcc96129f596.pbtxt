 meaningPt: \'Muito obrigado por me ajudar.\'\n    }\n  },\n  {\n    id: \'v_n5_17\',\n    word: \'\343\202\210\343\202\215\343\201\227\343\201\217\343\201\212\351\241\230\343\201\204\343\201\227\343\201\276\343\201\231\',\n    reading: \'\343\202\210\343\202\215\343\201\227\343\201\217\343\201\212\343\201\255\343\201\214\343\201\204\343\201\227\343\201\276\343\201\231\',\n    romaji: \'yoroshiku onegaishimasu\',\n    meaningPt: \'Conto com voc\303\252 / Prazer em conhec\303\252-lo / Por favor\',\n    category: \'expressao\',\n    jlpt: \'N5\',\n    categoryLabelPt: \'Express\303\243o Cotidiana\',\n    exampleSentence: {\n      jp: \'\345\210\235\343\202\201\343\201\276\343\201\227\343\201\246\343\200\201\343\202\210\343\202\215\343\201\227\343\201\217\343\201\212\351\241\230\343\201\204\343\201\227\343\201\276\343\201\231\343\200\202\',\n      reading: \'\343\201\257\343\201\230\343\202\201\343\201\276\343\201\227\343\201\246\343\200\201\343\202\210\343\202\215\343\201\227\343\201\217\343\201\212\343\201\255\343\201\214\343\201\204\343\201\227\343\201\276\343\201\231\343\200\202\',\n      romaji: \'Hajimemashite, yoroshiku onegaishimasu.\',\n      meaningPt: \'Prazer em conhec\303\252-lo, conto com a sua gentileza.\'\n    }\n  },\n\n  // ===================== N4 VOCABULARY =====================\n  {\n    id: \'v_n4_1\',\n    word: \'\346\241\210\345\206\205\343\201\231\343\202\213\',\n    reading: \'\343\201\202\343\202\223\343\201\252\343\201\204\343\201\231\343\202\213\',\n    romaji: \'annai suru\',\n    meaningPt: \'Guiar / Apresentar um local\',\n    category: \'verbo_irregular\',\n    jlpt: \'N4\',\n    categoryLabelPt: \'Verbo Irregular (Grupo 3)\',\n    exampleSentence: {\n      jp: \'\350\241\227\343\202\222\346\241\210\345\206\205\343\201\227\343\201\276\343\201\227\343\202\207\343\201\206\343\201\213\343\200\202\',\n      reading: \'\343\201\276\343\201\241\343\202\222\343\201\202\343\202\223\343\201\252\343\201\204\343\201\227\343\201\276\343\201\227\343\202\207\343\201\206\343\201\213\343\200\202\',\n      romaji: \'Machi o annai shimashou ka.\',\n      meaningPt: \'Quer que eu te mostre a cidade?\'\n    }\n  },\n  {\n    id: \'v_n4_2\',\n    word: \'\351\233\206\343\202\201\343\202\213\',\n    reading: \'\343\201\202\343\201\244\343\202\201\343\202\213\',\n    romaji: \'atsumeru\',\n    meaningPt: \'Colecionar / Juntar / Reunir\',\n    category: \'verbo_ichidan\',\n    jlpt: \'N4\',\n    categoryLabelPt: \'Verbo Ichidan (Grupo 2)\',\n    exampleSentence: {\n      jp: \'\345\217\244\343\201\204\345\210\207\346\211\213\343\202\222\351\233\206\343\202\201\343\201\246\343\201\204\343\201\276\343\201\231\343\200\202\',\n      reading: \'\343\201\265\343\202\213\343\201\204\343\201\215\343\201\243\343\201\246\343\202\222\343\201\202\343\201\244\343\202\201\343\201\246\343\201\204\343\201\276\343\201\231\343\200\202\',\n      romaji: \'Furui kitte o atsumete imasu.\',\n      meaningPt: \'Estou colecionando selos antigos.\'\n    }\n  },\n  {\n    id: \'v_n4_3\',\n    word: \'\350\244\207\351\233\221\',\n    reading: \'\343\201\265\343\201\217\343\201\226\343\201\244\',\n    romaji: \'fukuzatsu\',\n    meaningPt: \'Complexo / Complicado\',\n    category: \'adjetivo_na\',\n    jlpt: \'N4\',\n    categoryLabelPt: \'Adjetivo-Na (\343\201\252\345\275\242\345\256\271\350\251\236)\',\n    exampleSentence: {\n      jp: \'\346\235\261\344\272\254\343\201\256\345\234\260\344\270\213\351\211\204\343\201\257\350\244\207\351\233\221\343\201\247\343\201\231\343\200\202\',\n      reading: \'\343\201\250\343\201\206\343\201\215\343\202\207\343\201\206\343\201\256\343\201\241\343\201\213\343\201\246\343\201\244\343\201\257\343\201\265\343\201\217\343\201\226\343\201\244\343\201\247\343\201\231\343\200\202\',\n      romaji: \'Toukyou no chikatetsu wa fukuzatsu desu.\',\n      meaningPt: \'O metr\303\264 de T\303\263quio \303\251 complexo.\'\n    }\n  },\n\n  // ===================== N3 VOCABULARY =====================\n  {\n    id: \'v_n3_1\',\n    word: \'\350\247\243\346\261\272\343\201\231\343\202\213\',\n    reading: \'\343\201\213\343\201\204\343\201\221\343\201\244\343\201\231\343\202\213\',\n    romaji: \'kaiketsu suru\',\n    meaningPt: \'Solucionar / Resolver (um problema)\',\n    category: \'verbo_irregular\',\n    jlpt: \'N3\',\n    categoryLabelPt: \'Verbo Irregular (Grupo 3)\',\n    exampleSentence: {\n      jp: \'\350\251\261\343\201\227\345\220\210\343\201\243\343\201\246\345\225\217\351\241\214\343\202\222\350\247\243\346\261\272\343\201\227\343\201\276\343\201\227\343\201\237\343\200\202\',\n      reading: \'\343\201\257\343\201\252\343\201\227\343\201\202\343\201\243\343\201\246 \343\202\202\343\202\223\343\201\240\343\201\204\343\202\222 \343\201\213\343\201\204\343\201\221\343\201\244 \343\201\227\343\201\276\343\201\227\343\201\237\343\200\202\',\n      romaji: \'Hanashiatte mondai o kaiketsu shimashita.\',\n      meaningPt: \'Resolvemos o problema conversando.\'\n    }\n  },\n  {\n    id: \'v_n3_2\',\n    word: \'\347\233\270\345\244\211\343\202\217\343\202\211\343\201\232\',\n    reading: \'\343\201\202\343\201\204\343\201\213\343\202\217\343\202\211\343\201\232\',\n    romaji: \'aikawarazu\',\n    meaningPt: \'Como sempre / Sem mudan\303\247as\',\n    category: \'adverbio\',\n    jlpt: \'N3\',\n    categoryLabelPt: \'Adv\303\251rbio (\345\211\257\350\251\236)\',\n    exampleSentence: {\n      jp: \'\345\275\274\343\201\257\347\233\270\345\244\211\343\202\217\343\202\211\343\201\232\345\205\203\346\260\227\343\201\235\343\201\206\343\201\240\343\200\202\',\n      reading: \'\343\201\213\343\202\214\343\201\257 \343\201\202\343\201\204\343\201\213\343\202\217\343\202\211\343\201\232 \343\201\222\343\202\223\343\201\215\343\201\235\343\201\206\343\201\240\343\200\202\',\n      romaji: \'Kare wa aikawarazu genki sou da.\',\n      meaningPt: \'Ele parece cheio de energia como sempre.\'\n    }\n  },\n\n  // ===================== N2 VOCABULARY =====================\n  {\n    id: \'v_n2_1\',\n    word: \'\346\212\212\346\217\241\343\201\231\343\202\213\',\n    reading: \'\343\201\257\343\201\202\343\201\217\343\201\231\343\202\213\',\n    romaji: \'haaku suru\',\n    meaningPt: \'Compreender plenamente / Dominar a situa\303\247\303\243o\',\n    category: \'verbo_irregular\',\n    jlpt: \'N2\',\n    categoryLabelPt: \'Verbo Irregular (Grupo 3)\',\n    exampleSentence: {\n      jp: \'\347\217\276\347\212\266\343\202\222\346\255\243\347\242\272\343\201\253\346\212\212\346\217\241\343\201\231\343\202\213\345\277\205\350\246\201\343\201\214\343\201\202\343\202\213\343\200\202\',\n      reading: \'\343\201\222\343\202\223\343\201\230\343\202\207\343\201\206\343\202\222 \343\201\233\343\201\204\343\201\213\343\201\217\343\201\253 \343\201\257\343\201\202\343\201\217\343\201\231\343\202\213 \343\201\262\343\201\244\343\202\210\343\201\206\343\201\214\343\201\202\343\202\213\343\200\202\',\n      romaji: \'Genjou o seikaku ni haaku suru hitsuyou ga aru.\',\n      meaningPt: \'\303\211 necess\303\241rio compreender precisamente a situa\303\247\303\243o atual.\'\n    }\n  },\n\n  // ===================== N1 VOCABULARY =====================\n  {\n    id: \'v_n1_1\',\n    word: \'\345\246\202\345\256\237\343\201\253\',\n    reading: \'\343\201\253\343\202\207\343\201\230\343\201\244\343\201\253\',\n    romaji: \'nyojitsu ni\',\n    meaningPt: \'Vividamente / Claramente / Fielmente\',\n    category: \'adverbio\',\n    jlpt: \'N1\',\n    categoryLabelPt: \'Adv\303\251rbio (\345\211\257\350\251\236)\',\n    exampleSentence: {\n      jp: \'\347\265\220\346\236\234\343\201\214\345\246\202\345\256\237\343\201\253\350\241\250\343\202\214\343\201\246\343\201\204\343\202\213\343\200\202\',\n      reading: \'\343\201\221\343\201\243\343\201\213\343\201\214 \343\201\253\343\202\207\343\201\230\343\201\244\343\201\253 \343\201\202\343\202\211\343\202\217\343\202\214\343\201\246\343\201\204\343\202\213\343\200\202\',\n      romaji: \'Kekka ga nyojitsu ni arawarete iru.\',\n      meaningPt: \'Os resultados est\303\243o demonstrados vividamente.\'\n    }\n  }\n];\n"
