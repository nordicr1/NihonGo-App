      replacement_content: "import { VocabItem } from \'../types\';\n\nexport const VOCAB_N4: VocabItem[] = [\n  // ================= VERBOS GODAN (Grupo 1) =================\n  {\n    id: \'v_n4_1\',\n    word: \'\346\211\213\344\274\235\343\201\206\',\n    reading: \'\343\201\246\343\201\244\343\201\240\343\201\206\',\n    romaji: \'tetsudau\',\n    meaningPt: \'Ajudar / Dar uma m\303\243o\',\n    category: \'verbo_godan\',\n    jlpt: \'N4\',\n    categoryLabelPt: \'Verbo Godan (Grupo 1)\',\n    exampleSentence: {\n      jp: \'\346\257\215\343\201\256\346\226\231\347\220\206\343\202\222\346\211\213\344\274\235\343\201\204\343\201\276\343\201\227\343\201\237\343\200\202\',\n      reading: \'\343\201\257\343\201\257 \343\201\256 \343\202\212\343\202\207\343\201\206\343\202\212 \343\202\222 \343\201\246\343\201\244\343\201\240\343\201\204\343\201\276\343\201\227\343\201\237\343\200\202\',\n      romaji: \'Haha no ryouri o tetsudaimashita.\',\n      meaningPt: \'Ajudei minha m\303\243e a cozinhar.\'\n    }\n  },\n  {\n    id: \'v_n4_2\',\n    word: \'\346\262\273\343\202\213\',\n    reading: \'\343\201\252\343\201\212\343\202\213\',\n    romaji: \'naoru\',\n    meaningPt: \'Curar-se / Sarar (doen\303\247a)\',\n    category: \'verbo_godan\',\n    jlpt: \'N4\',\n    categoryLabelPt: \'Verbo Godan (Grupo 1)\',\n    exampleSentence: {\n      jp: \'\351\242\250\351\202\252\343\201\214\343\201\231\343\201\243\343\201\213\343\202\212\346\262\273\343\202\212\343\201\276\343\201\227\343\201\237\343\200\202\',\n      reading: \'\343\201\213\343\201\234 \343\201\214 \343\201\231\343\201\243\343\201\213\343\202\212 \343\201\252\343\201\212\343\202\212\343\201\276\343\201\227\343\201\237\343\200\202\',\n      romaji: \'Kaze ga sukkari naorimashita.\',\n      meaningPt: \'O resfriado sarou completamente.\'\n    }\n  },\n  {\n    id: \'v_n4_3\',\n    word: \'\347\233\264\343\201\231\',\n    reading: \'\343\201\252\343\201\212\343\201\231\',\n    romaji: \'naosu\',\n    meaningPt: \'Consertar / Corrigir\',\n    category: \'verbo_godan\',\n    jlpt: \'N4\',\n    categoryLabelPt: \'Verbo Godan (Grupo 1)\',\n    exampleSentence: {\n      jp: \'\345\243\212\343\202\214\343\201\237\346\231\202\350\250\210\343\202\222\347\233\264\343\201\227\343\201\276\343\201\227\343\201\237\343\200\202\',\n      reading: \'\343\201\223\343\202\217\343\202\214\343\201\237 \343\201\250\343\201\221\343\201\204 \343\202\222 \343\201\252\343\201\212\343\201\227\343\201\276\343\201\227\343\201\237\343\200\202\',\n      romaji: \'Kowareta tokei o naoshimashita.\',\n      meaningPt: \'Consertei o rel\303\263gio quebrado.\'\n    }\n  },\n  {\n    id: \'v_n4_4\',\n    word: \'\351\201\270\343\201\266\',\n    reading: \'\343\201\210\343\202\211\343\201\266\',\n    romaji: \'erabu\',\n    meaningPt: \'Escolher / Selecionar\',\n    category: \'verbo_godan\',\n    jlpt: \'N4\',\n    categoryLabelPt: \'Verbo Godan (Grupo 1)\',\n    exampleSentence: {\n      jp: \'\345\245\275\343\201\215\343\201\252\350\211\262\343\202\222\351\201\270\343\202\223\343\201\247\343\201\217\343\201\240\343\201\225\343\201\204\343\200\202\',\n      reading: \'\343\201\231\343\201\215\343\201\252 \343\201\204\343\202\215 \343\202\222 \343\201\210\343\202\211\343\202\223\343\201\247 \343\201\217\343\201\240\343\201\225\343\201\204\343\200\202\',\n      romaji: \'Suki na iro o erande kudasai.\',\n      meaningPt: \'Por favor, escolha a sua cor preferida.\'\n    }\n  },\n  {\n    id: \'v_n4_5\',\n    word: \'\351\201\213\343\201\266\',\n    reading: \'\343\201\257\343\201\223\343\201\266\',\n    romaji: \'hakobu\',\n    meaningPt: \'Transportar / Carregar\',\n    category: \'verbo_godan\',\n    jlpt: \'N4\',\n    categoryLabelPt: \'Verbo Godan (Grupo 1)\',\n    exampleSentence: {\n      jp: \'\351\207\215\343\201\204\350\215\267\347\211\251\343\202\222\351\203\250\345\261\213\343\201\276\343\201\247\351\201\213\343\201\263\343\201\276\343\201\227\343\201\237\343\200\202\',\n      reading: \'\343\201\212\343\202\202\343\201\204 \343\201\253\343\202\202\343\201\244 \343\202\222 \343\201\270\343\202\204 \343\201\276\343\201\247 \343\201\257\343\201\223\343\201\263\343\201\276\343\201\227\343\201\237\343\200\202\',\n      romaji: \'Omoi nimotsu o heya made hakobimashita.\',\n      meaningPt: \'Carreguei a bagagem pesada at\303\251 o quarto.\'\n    }\n  },\n\n  // ================= VERBOS ICHIDAN (Grupo 2) =================\n  {\n    id: \'v_n4_6\',\n    word: \'\350\252\277\343\201\271\343\202\213\',\n    reading: \'\343\201\227\343\202\211\343\201\271\343\202\213\',\n    romaji: \'shiraberu\',\n    meaningPt: \'Pesquisar / Investigar / Averiguar\',\n    category: \'verbo_ichidan\',\n    jlpt: \'N4\',\n    categoryLabelPt: \'Verbo Ichidan (Grupo 2)\',\n    exampleSentence: {\n      jp: \'\350\276\236\346\233\270\343\201\247\345\215\230\350\252\236\343\201\256\346\204\217\345\221\263\343\202\222\350\252\277\343\201\271\343\201\276\343\201\231\343\200\202\',\n      reading: \'\343\201\230\343\201\227\343\202\207 \343\201\247 \343\201\237\343\202\223\343\201\224 \343\201\256 \343\201\204\343\201\277 \343\202\222 \343\201\227\343\202\211\343\201\271\343\201\276\343\201\231\343\200\202\',\n      romaji: \'Jisho de tango no imi o shirabemasu.\',\n      meaningPt: \'Pesquiso o significado da palavra no dicion\303\241rio.\'\n    }\n  },\n  {\n    id: \'v_n4_7\',\n    word: \'\345\277\230\343\202\214\343\202\213\',\n    reading: \'\343\202\217\343\201\231\343\202\214\343\202\213\',\n    romaji: \'wasureru\',\n    meaningPt: \'Esquecer\',\n    category: \'verbo_ichidan\',\n    jlpt: \'N4\',\n    categoryLabelPt: \'Verbo Ichidan (Grupo 2)\',\n    exampleSentence: {\n      jp: \'\345\256\277\351\241\214\343\202\222\345\256\266\343\201\253\345\277\230\343\202\214\343\201\246\343\201\227\343\201\276\343\201\204\343\201\276\343\201\227\343\201\237\343\200\202\',\n      reading: \'\343\201\227\343\202\205\343\201\217\343\201\240\343\201\204 \343\202\222 \343\201\204\343\201\210 \343\201\253 \343\202\217\343\201\231\343\202\214\343\201\246 \343\201\227\343\201\276\343\201\204\343\201\276\343\201\227\343\201\237\343\200\202\',\n      romaji: \'Shukudai o ie ni wasurete shimaimashita.\',\n      meaningPt: \'Acabei esquecendo a li\303\247\303\243o de casa em casa.\'\n    }\n  },\n  {\n    id: \'v_n4_8\',\n    word: \'\350\244\222\343\202\201\343\202\213\',\n    reading: \'\343\201\273\343\202\201\343\202\213\',\n    romaji: \'homeru\',\n    meaningPt: \'Elogiar\',\n    category: \'verbo_ichidan\',\n    jlpt: \'N4\',\n    categoryLabelPt: \'Verbo Ichidan (Grupo 2)\',\n    exampleSentence: {\n      jp: \'\343\203\206\343\202\271\343\203\210\343\201\247\350\211\257\343\201\204\347\202\271\343\202\222\345\217\226\343\201\243\343\201\246\343\200\201\345\205\210\347\224\237\343\201\253\350\244\222\343\202\201\343\202\211\343\202\214\343\201\276\343\201\227\343\201\237\343\200\202\',\n      reading: \'\343\203\206\343\202\271\343\203\210 \343\201\247 \343\202\210\343\201\204\343\201\246\343\202\223 \343\202\222 \343\201\250\343\201\243\343\201\246\343\200\201\343\201\233\343\202\223\343\201\233\343\201\204 \343\201\253 \343\201\273\343\202\201\343\202\211\343\202\214\343\201\276\343\201\227\343\201\237\343\200\202\',\n      romaji: \'Tesuto de yoi ten o totte, sensei ni homeraremashita.\',\n      meaningPt: \'Tirei nota boa na prova e fui elogiado pelo professor.\'\n    }\n  },\n  {\n    id: \'v_n4_9\',\n    word: \'\345\261\212\343\201\221\343\202\213\',\n    reading: \'\343\201\250\343\201\251\343\201\221\343\202\213\',\n    romaji: \'todokeru\',\n    meaningPt: \'Entregar / Notificar\',\n    category: \'verbo_ichidan\',\n    jlpt: \'N4\',\n    categoryLabelPt: \'Verbo Ichidan (Grupo 2)\',\n    exampleSentence: {\n      jp: \'\346\213\276\343\201\243\343\201\237\350\262\241\345\270\203\343\202\222\344\272\244\347\225\252\343\201\253\345\261\212\343\201\221\343\201\276\343\201\227\343\201\237\343\200\202\',\n      reading: \'\343\201\262\343\202\215\343\201\243\343\201\237 \343\201\225\343\201\204\343\201\265 \343\202\222 \343\201\223\343\201\206\343\201\260\343\202\223 \343\201\253 \343\201\250\343\201\251\343\201\221\343\201\276\343\201\227\343\201\237\343\200\202\',\n      romaji: \'Hirotta saifu o kouban ni todokemashita.\',\n      meaningPt: \'Entreguei a carteira achada no posto policial.\'\n    }\n  },\n\n  // ================= VERBOS IRREGULARES =================\n  {\n    id: \'v_n4_10\',\n    word: \'\346\241\210\345\206\205\343\201\231\343\202\213\',\n    reading: \'\343\201\202\343\202\223\343\201\252\343\201\204\343\201\231\343\202\213\',\n    romaji: \'annai suru\',\n    meaningPt: \'Guiar / Apresentar o local\',\n    category: \'verbo_irregular\',\n    jlpt: \'N4\',\n    categoryLabelPt: \'Verbo Irregular (Grupo 3)\',\n    exampleSentence: {\n      jp: \'\346\235\261\344\272\254\343\201\256\350\246\263\345\205\211\345\234\260\343\202\222\346\241\210\345\206\205\343\201\227\343\201\276\343\201\231\343\200\202\',\n      reading: \'\343\201\250\343\201\206\343\201\215\343\202\207\343\201\206 \343\201\256 \343\201\213\343\202\223\343\201\223\343\201\206\343\201\241 \343\202\222 \343\201\202\343\202\223\343\201\252\343\201\204 \343\201\227\343\201\276\343\201\231\343\200\202\',\n      romaji: \'Toukyou no kankouchi o annai shimasu.\',\n      meaningPt: \'Vou te guiar pelos pontos tur\303\255sticos de T\303\263quio.\'\n    }\n  },\n  {\n    id: \'v_n4_11\',\n    word: \'\344\272\210\347\264\204\343\201\231\343\202\213\',\n    reading: \'\343\202\210\343\202\204\343\201\217\343\201\231\343\202\213\',\n    romaji: \'yoyaku suru\',\n    meaningPt: \'Reservar / Agendar\',\n    category: \'verbo_irregular\',\n    jlpt: \'N4\',\n    categoryLabelPt: \'Verbo Irregular (Grupo 3)\',\n    exampleSentence: {\n      jp: \'\344\272\272\346\260\227\343\201\256\343\203\254\343\202\271\343\203\210\343\203\251\343\203\263\343\202\222\344\272\210\347\264\204\343\201\227\343\201\276\343\201\227\343\201\237\343\200\202\',\n      reading: \'\343\201\253\343\202\223\343\201\215 \343\201\256 \343\203\254\343\202\271\343\203\210\343\203\251\343\203\263 \343\202\222 \343\202\210\343\202\204\343\201\217 \343\201\227\343\201\276\343\201\227\343\201\237\343\200\202\',\n      romaji: \'Ninki no resutoran o yoyaku shimashita.\',\n      meaningPt: \'Reservei o restaurante concorrido.\'\n    }\n  },\n\n  // ================= ADJETIVOS-I (\343\201\204) & ADJETIVOS-NA (\343\201\252) =================\n  {\n    id: \'v_n4_12\',\n    word: \'\347\217\215\343\201\227\343\201\204\',\n    reading: \'\343\202\201\343\201\232\343\202\211\343\201\227\343\201\204\',\n    romaji: \'mezurashii\',\n    meaningPt: \'Raro / Incomum\',\n    category: \'adjetivo_i\',\n    jlpt: \'N4\',\n    categoryLabelPt: \'Adjetivo-I (\343\201\204)\',\n    exampleSentence: {\n      jp: \'\347\217\215\343\201\227\343\201\204\351\263\245\343\202\222\350\246\213\343\201\213\343\201\221\343\201\276\343\201\227\343\201\237\343\200\202\',\n      reading: \'\343\202\201\343\201\232\343\202\211\343\201\227\343\201\204 \343\201\250\343\202\212 \343\202\222 \343\201\277\343\201\213\343\201\221\343\201\276\343\201\227\343\201\237\343\200\202\',\n      romaji: \'Mezurashii tori o mikakemashita.\',\n      meaningPt: \'Avistei um p\303\241ssaro raro.\'\n    }\n  },\n  {\n    id: \'v_n4_13\',\n    word: \'\345\216\263\343\201\227\343\201\204\',\n    reading: \'\343\201\215\343\201\263\343\201\227\343\201\204\',\n    romaji: \'kibishii\',\n    meaningPt: \'Severo / Estrito / Rigoroso\',\n    category: \'adjetivo_i\',\n    jlpt: \'N4\',\n    categoryLabelPt: \'Adjetivo-I (\343\201\204)\',\n    exampleSentence: {\n      jp: \'\345\205\210\347\224\237\343\201\256\346\214\207\345\260\216\343\201\257\345\216\263\343\201\227\343\201\204\343\201\247\343\201\231\343\201\214\343\200\201\345\204\252\343\201\227\343\201\204\343\201\247\343\201\231\343\200\202\',\n      reading: \'\343\201\233\343\202\223\343\201\233\343\201\204 \343\201\256 \343\201\227\343\201\251\343\201\206 \343\201\257 \343\201\215\343\201\263\343\201\227\343\201\204 \343\201\247\343\201\231 \343\201\214\343\200\201\343\202\204\343\201\225\343\201\227\343\201\204 \343\201\247\343\201\231\343\200\202\',\n      romaji: \'Sensei no shidou wa kibishii desu ga, yasashii desu.\',\n      meaningPt: \'A orienta\303\247\303\243o do professor \303\251 rigorosa, mas ele \303\251 atencioso.\'\n    }\n  },\n  {\n    id: \'v_n4_14\',\n    word: \'\350\244\207\351\233\221\',\n    reading: \'\343\201\265\343\201\217\343\201\226\343\201\244\',\n    romaji: \'fukuzatsu\',\n    meaningPt: \'Complexo / Complicado\',\n    category: \'adjetivo_na\',\n    jlpt: \'N4\',\n    categoryLabelPt: \'Adjetivo-Na (\343\201\252)\',\n    exampleSentence: {\n      jp: \'\343\201\223\343\201\256\346\251\237\346\242\260\343\201\256\344\275\277\343\201\204\346\226\271\343\201\257\345\260\221\343\201\227\350\244\207\351\233\221\343\201\247\343\201\231\343\200\202\',\n      reading: \'\343\201\223\343\201\256 \343\201\215\343\201\213\343\201\204 \343\201\256 \343\201\244\343\201\213\343\201\204\343\201\213\343\201\237 \343\201\257 \343\201\231\343\201\223\343\201\227 \343\201\265\343\201\217\343\201\226\343\201\244 \343\201\247\343\201\231\343\200\202\',\n      romaji: \'Kono kikai no tsukaikata wa sukoshi fukuzatsu desu.\',\n      meaningPt: \'O modo de usar desta m\303\241quina \303\251 um pouco complexo.\'\n    }\n  },\n  {\n    id: \'v_n4_15\',\n    word: \'\345\277\205\350\246\201\',\n    reading: \'\343\201\262\343\201\244\343\202\210\343\201\206\',\n    romaji: \'hitsuyou\',\n    meaningPt: \'Necess\303\241rio / Indispens\303\241vel\',\n    category: \'adjetivo_na\',\n    jlpt: \'N4\',\n    categoryLabelPt: \'Adjetivo-Na (\343\201\252)\',\n    exampleSentence: {\n      jp: \'\343\203\223\343\202\266\343\201\256\347\224\263\350\253\213\343\201\253\343\201\257\343\203\221\343\202\271\343\203\235\343\203\274\343\203\210\343\201\214\345\277\205\350\246\201\343\201\247\343\201\231\343\200\202\',\n      reading: \'\343\203\223\343\202\266 \343\201\256 \343\201\227\343\202\223\343\201\233\343\201\204 \343\201\253 \343\201\257 \343\203\221\343\202\271\343\203\235\343\203\274\343\203\210 \343\201\214 \343\201\262\343\201\244\343\202\210\343\201\206 \343\201\247\343\201\231\343\200\202\',\n      romaji: \'Biza no shinsei ni wa pasupooto ga hitsuyou desu.\',\n      meaningPt: \'O passaporte \303\251 necess\303\241rio para a solicita\303\247\303\243o do visto.\'\n    }\n  },\n\n  // ================= SUBSTANTIVOS =================\n  {\n    id: \'v_n4_16\',\n    word: \'\347\265\214\351\250\223\',\n    reading: \'\343\201\221\343\201\204\343\201\221\343\202\223\',\n    romaji: \'keiken\',\n    meaningPt: \'Experi\303\252ncia / Viv\303\252ncia\',\n    category: \'substantivo\',\n    jlpt: \'N4\',\n    categoryLabelPt: \'Substantivo\',\n    exampleSentence: {\n      jp: \'\346\227\245\346\234\254\343\201\247\343\201\256\347\224\237\346\264\273\343\201\257\347\264\240\346\231\264\343\202\211\343\201\227\343\201\204\347\265\214\351\250\223\343\201\253\343\201\252\343\202\212\343\201\276\343\201\227\343\201\237\343\200\202\',\n      reading: \'\343\201\253\343\201\273\343\202\223 \343\201\247 \343\201\256 \343\201\233\343\201\204\343\201\213\343\201\244 \343\201\257 \343\201\231\343\201\260\343\202\211\343\201\227\343\201\204 \343\201\221\343\201\204\343\201\221\343\202\223 \343\201\253 \343\201\252\343\202\212\343\201\276\343\201\227\343\201\237\343\200\202\',\n      romaji: \'Nihon de no seikatsu wa subarashii keiken ni narimashita.\',\n      meaningPt: \'A vida no Jap\303\243o se tornou uma viv\303\252ncia extraordin\303\241ria.\'\n    }\n  },\n  {\n    id: \'v_n4_17\',\n    word: \'\347\264\204\346\235\237\',\n    reading: \'\343\202\204\343\201\217\343\201\235\343\201\217\',\n    romaji: \'yakusoku\',\n    meaningPt: \'Promessa / Compromisso\',\n    category: \'substantivo\',\n    jlpt: \'N4\',\n    categoryLabelPt: \'Substantivo\',\n    exampleSentence: {\n      jp: \'\345\217\213\351\201\224\343\201\250\343\201\256\347\264\204\346\235\237\343\202\222\345\256\210\343\202\212\343\201\276\343\201\231\343\200\202\',\n      reading: \'\343\201\250\343\202\202\343\201\240\343\201\241 \343\201\250 \343\201\256 \343\202\204\343\201\217\343\201\235\343\201\217 \343\202\222 \343\201\276\343\202\202\343\202\212\343\201\276\343\201\231\343\200\202\',\n      romaji: \'Tomodachi to no yakusoku o mamorimasu.\',\n      meaningPt: \'Cumpro meus compromissos com os amigos.\'\n    }\n  },\n  {\n    id: \'v_n4_18\',\n    word: \'\346\226\207\345\214\226\',\n    reading: \'\343\201\266\343\202\223\343\201\213\',\n    romaji: \'bunka\',\n    meaningPt: \'Cultura\',\n    category: \'substantivo\',\n    jlpt: \'N4\',\n    categoryLabelPt: \'Substantivo\',\n    exampleSentence: {\n      jp: \'\346\227\245\346\234\254\343\201\256\344\274\235\347\265\261\346\226\207\345\214\226\343\201\253\350\210\210\345\221\263\343\201\214\343\201\202\343\202\212\343\201\276\343\201\231\343\200\202\',\n      reading: \'\343\201\253\343\201\273\343\202\223 \343\201\256 \343\201\247\343\202\223\343\201\250\343\201\206 \343\201\266\343\202\223\343\201\213 \343\201\253 \343\201\215\343\202\207\343\201\206\343\201\277 \343\201\214 \343\201\202\343\202\212\343\201\276\343\201\231\343\200\202\',\n      romaji: \'Nihon no dentou bunka ni kyoumi ga arimasu.\',\n      meaningPt: \'Tenho interesse pela cultura tradicional japonesa.\'\n    }\n  },\n\n  // ================= ADV\303\211RBIOS & CONECTIVOS =================\n  {\n    id: \'v_n4_19\',\n    word: \'\343\201\252\343\201\213\343\201\252\343\201\213\',\n    reading: \'\343\201\252\343\201\213\343\201\252\343\201\213\',\n    romaji: \'nakanaka\',\n    meaningPt: \'Dificilmente (com negativo) / Bastante\',\n    category: \'adverbio\',\n    jlpt: \'N4\',\n    categoryLabelPt: \'Adv\303\251rbio\',\n    exampleSentence: {\n      jp: \'\343\203\220\343\202\271\343\201\214\343\201\252\343\201\213\343\201\252\343\201\213\346\235\245\343\201\276\343\201\233\343\202\223\343\200\202\',\n      reading: \'\343\203\220\343\202\271 \343\201\214 \343\201\252\343\201\213\343\201\252\343\201\213 \343\201\215\343\201\276\343\201\233\343\202\223\343\200\202\',\n      romaji: \'Basu ga nakanaka kimasen.\',\n      meaningPt: \'O \303\264nibus demora muito / n\303\243o vem de jeito nenhum.\'\n    }\n  },\n  {\n    id: \'v_n4_20\',\n    word: \'\345\256\237\343\201\257\',\n    reading: \'\343\201\230\343\201\244\343\201\257\',\n    romaji: \'jitsu wa\',\n    meaningPt: \'Na verdade / A bem da verdade\',\n    category: \'adverbio\',\n    jlpt: \'N4\',\n    categoryLabelPt: \'Adv\303\251rbio / Conector\',\n    exampleSentence: {\n      jp: \'\345\256\237\343\201\257\343\200\201\346\235\245\346\234\210\346\227\245\346\234\254\343\201\270\345\274\225\343\201\243\350\266\212\343\201\227\343\201\276\343\201\231\343\200\202\',\n      reading: \'\343\201\230\343\201\244\343\201\257\343\200\201\343\202\211\343\201\204\343\201\222\343\201\244 \343\201\253\343\201\273\343\202\223 \343\201\270 \343\201\262\343\201\243\343\201\223\343\201\227\343\201\276\343\201\231\343\200\202\',\n      romaji: \'Jitsu wa, raigetsu nihon e hikkoshimasu.\',\n      meaningPt: \'Na verdade, vou me mudar para o Jap\303\243o no m\303\252s que vem.\'\n    }\n  }\n];\n"
