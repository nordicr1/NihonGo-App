  file_change {
    absolute_path_uri: "file:///src/data/grammarN5.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { GrammarItem } from \'../types\';\n\nexport const GRAMMAR_N5: GrammarItem[] = [\n  {\n    id: \'g_n5_1\',\n    pattern: \'A \343\201\257 B \343\201\247\343\201\231 (A wa B desu)\',\n    titlePt: \'Estrutura B\303\241sica de Frase: \"A \303\251 B\"\',\n    jlpt: \'N5\',\n    category: \'Estruturas B\303\241sicas\',\n    formationFormula: \'[Substantivo A] + \343\201\257 (l\303\252-se \"wa\") + [Substantivo / Adjetivo B] + \343\201\247\343\201\231\',\n    explanationPt: \'A part\303\255cula \343\201\257 (escrita como \"ha\", mas pronunciada \"wa\") indica o T\303\263pico da frase (aquilo sobre o qual estamos falando). O termo \343\201\247\343\201\231 (desu) \303\251 a c\303\263pula formal que equivale a \"\303\251 / sou / somos\".\',\n    keyRulePt: \'\342\200\242 Forma Negativa: A \343\201\257 B \343\201\247\343\201\257\343\201\202\343\202\212\343\201\276\343\201\233\343\202\223 (dewa arimasen) ou \343\201\230\343\202\203\343\201\202\343\202\212\343\201\276\343\201\233\343\202\223 (ja arimasen).\\n\342\200\242 Forma Interrogativa: basta acrescentar a part\303\255cula \343\201\213 (ka) no final da frase sem ponto de interroga\303\247\303\243o.\',\n    examples: [\n      {\n        jp: \'\347\247\201\343\201\257\345\255\246\347\224\237\343\201\247\343\201\231\343\200\202\',\n        reading: \'\343\202\217\343\201\237\343\201\227 \343\201\257 \343\201\214\343\201\217\343\201\233\343\201\204 \343\201\247\343\201\231\343\200\202\',\n        romaji: \'Watashi wa gakusei desu.\',\n        meaningPt: \'Eu sou estudante.\'\n      },\n      {\n        jp: \'\347\224\260\344\270\255\343\201\225\343\202\223\343\201\257\346\227\245\346\234\254\344\272\272\343\201\247\343\201\231\343\200\202\',\n        reading: \'\343\201\237\343\201\252\343\201\213\343\201\225\343\202\223 \343\201\257 \343\201\253\343\201\273\343\202\223\343\201\230\343\202\223 \343\201\247\343\201\231\343\200\202\',\n        romaji: \'Tanaka-san wa nihonjin desu.\',\n        meaningPt: \'O Sr. Tanaka \303\251 japon\303\252s.\'\n      },\n      {\n        jp: \'\343\201\223\343\202\214\343\201\257\343\203\232\343\203\263\343\201\247\343\201\257\343\201\202\343\202\212\343\201\276\343\201\233\343\202\223\343\200\202\',\n        reading: \'\343\201\223\343\202\214 \343\201\257 \343\203\232\343\203\263 \343\201\247\343\201\257\343\201\202\343\202\212\343\201\276\343\201\233\343\202\223\343\200\202\',\n        romaji: \'Kore wa pen dewa arimasen.\',\n        meaningPt: \'Isto n\303\243o \303\251 uma caneta.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n5_2\',\n    pattern: \'Part\303\255culas Principais (\343\202\222, \343\201\253, \343\201\247, \343\201\270, \343\201\250, \343\202\202, \343\201\214, \343\201\213\343\202\211, \343\201\276\343\201\247)\',\n    titlePt: \'Guia Completo de Part\303\255culas Essenciais (\345\212\251\350\251\236)\',\n    jlpt: \'N5\',\n    category: \'Part\303\255culas\',\n    formationFormula: \'[Substantivo] + [Part\303\255cula] + [Verbo / Predicado]\',\n    explanationPt: \'As part\303\255culas s\303\243o sufixos gramaticais fundamentais no japon\303\252s que conectam palavras e definem seu papel na ora\303\247\303\243o.\',\n    keyRulePt: \'\342\200\242 \343\202\222 (o): Marca o Objeto Direto da a\303\247\303\243o (\346\234\254\343\202\222\350\252\255\343\202\200 - ler livro).\\n\342\200\242 \343\201\253 (ni): Destino exato, tempo pontual (7\346\231\202\343\201\253) ou localiza\303\247\303\243o est\303\241tica (\351\203\250\345\261\213\343\201\253\343\201\204\343\202\213).\\n\342\200\242 \343\201\247 (de): Local de a\303\247\303\243o din\303\242mica (\345\255\246\346\240\241\343\201\247\345\213\211\345\274\267\343\201\231\343\202\213) ou meio/instrumento (\343\203\220\343\202\271\343\201\247\350\241\214\343\201\217).\\n\342\200\242 \343\201\270 (e): Dire\303\247\303\243o geral do movimento (\346\227\245\346\234\254\343\201\270\350\241\214\343\201\217).\\n\342\200\242 \343\201\250 (to): Conjun\303\247\303\243o \"e\" e companhia \"com\" (\345\217\213\351\201\224\343\201\250).\\n\342\200\242 \343\202\202 (mo): \"Tamb\303\251m / Nem\" (substitui \343\201\257, \343\201\214 e \343\202\222).\\n\342\200\242 \343\201\214 (ga): Sujeito ativo ou foco de identifica\303\247\303\243o.\\n\342\200\242 \343\201\213\343\202\211 / \343\201\276\343\201\247 (kara / made): \"De / A partir de\" e \"At\303\251\".\',\n    examples: [\n      {\n        jp: \'\343\203\254\343\202\271\343\203\210\343\203\251\343\203\263\343\201\247\345\257\277\345\217\270\343\202\222\351\243\237\343\201\271\343\201\276\343\201\231\343\200\202\',\n        reading: \'\343\203\254\343\202\271\343\203\210\343\203\251\343\203\263 \343\201\247 \343\201\231\343\201\227 \343\202\222 \343\201\237\343\201\271\343\201\276\343\201\231\343\200\202\',\n        romaji: \'Resutoran de sushi o tabemasu.\',\n        meaningPt: \'Como sushi no restaurante.\'\n      },\n      {\n        jp: \'\346\234\235\345\205\253\346\231\202\343\201\253\345\255\246\346\240\241\343\201\270\350\241\214\343\201\215\343\201\276\343\201\231\343\200\202\',\n        reading: \'\343\201\202\343\201\225 \343\201\257\343\201\241\343\201\230 \343\201\253 \343\201\214\343\201\243\343\201\223\343\201\206 \343\201\270 \343\201\204\343\201\215\343\201\276\343\201\231\343\200\202\',\n        romaji: \'Asa hachiji ni gakkou e ikimasu.\',\n        meaningPt: \'Vou para a escola \303\240s 8h da manh\303\243.\'\n      },\n      {\n        jp: \'\344\271\235\346\231\202\343\201\213\343\202\211\344\272\224\346\231\202\343\201\276\343\201\247\345\203\215\343\201\215\343\201\276\343\201\231\343\200\202\',\n        reading: \'\343\201\217\343\201\230 \343\201\213\343\202\211 \343\201\224\343\201\230 \343\201\276\343\201\247 \343\201\257\343\201\237\343\202\211\343\201\215\343\201\276\343\201\231\343\200\202\',\n        romaji: \'Kuji kara goji made hatarakimasu.\',\n        meaningPt: \'Trabalho das 9h \303\240s 17h.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n5_3\',\n    pattern: \'Conjuga\303\247\303\243o Formal (\343\200\234\343\201\276\343\201\231 / \343\200\234\343\201\276\343\201\233\343\202\223 / \343\200\234\343\201\276\343\201\227\343\201\237 / \343\200\234\343\201\276\343\201\233\343\202\223\343\201\247\343\201\227\343\201\237)\',\n    titlePt: \'Tempos Verbais Polidos na Forma MASU\',\n    jlpt: \'N5\',\n    category: \'Verbos & Conjuga\303\247\303\243o\',\n    formationFormula: \'[Raiz do Verbo] + \343\201\276\343\201\231 (presente/futuro) / \343\201\276\343\201\233\343\202\223 (negativo) / \343\201\276\343\201\227\343\201\237 (passado) / \343\201\276\343\201\233\343\202\223\343\201\247\343\201\227\343\201\237 (passado negativo)\',\n    explanationPt: \'\303\211 o padr\303\243o de polidez (Teineigo) usado com professores, colegas de trabalho e desconhecidos.\',\n    keyRulePt: \'\342\200\242 Presente / Futuro Afirmativo: \351\243\237\343\201\271\343\201\276\343\201\231 (como / comerei)\\n\342\200\242 Presente / Futuro Negativo: \351\243\237\343\201\271\343\201\276\343\201\233\343\202\223 (n\303\243o como / n\303\243o comerei)\\n\342\200\242 Passado Afirmativo: \351\243\237\343\201\271\343\201\276\343\201\227\343\201\237 (comi)\\n\342\200\242 Passado Negativo: \351\243\237\343\201\271\343\201\276\343\201\233\343\202\223\343\201\247\343\201\227\343\201\237 (n\303\243o comi)\',\n    examples: [\n      {\n        jp: \'\346\230\250\346\227\245\343\200\201\346\227\245\346\234\254\350\252\236\343\202\222\345\213\211\345\274\267\343\201\227\343\201\276\343\201\227\343\201\237\343\200\202\',\n        reading: \'\343\201\215\343\201\256\343\201\206\343\200\201\343\201\253\343\201\273\343\202\223\343\201\224 \343\202\222 \343\201\271\343\202\223\343\201\215\343\202\207\343\201\206 \343\201\227\343\201\276\343\201\227\343\201\237\343\200\202\',\n        romaji: \'Kinou, nihongo o benkyou shimashita.\',\n        meaningPt: \'Ontem estudei japon\303\252s.\'\n      },\n      {\n        jp: \'\346\230\216\346\227\245\343\201\257\345\203\215\343\201\215\343\201\276\343\201\233\343\202\223\343\200\202\',\n        reading: \'\343\201\202\343\201\227\343\201\237 \343\201\257 \343\201\257\343\201\237\343\202\211\343\201\215\343\201\276\343\201\233\343\202\223\343\200\202\',\n        romaji: \'Ashita wa hatarakimasen.\',\n        meaningPt: \'Amanh\303\243 n\303\243o irei trabalhar.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n5_4\',\n    pattern: \'Verbo em Forma-TE + \343\201\217\343\201\240\343\201\225\343\201\204 (~te kudasai)\',\n    titlePt: \'Pedidos e Instru\303\247\303\265es Polidas: \"Por favor, fa\303\247a...\"\',\n    jlpt: \'N5\',\n    category: \'Pedidos & Ordens\',\n    formationFormula: \'[Verbo na forma-TE] + \343\201\217\343\201\240\343\201\225\343\201\204\',\n    explanationPt: \'A forma-TE \303\251 o conector verbal universal em japon\303\252s. Adicionar \343\201\217\343\201\240\343\201\225\343\201\204 cria um pedido educado.\',\n    keyRulePt: \'\342\200\242 Grupo 1 (Godan): \345\276\205\343\201\244 \342\206\222 \345\276\205\343\201\243\343\201\246 (matte), \351\243\262\343\202\200 \342\206\222 \351\243\262\343\202\223\343\201\247 (nonde), \346\233\270\343\201\217 \342\206\222 \346\233\270\343\201\204\343\201\246 (kaite; exceto \350\241\214\343\201\217 \342\206\222 \350\241\214\343\201\243\343\201\246), \350\251\261\343\201\231 \342\206\222 \350\251\261\343\201\227\343\201\246 (hanashite).\\n\342\200\242 Grupo 2 (Ichidan): \351\243\237\343\201\271\343\202\213 \342\206\222 \351\243\237\343\201\271\343\201\246 (tabete), \350\246\213\343\202\213 \342\206\222 \350\246\213\343\201\246 (mite).\\n\342\200\242 Grupo 3 (Irregulares): \343\201\231\343\202\213 \342\206\222 \343\201\227\343\201\246 (shite), \346\235\245\343\202\213 \342\206\222 \343\201\215\343\201\246 (kite).\',\n    examples: [\n      {\n        jp: \'\343\201\241\343\202\207\343\201\243\343\201\250\345\276\205\343\201\243\343\201\246\343\201\217\343\201\240\343\201\225\343\201\204\343\200\202\',\n        reading: \'\343\201\241\343\202\207\343\201\243\343\201\250 \343\201\276\343\201\243\343\201\246\343\201\217\343\201\240\343\201\225\343\201\204\343\200\202\',\n        romaji: \'Chotto matte kudasai.\',\n        meaningPt: \'Por favor, espere um instante.\'\n      },\n      {\n        jp: \'\346\227\245\346\234\254\350\252\236\343\201\247\350\251\261\343\201\227\343\201\246\343\201\217\343\201\240\343\201\225\343\201\204\343\200\202\',\n        reading: \'\343\201\253\343\201\273\343\202\223\343\201\224 \343\201\247 \343\201\257\343\201\252\343\201\227\343\201\246 \343\201\217\343\201\240\343\201\225\343\201\204\343\200\202\',\n        romaji: \'Nihongo de hanashite kudasai.\',\n        meaningPt: \'Por favor, fale em japon\303\252s.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n5_5\',\n    pattern: \'Verbo em Forma-TE + \343\201\204\343\201\276\343\201\231 (~te imasu)\',\n    titlePt: \'A\303\247\303\243o Cont\303\255nua / Estado Atual (Ger\303\272ndio e Condi\303\247\303\243o)\',\n    jlpt: \'N5\',\n    category: \'Aspecto Verbal\',\n    formationFormula: \'[Verbo na forma-TE] + \343\201\204\343\201\276\343\201\231 / \343\201\204\343\201\276\343\201\233\343\202\223 / \343\201\204\343\201\276\343\201\227\343\201\237\',\n    explanationPt: \'Expressa duas ideias fundamentais: 1) A\303\247\303\243o acontecendo agora mesmo (\"estou comendo\"), 2) Estado resultante cont\303\255nuo (\"estou casado\", \"moro em T\303\263quio\", \"conhe\303\247o\").\',\n    keyRulePt: \'\342\200\242 A\303\247\303\243o cont\303\255nua: \344\273\212\343\200\201\346\234\254\343\202\222\350\252\255\343\202\223\343\201\247\343\201\204\343\201\276\343\201\231 (Estou lendo um livro agora).\\n\342\200\242 Estado cont\303\255nuo: \346\235\261\344\272\254\343\201\253\344\275\217\343\202\223\343\201\247\343\201\204\343\201\276\343\201\231 (Moro em T\303\263quio - estado permanente).\\n\342\200\242 Conhecimento: \347\237\245\343\201\243\343\201\246\343\201\204\343\201\276\343\201\231 (Sei / Conhe\303\247o). Negativo: \347\237\245\343\202\212\343\201\276\343\201\233\343\202\223 (N\303\243o sei).\',\n    examples: [\n      {\n        jp: \'\344\273\212\343\200\201\346\227\245\346\234\254\350\252\236\343\202\222\345\213\211\345\274\267\343\201\227\343\201\246\343\201\204\343\201\276\343\201\231\343\200\202\',\n        reading: \'\343\201\204\343\201\276\343\200\201\343\201\253\343\201\273\343\202\223\343\201\224 \343\202\222 \343\201\271\343\202\223\343\201\215\343\202\207\343\201\206 \343\201\227\343\201\246\343\201\204\343\201\276\343\201\231\343\200\202\',\n        romaji: \'Ima, nihongo o benkyou shite imasu.\',\n        meaningPt: \'Estou estudando japon\303\252s agora.\'\n      },\n      {\n        jp: \'\347\224\260\344\270\255\343\201\225\343\202\223\343\201\257\346\235\261\344\272\254\343\201\253\344\275\217\343\202\223\343\201\247\343\201\204\343\201\276\343\201\231\343\200\202\',\n        reading: \'\343\201\237\343\201\252\343\201\213\343\201\225\343\202\223 \343\201\257 \343\201\250\343\201\206\343\201\215\343\202\207\343\201\206 \343\201\253 \343\201\231\343\202\223\343\201\247\343\201\204\343\201\276\343\201\231\343\200\202\',\n        romaji: \'Tanaka-san wa Toukyou ni sunde imasu.\',\n        meaningPt: \'O Sr. Tanaka mora em T\303\263quio.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n5_6\',\n    pattern: \'Verbo em Forma-TE + \343\202\202\343\201\204\343\201\204\343\201\247\343\201\231\343\201\213 (~te mo ii desu ka)\',\n    titlePt: \'Pedir Permiss\303\243o: \"Posso fazer...?\"\',\n    jlpt: \'N5\',\n    category: \'Permiss\303\243o & Proibi\303\247\303\243o\',\n    formationFormula: \'[Verbo na forma-TE] + \343\202\202\343\201\204\343\201\204\343\201\247\343\201\231\343\201\213\',\n    explanationPt: \'Estrutura gentil usada para pedir autoriza\303\247\303\243o para realizar alguma a\303\247\303\243o.\',\n    keyRulePt: \'\342\200\242 Para responder concedendo permiss\303\243o: \343\201\210\343\201\210\343\200\201\343\201\204\343\201\204\343\201\247\343\201\231\343\202\210 (Sim, pode).\\n\342\200\242 Para proibir (Proibi\303\247\303\243o Formal): Forma-TE + \343\201\257\350\241\214\343\201\221\343\201\276\343\201\233\343\202\223 / \343\201\257\343\201\240\343\202\201\343\201\247\343\201\231 (~te wa ikemasen / wa dame desu = \"N\303\243o pode fazer isso\").\',\n    examples: [\n      {\n        jp: \'\345\206\231\347\234\237\343\202\222\346\222\256\343\201\243\343\201\246\343\202\202\343\201\204\343\201\204\343\201\247\343\201\231\343\201\213\343\200\202\',\n        reading: \'\343\201\227\343\202\203\343\201\227\343\202\223 \343\202\222 \343\201\250\343\201\243\343\201\246\343\202\202 \343\201\204\343\201\204\343\201\247\343\201\231\343\201\213\343\200\202\',\n        romaji: \'Shashin o totte mo ii desu ka.\',\n        meaningPt: \'Posso tirar uma foto?\'\n      },\n      {\n        jp: \'\343\201\223\343\201\223\343\201\247\343\202\277\343\203\220\343\202\263\343\202\222\345\220\270\343\201\243\343\201\246\343\201\257\343\201\204\343\201\221\343\201\276\343\201\233\343\202\223\343\200\202\',\n        reading: \'\343\201\223\343\201\223\343\201\247 \343\202\277\343\203\220\343\202\263 \343\202\222 \343\201\231\343\201\243\343\201\246\343\201\257 \343\201\204\343\201\221\343\201\276\343\201\233\343\202\223\343\200\202\',\n        romaji: \'Koko de tabako o sutte wa ikemasen.\',\n        meaningPt: \'N\303\243o se pode fumar aqui (\303\211 proibido fumar aqui).\'\n      }\n    ]\n  },\n  {\n    id: \'g_n5_7\',\n    pattern: \'Verbo em Forma-NAI + \343\201\247\343\201\217\343\201\240\343\201\225\343\201\204 (~naide kudasai)\',\n    titlePt: \'Pedido Negativo: \"Por favor, n\303\243o fa\303\247a...\"\',\n    jlpt: \'N5\',\n    category: \'Pedidos & Ordens\',\n    formationFormula: \'[Verbo na forma-NAI (negativa informal)] + \343\201\247\343\201\217\343\201\240\343\201\225\343\201\204\',\n    explanationPt: \'Usado para pedir encarecidamente que algu\303\251m n\303\243o execute determinada a\303\247\303\243o.\',\n    keyRulePt: \'\342\200\242 Godan: termina em som \"a\" + \343\201\252\343\201\204 (\346\233\270\343\201\217 \342\206\222 \346\233\270\343\201\213\343\201\252\343\201\204 \342\206\222 \346\233\270\343\201\213\343\201\252\343\201\204\343\201\247\343\201\217\343\201\240\343\201\225\343\201\204).\\n\342\200\242 Ichidan: tira o \343\202\213 + \343\201\252\343\201\204 (\351\243\237\343\201\271\343\202\213 \342\206\222 \351\243\237\343\201\271\343\201\252\343\201\204 \342\206\222 \351\243\237\343\201\271\343\201\252\343\201\204\343\201\247\343\201\217\343\201\240\343\201\225\343\201\204).\\n\342\200\242 Irregulares: \343\201\231\343\202\213 \342\206\222 \343\201\227\343\201\252\343\201\204\343\201\247\343\201\217\343\201\240\343\201\225\343\201\204 / \346\235\245\343\202\213 \342\206\222 \343\201\223\343\201\252\343\201\204\343\201\247\343\201\217\343\201\240\343\201\225\343\201\204 (k\345\205\207naide kudasai).\',\n    examples: [\n      {\n        jp: \'\343\201\223\343\201\223\343\201\247\345\206\231\347\234\237\343\202\222\346\222\256\343\202\211\343\201\252\343\201\204\343\201\247\343\201\217\343\201\240\343\201\225\343\201\204\343\200\202\',\n        reading: \'\343\201\223\343\201\223\343\201\247 \343\201\227\343\202\203\343\201\227\343\202\223 \343\202\222 \343\201\250\343\202\211\343\201\252\343\201\204\343\201\247 \343\201\217\343\201\240\343\201\225\343\201\204\343\200\202\',\n        romaji: \'Koko de shashin o toranaide kudasai.\',\n        meaningPt: \'Por favor, n\303\243o tire fotos aqui.\'\n      },\n      {\n        jp: \'\345\277\230\343\202\214\343\201\252\343\201\204\343\201\247\343\201\217\343\201\240\343\201\225\343\201\204\343\200\202\',\n        reading: \'\343\202\217\343\201\231\343\202\214\343\201\252\343\201\204\343\201\247 \343\201\217\343\201\240\343\201\225\343\201\204\343\200\202\',\n        romaji: \'Wasurenaide kudasai.\',\n        meaningPt: \'Por favor, n\303\243o se esque\303\247a.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n5_8\',\n    pattern: \'Raiz MASU + \343\201\237\343\201\204\343\201\247\343\201\231 (~tai desu)\',\n    titlePt: \'Expressar Desejo Pr\303\263prio: \"Quero fazer...\"\',\n    jlpt: \'N5\',\n    category: \'Desejos & Vontades\',\n    formationFormula: \'[Raiz do Verbo (sem \"masu\")] + \343\201\237\343\201\204\343\201\247\343\201\231\',\n    explanationPt: \'Expressa o desejo do pr\303\263prio falante (primeira pessoa). O objeto pode ser marcado tanto por \343\202\222 quanto por \343\201\214.\',\n    keyRulePt: \'Conjuga\303\247\303\243o do \343\201\237\343\201\204 segue a tabela de Adjetivos-I:\\n\342\200\242 Negativo: \350\241\214\343\201\215\343\201\237\343\201\217\343\201\252\343\201\204 (n\303\243o quero ir)\\n\342\200\242 Passado: \350\241\214\343\201\215\343\201\237\343\201\213\343\201\243\343\201\237 (quis ir)\\n\342\200\242 Passado Negativo: \350\241\214\343\201\215\343\201\237\343\201\217\343\201\252\343\201\213\343\201\243\343\201\237 (n\303\243o quis ir)\',\n    examples: [\n      {\n        jp: \'\346\227\245\346\234\254\343\201\270\350\241\214\343\201\215\343\201\237\343\201\204\343\201\247\343\201\231\343\200\202\',\n        reading: \'\343\201\253\343\201\273\343\202\223 \343\201\270 \343\201\204\343\201\215\343\201\237\343\201\204 \343\201\247\343\201\231\343\200\202\',\n        romaji: \'Nihon e ikitai desu.\',\n        meaningPt: \'Eu quero ir para o Jap\303\243o.\'\n      },\n      {\n        jp: \'\345\206\267\343\201\237\343\201\204\346\260\264\343\202\222\351\243\262\343\201\277\343\201\237\343\201\204\343\201\247\343\201\231\343\200\202\',\n        reading: \'\343\201\244\343\202\201\343\201\237\343\201\204 \343\201\277\343\201\232 \343\202\222 \343\201\256\343\201\277\343\201\237\343\201\204 \343\201\247\343\201\231\343\200\202\',\n        romaji: \'Tsumetai mizu o nomitai desu.\',\n        meaningPt: \'Quero beber \303\241gua gelada.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n5_9\',\n    pattern: \'Verbo (Forma Dicion\303\241rio) + \343\201\223\343\201\250\343\201\214\343\201\247\343\201\215\343\201\276\343\201\231 (~koto ga dekimasu)\',\n    titlePt: \'Capacidade & Potencial: \"Consigo / Posso fazer...\"\',\n    jlpt: \'N5\',\n    category: \'Habilidade & Capacidade\',\n    formationFormula: \'[Verbo na Forma Dicion\303\241rio] + \343\201\223\343\201\250\343\201\214\343\201\247\343\201\215\343\201\276\343\201\231 / \343\201\247\343\201\215\343\201\276\343\201\233\343\202\223\',\n    explanationPt: \'Nominaliza o verbo com \343\201\223\343\201\250 (koto) e adiciona \343\201\214\343\201\247\343\201\215\343\201\276\343\201\231 para expressar capacidade f\303\255sica, habilidade aprendida ou permiss\303\243o ambiental.\',\n    keyRulePt: \'Na negativa vira \343\201\223\343\201\250\343\201\214\343\201\247\343\201\215\343\201\276\343\201\233\343\202\223 (\"n\303\243o consigo / n\303\243o posso\").\',\n    examples: [\n      {\n        jp: \'\346\227\245\346\234\254\350\252\236\343\202\222\350\251\261\343\201\231\343\201\223\343\201\250\343\201\214\343\201\247\343\201\215\343\201\276\343\201\231\343\200\202\',\n        reading: \'\343\201\253\343\201\273\343\202\223\343\201\224 \343\202\222 \343\201\257\343\201\252\343\201\231 \343\201\223\343\201\250\343\201\214 \343\201\247\343\201\215\343\201\276\343\201\231\343\200\202\',\n        romaji: \'Nihongo o hanasu koto ga dekimasu.\',\n        meaningPt: \'Consigo falar japon\303\252s.\'\n      },\n      {\n        jp: \'\346\274\242\345\255\227\343\202\222\347\231\276\345\200\213\346\233\270\343\201\217\343\201\223\343\201\250\343\201\214\343\201\247\343\201\215\343\201\276\343\201\231\343\200\202\',\n        reading: \'\343\201\213\343\202\223\343\201\230 \343\202\222 \343\201\262\343\202\203\343\201\243\343\201\223 \343\201\213\343\201\217 \343\201\223\343\201\250\343\201\214 \343\201\247\343\201\215\343\201\276\343\201\231\343\200\202\',\n        romaji: \'Kanji o hyakko kaku koto ga dekimasu.\',\n        meaningPt: \'Consigo escrever 100 kanjis.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n5_10\',\n    pattern: \'Verbo (Forma-TA) + \343\201\223\343\201\250\343\201\214\343\201\202\343\202\212\343\201\276\343\201\231 (~ta koto ga arimasu)\',\n    titlePt: \'Experi\303\252ncia de Vida: \"J\303\241 fiz / J\303\241 estive em...\"\',\n    jlpt: \'N5\',\n    category: \'Experi\303\252ncias\',\n    formationFormula: \'[Verbo na forma-TA (passado informal)] + \343\201\223\343\201\250\343\201\214\343\201\202\343\202\212\343\201\276\343\201\231 / \343\201\202\343\202\212\343\201\276\343\201\233\343\202\223\',\n    explanationPt: \'Usado para relatar viv\303\252ncias que ocorreram ao menos uma vez ao longo da vida.\',\n    keyRulePt: \'\342\200\242 Afirmativo: \343\200\234\343\201\237\343\201\223\343\201\250\343\201\214\343\201\202\343\202\212\343\201\276\343\201\231 (J\303\241 fiz)\\n\342\200\242 Negativo: \343\200\234\343\201\237\343\201\223\343\201\250\343\201\214\343\201\202\343\202\212\343\201\276\343\201\233\343\202\223 (Nunca fiz)\',\n    examples: [\n      {\n        jp: \'\345\257\214\345\243\253\345\261\261\343\201\253\347\231\273\343\201\243\343\201\237\343\201\223\343\201\250\343\201\214\343\201\202\343\202\212\343\201\276\343\201\231\343\200\202\',\n        reading: \'\343\201\265\343\201\230\343\201\225\343\202\223 \343\201\253 \343\201\256\343\201\274\343\201\243\343\201\237 \343\201\223\343\201\250\343\201\214 \343\201\202\343\202\212\343\201\276\343\201\231\343\200\202\',\n        romaji: \'Fujisan ni nobotta koto ga arimasu.\',\n        meaningPt: \'J\303\241 subi o Monte Fuji.\'\n      },\n      {\n        jp: \'\347\264\215\350\261\206\343\202\222\351\243\237\343\201\271\343\201\237\343\201\223\343\201\250\343\201\214\343\201\202\343\202\212\343\201\276\343\201\233\343\202\223\343\200\202\',\n        reading: \'\343\201\252\343\201\243\343\201\250\343\201\206 \343\202\222 \343\201\237\343\201\271\343\201\237 \343\201\223\343\201\250\343\201\214 \343\201\202\343\202\212\343\201\276\343\201\233\343\202\223\343\200\202\',\n        romaji: \'Nattou o tabeta koto ga arimasen.\',\n        meaningPt: \'Nunca comi natto.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n5_11\',\n    pattern: \'Verbo A (Forma-TA) + \343\202\212, Verbo B + \343\202\212 \343\201\227\343\201\276\343\201\231 (~tari ~tari shimasu)\',\n    titlePt: \'A\303\247\303\265es Exemplificativas: \"Fa\303\247o coisas como A e B...\"\',\n    jlpt: \'N5\',\n    category: \'Listagem de A\303\247\303\265es\',\n    formationFormula: \'[Verbo A na forma-TA] + \343\202\212, [Verbo B na forma-TA] + \343\202\212 + \343\201\227\343\201\276\343\201\231 / \343\201\227\343\201\276\343\201\227\343\201\237\',\n    explanationPt: \'Lista algumas a\303\247\303\265es n\303\243o exaustivas realizadas em um determinado per\303\255odo sem fixar uma ordem cronol\303\263gica obrigat\303\263ria.\',\n    keyRulePt: \'O tempo verbal final da frase \303\251 determinado exclusivamente pelo verbo \343\201\227\343\201\276\343\201\231 / \343\201\227\343\201\276\343\201\227\343\201\237 no final.\',\n    examples: [\n      {\n        jp: \'\351\200\261\346\234\253\343\201\257\346\230\240\347\224\273\343\202\222\350\246\213\343\201\237\343\202\212\343\200\201\346\234\254\343\202\222\350\252\255\343\202\223\343\201\240\343\202\212\343\201\227\343\201\276\343\201\231\343\200\202\',\n        reading: \'\343\201\227\343\202\205\343\201\206\343\201\276\343\201\244 \343\201\257 \343\201\210\343\201\204\343\201\214 \343\202\222 \343\201\277\343\201\237\343\202\212\343\200\201\343\201\273\343\202\223 \343\202\222 \343\202\210\343\202\223\343\201\240\343\202\212 \343\201\227\343\201\276\343\201\231\343\200\202\',\n        romaji: \'Shuumatsu wa eiga o mitari, hon o yondari shimasu.\',\n        meaningPt: \'Nos fins de semana assisto a filmes, leio livros e coisas do tipo.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n5_12\',\n    pattern: \'Conjuga\303\247\303\243o Completa de Adjetivos (\343\201\204 / \343\201\252)\',\n    titlePt: \'Guia de Adjetivos-I e Adjetivos-NA\',\n    jlpt: \'N5\',\n    category: \'Adjetivos & Modificadores\',\n    formationFormula: \'Adj-I: [\343\201\204 \342\206\222 \343\201\217\343\201\252\343\201\204 / \343\201\213\343\201\243\343\201\237 / \343\201\217\343\201\252\343\201\213\343\201\243\343\201\237] | Adj-NA: [\343\201\247\343\201\231 / \343\201\247\343\201\257\343\201\202\343\202\212\343\201\276\343\201\233\343\202\223 / \343\201\247\343\201\227\343\201\237 / \343\201\247\343\201\257\343\201\202\343\202\212\343\201\276\343\201\233\343\202\223\343\201\247\343\201\227\343\201\237]\',\n    explanationPt: \'Em japon\303\252s, os adjetivos funcionam como verbos descritivos e conjugam no tempo presente, passado e nega\303\247\303\265es.\',\n    keyRulePt: \'\342\200\242 Adjetivo-I (ex: \351\253\230\343\201\204 takai):\\n  - Presente Neg: \351\253\230\343\201\217\343\201\252\343\201\204 (n\303\243o \303\251 caro)\\n  - Passado Afir: \351\253\230\343\201\213\343\201\243\343\201\237 (era caro)\\n  - Passado Neg: \351\253\230\343\201\217\343\201\252\343\201\213\343\201\243\343\201\237 (n\303\243o era caro)\\n  - Exce\303\247\303\243o: \343\201\204\343\201\204 (bom) \342\206\222 \343\202\210\343\201\217\343\201\252\343\201\204, \343\202\210\343\201\213\343\201\243\343\201\237, \343\202\210\343\201\217\343\201\252\343\201\213\343\201\243\343\201\237.\\n\342\200\242 Adjetivo-NA (ex: \351\235\231\343\201\213 shizuka):\\n  - Modifica substantivo com \343\201\252: \351\235\231\343\201\213\343\201\252\351\203\250\345\261\213 (quarto silencioso)\\n  - Presente Neg: \351\235\231\343\201\213\343\201\230\343\202\203\343\201\252\343\201\204 (n\303\243o \303\251 silencioso)\\n  - Passado: \351\235\231\343\201\213\343\201\247\343\201\227\343\201\237 (era silencioso)\',\n    examples: [\n      {\n        jp: \'\346\230\250\346\227\245\343\201\256\343\203\206\343\202\271\343\203\210\343\201\257\351\233\243\343\201\227\343\201\213\343\201\243\343\201\237\343\201\247\343\201\231\343\200\202\',\n        reading: \'\343\201\215\343\201\256\343\201\206 \343\201\256 \343\203\206\343\202\271\343\203\210 \343\201\257 \343\202\200\343\201\232\343\201\213\343\201\227\343\201\213\343\201\243\343\201\237 \343\201\247\343\201\231\343\200\202\',\n        romaji: \'Kinou no tesuto wa muzukashikatta desu.\',\n        meaningPt: \'A prova de ontem estava dif\303\255cil.\'\n      },\n      {\n        jp: \'\344\272\254\351\203\275\343\201\257\343\201\250\343\201\246\343\202\202\351\235\231\343\201\213\343\201\247\347\266\272\351\272\227\343\201\252\347\224\272\343\201\247\343\201\231\343\200\202\',\n        reading: \'\343\201\215\343\202\207\343\201\206\343\201\250 \343\201\257 \343\201\250\343\201\246\343\202\202 \343\201\227\343\201\232\343\201\213\343\201\247 \343\201\215\343\202\214\343\201\204\343\201\252 \343\201\276\343\201\241 \343\201\247\343\201\231\343\200\202\',\n        romaji: \'Kyouto wa totemo shizuka de kirei na machi desu.\',\n        meaningPt: \'Kyoto \303\251 uma cidade muito tranquila e bonita.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n5_13\',\n    pattern: \'A \343\201\256 \343\201\273\343\201\206\343\201\214 B \343\202\210\343\202\212 [Adjetivo] \343\201\247\343\201\231\',\n    titlePt: \'Estruturas de Compara\303\247\303\243o: \"A \303\251 mais ... que B\"\',\n    jlpt: \'N5\',\n    category: \'Compara\303\247\303\265es\',\n    formationFormula: \'[Substantivo A] + \343\201\256 \343\201\273\343\201\206\343\201\214 + [Substantivo B] + \343\202\210\343\202\212 + [Adjetivo] + \343\201\247\343\201\231\',\n    explanationPt: \'Compara dois elementos indicando superioridade de uma qualidade no elemento A em rela\303\247\303\243o a B.\',\n    keyRulePt: \'\342\200\242 Pergunta entre dois: A \343\201\250 B \343\201\250 \343\201\251\343\201\241\343\202\211\343\201\214 [Adjetivo] \343\201\247\343\201\231\343\201\213 (Entre A e B, qual \303\251 mais...?)\\n\342\200\242 Superlativo no grupo: [Grupo] \343\201\256\344\270\255\343\201\247 [Elemento] \343\201\214\344\270\200\347\225\252 [Adj] \343\201\247\343\201\231 (Dentro de tal grupo, X \303\251 o mais...).\',\n    examples: [\n      {\n        jp: \'\346\226\260\345\271\271\347\267\232\343\201\256\343\201\273\343\201\206\343\201\214\351\243\233\350\241\214\346\251\237\343\202\210\343\202\212\345\256\211\343\201\204\343\201\247\343\201\231\343\200\202\',\n        reading: \'\343\201\227\343\202\223\343\201\213\343\202\223\343\201\233\343\202\223 \343\201\256 \343\201\273\343\201\206 \343\201\214 \343\201\262\343\201\223\343\201\206\343\201\215 \343\202\210\343\202\212 \343\202\204\343\201\231\343\201\204 \343\201\247\343\201\231\343\200\202\',\n        romaji: \'Shinkansen no hou ga hikouki yori yasui desu.\',\n        meaningPt: \'O trem-bala \303\251 mais barato que o avi\303\243o.\'\n      },\n      {\n        jp: \'\346\227\245\346\234\254\346\226\231\347\220\206\343\201\256\344\270\255\343\201\247\345\257\277\345\217\270\343\201\214\344\270\200\347\225\252\345\245\275\343\201\215\343\201\247\343\201\231\343\200\202\',\n        reading: \'\343\201\253\343\201\273\343\202\223\343\202\212\343\202\207\343\201\206\343\202\212 \343\201\256 \343\201\252\343\201\213 \343\201\247 \343\201\231\343\201\227 \343\201\214 \343\201\204\343\201\241\343\201\260\343\202\223 \343\201\231\343\201\215 \343\201\247\343\201\231\343\200\202\',\n        romaji: \'Nihon ryouri no naka de sushi ga ichiban suki desu.\',\n        meaningPt: \'Dentre a culin\303\241ria japonesa, sushi \303\251 o meu favorito.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n5_14\',\n    pattern: \'Substantivo + \343\201\214 \345\245\275\343\201\215 / \345\253\214\343\201\204 / \344\270\212\346\211\213 / \344\270\213\346\211\213 \343\201\247\343\201\231\',\n    titlePt: \'Gostos e Habilidades: \"Gostar, Odiar, Ser Bom ou Ruim\"\',\n    jlpt: \'N5\',\n    category: \'Gostos & Habilidades\',\n    formationFormula: \'[Substantivo] + \343\201\214 + \345\245\275\343\201\215 (gostar) / \345\253\214\343\201\204 (n\303\243o gostar) / \344\270\212\346\211\213 (ser habilidoso) / \344\270\213\346\211\213 (ser ruim) + \343\201\247\343\201\231\',\n    explanationPt: \'Em japon\303\252s, \345\245\275\343\201\215 (suki), \345\253\214\343\201\204 (kirai), \344\270\212\346\211\213 (jouzu) e \344\270\213\346\211\213 (heta) s\303\243o adjetivos-NA, e o seu objeto \303\251 marcado pela part\303\255cula \343\201\214 e n\303\243o \343\202\222.\',\n    keyRulePt: \'\342\200\242 Nunca use \344\270\212\346\211\213 (jouzu) para se autoelogiar em japon\303\252s; use \344\270\212\346\211\213 para elogiar outros, e ao falar de si mesmo use \345\276\227\346\204\217 (tokui = tenho facilidade) ou \343\201\276\343\201\240\343\201\276\343\201\240\343\201\247\343\201\231 (ainda falta muito).\',\n    examples: [\n      {\n        jp: \'\347\247\201\343\201\257\343\202\242\343\203\213\343\203\241\343\201\214\345\245\275\343\201\215\343\201\247\343\201\231\343\200\202\',\n        reading: \'\343\202\217\343\201\237\343\201\227 \343\201\257 \343\202\242\343\203\213\343\203\241 \343\201\214 \343\201\231\343\201\215 \343\201\247\343\201\231\343\200\202\',\n        romaji: \'Watashi wa anime ga suki desu.\',\n        meaningPt: \'Eu gosto de animes.\'\n      },\n      {\n        jp: \'\347\224\260\344\270\255\343\201\225\343\202\223\343\201\257\346\227\245\346\234\254\350\252\236\343\201\214\344\270\212\346\211\213\343\201\247\343\201\231\343\200\202\',\n        reading: \'\343\201\237\343\201\252\343\201\213\343\201\225\343\202\223 \343\201\257 \343\201\253\343\201\273\343\202\223\343\201\224 \343\201\214 \343\201\230\343\202\207\343\201\206\343\201\232 \343\201\247\343\201\231\343\200\202\',\n        romaji: \'Tanaka-san wa nihongo ga jouzu desu.\',\n        meaningPt: \'O Sr. Tanaka \303\251 muito bom em japon\303\252s.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n5_15\',\n    pattern: \'Raiz MASU + \343\201\253 \350\241\214\343\201\215\343\201\276\343\201\231 / \346\235\245\343\201\276\343\201\231 (~ni ikimasu / kimasu)\',\n    titlePt: \'Prop\303\263sito do Deslocamento: \"Ir ou Vir para fazer...\"\',\n    jlpt: \'N5\',\n    category: \'Objetivo & Movimento\',\n    formationFormula: \'[Local] + \343\201\270 / \343\201\253 + [Raiz do Verbo (sem \"masu\") ou Substantivo de a\303\247\303\243o] + \343\201\253 + \350\241\214\343\201\215\343\201\276\343\201\231 / \346\235\245\343\201\276\343\201\231\',\n    explanationPt: \'Indica a finalidade com que a pessoa se desloca at\303\251 um determinado lugar.\',\n    keyRulePt: \'A part\303\255cula \343\201\253 antes do verbo de movimento marca o objetivo da ida/vinda.\',\n    examples: [\n      {\n        jp: \'\343\203\207\343\203\221\343\203\274\343\203\210\343\201\270\350\262\267\343\201\204\347\211\251\343\201\253\350\241\214\343\201\215\343\201\276\343\201\231\343\200\202\',\n        reading: \'\343\203\207\343\203\221\343\203\274\343\203\210 \343\201\270 \343\201\213\343\201\204\343\202\202\343\201\256 \343\201\253 \343\201\204\343\201\215\343\201\276\343\201\231\343\200\202\',\n        romaji: \'Depaato e kaimono ni ikimasu.\',\n        meaningPt: \'Vou \303\240 loja de departamentos para fazer compras.\'\n      },\n      {\n        jp: \'\345\233\263\346\233\270\351\244\250\343\201\270\346\234\254\343\202\222\345\200\237\343\202\212\343\201\253\350\241\214\343\201\215\343\201\276\343\201\227\343\201\237\343\200\202\',\n        reading: \'\343\201\250\343\201\227\343\202\207\343\201\213\343\202\223 \343\201\270 \343\201\273\343\202\223 \343\202\222 \343\201\213\343\202\212\343\201\253 \343\201\204\343\201\215\343\201\276\343\201\227\343\201\237\343\200\202\',\n        romaji: \'Toshokan e hon o kari ni ikimashita.\',\n        meaningPt: \'Fui \303\240 biblioteca para pegar livros emprestados.\'\n      }\n    ]\n  }\n];\n"
    }
