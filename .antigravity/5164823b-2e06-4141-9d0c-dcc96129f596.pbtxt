        lines {
          text: "    pattern: \'A\303\247\303\265es de Dar e Receber Favor (\343\200\234\343\201\246\343\201\202\343\201\222\343\202\213, \343\200\234\343\201\246\343\201\217\343\202\214\343\202\213, \343\200\234\343\201\246\343\202\202\343\202\211\343\201\206)\',"
