    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { GrammarItem } from \'../types\';\n\nexport const GRAMMAR_DATA: GrammarItem[] = [\n  // ===================== N5 GRAMMAR =====================\n  {\n    id: \'g_n5_1\',\n    pattern: \'A \343\201\257 B \343\201\247\343\201\231 (wa ... desu)\',\n    titlePt: \'Estrutura B\303\241sica de Frase: \"A \303\251 B\"\',\n    jlpt: \'N5\',\n    category: \'Estruturas B\303\241sicas\',\n    formationFormula: \'[Substantivo A] + \343\201\257 (l\303\252-se \"wa\") + [Substantivo / Adjetivo B] + \343\201\247\343\201\231\',\n    explanationPt: \'A part\303\255cula \343\201\257 (escrita como \"ha\", mas pronunciada \"wa\") indica o T\303\263pico da frase (aquilo sobre o qual estamos falando). O termo \343\201\247\343\201\231 (desu) \303\251 a c\303\263pula formal que equivale a \"\303\251 / sou / somos\".\',\n    keyRulePt: \'Na negativa vira \"A \343\201\257 B \343\201\247\343\201\257\343\201\202\343\202\212\343\201\276\343\201\233\343\202\223\" (dewa arimasen) ou \"\343\201\230\343\202\203\343\201\202\343\202\212\343\201\276\343\201\233\343\202\223\" (ja arimasen). Para fazer perguntas, basta adicionar \343\201\213 (ka) no final.\',\n    examples: [\n      {\n        jp: \'\347\247\201\343\201\257\345\255\246\347\224\237\343\201\247\343\201\231\343\200\202\',\n        reading: \'\343\202\217\343\201\237\343\201\227 \343\201\257 \343\201\214\343\201\217\343\201\233\343\201\204 \343\201\247\343\201\231\343\200\202\',\n        romaji: \'Watashi wa gakusei desu.\',\n        meaningPt: \'Eu sou estudante.\'\n      },\n      {\n        jp: \'\347\224\260\344\270\255\343\201\225\343\202\223\343\201\257\346\227\245\346\234\254\344\272\272\343\201\247\343\201\231\343\200\202\',\n        reading: \'\343\201\237\343\201\252\343\201\213\343\201\225\343\202\223 \343\201\257 \343\201\253\343\201\273\343\202\223\343\201\230\343\202\223 \343\201\247\343\201\231\343\200\202\',\n        romaji: \'Tanaka-san wa nihonjin desu.\',\n        meaningPt: \'O Sr. Tanaka \303\251 japon\303\252s.\'\n      },\n      {\n        jp: \'\343\201\223\343\202\214\343\201\257\343\203\232\343\203\263\343\201\247\343\201\257\343\201\202\343\202\212\343\201\276\343\201\233\343\202\223\343\200\202\',\n        reading: \'\343\201\223\343\202\214 \343\201\257 \343\203\232\343\203\263 \343\201\247\343\201\257\343\201\202\343\202\212\343\201\276\343\201\233\343\202\223\343\200\202\',\n        romaji: \'Kore wa pen dewa arimasen.\',\n        meaningPt: \'Isto n\303\243o \303\251 uma caneta.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n5_2\',\n    pattern: \'Part\303\255culas Fundamentais (\343\202\222, \343\201\253, \343\201\247, \343\201\270, \343\201\250, \343\202\202)\',\n    titlePt: \'Guia Mestre de Part\303\255culas em Japon\303\252s (\345\212\251\350\251\236)\',\n    jlpt: \'N5\',\n    category: \'Part\303\255culas\',\n    formationFormula: \'[Substantivo] + [Part\303\255cula] + [Verbo]\',\n    explanationPt: \'As part\303\255culas s\303\243o sufixos que determinam a fun\303\247\303\243o gramatical de cada palavra na frase:\',\n    keyRulePt: \'\342\200\242 \343\202\222 (o): Objeto Direto (aquilo que sofre a a\303\247\303\243o).\\n\342\200\242 \343\201\253 (ni): Destino exato, tempo espec\303\255fico, ou localiza\303\247\303\243o de exist\303\252ncia.\\n\342\200\242 \343\201\247 (de): Local onde a a\303\247\303\243o ocorre, ou meio/instrumento utilizado.\\n\342\200\242 \343\201\270 (e): Dire\303\247\303\243o do movimento (\"em dire\303\247\303\243o a\").\\n\342\200\242 \343\201\250 (to): \"E\" (conjun\303\247\303\243o aditiva entre substantivos) ou \"com\" (companhia).\\n\342\200\242 \343\202\202 (mo): \"Tamb\303\251m / Nem\". Substitui \343\201\257, \343\201\214 ou \343\202\222.\',\n    examples: [\n      {\n        jp: \'\346\234\254\343\202\222\350\252\255\343\201\277\343\201\276\343\201\231\343\200\202\',\n        reading: \'\343\201\273\343\202\223 \343\202\222 \343\202\210\343\201\277\343\201\276\343\201\231\343\200\202\',\n        romaji: \'Hon o yomimasu.\',\n        meaningPt: \'Leio um livro. (Objeto direto \343\202\222)\'\n      },\n      {\n        jp: \'\344\270\203\346\231\202\343\201\253\350\265\267\343\201\215\343\201\276\343\201\231\343\200\202\',\n        reading: \'\343\201\227\343\201\241\343\201\230 \343\201\253 \343\201\212\343\201\215\343\201\276\343\201\231\343\200\202\',\n        romaji: \'Shichiji ni okimasu.\',\n        meaningPt: \'Acordo \303\240s sete horas. (Tempo espec\303\255fico \343\201\253)\'\n      },\n      {\n        jp: \'\343\203\254\343\202\271\343\203\210\343\203\251\343\203\263\343\201\247\345\257\277\345\217\270\343\202\222\351\243\237\343\201\271\343\201\276\343\201\231\343\200\202\',\n        reading: \'\343\203\254\343\202\271\343\203\210\343\203\251\343\203\263 \343\201\247 \343\201\231\343\201\227 \343\202\222 \343\201\237\343\201\271\343\201\276\343\201\231\343\200\202\',\n        romaji: \'Resutoran de sushi o tabemasu.\',\n        meaningPt: \'Como sushi no restaurante. (Local de a\303\247\303\243o \343\201\247)\'\n      },\n      {\n        jp: \'\347\256\270\343\201\247\343\203\251\343\203\274\343\203\241\343\203\263\343\202\222\351\243\237\343\201\271\343\201\276\343\201\231\343\200\202\',\n        reading: \'\343\201\257\343\201\227 \343\201\247 \343\203\251\343\203\274\343\203\241\343\203\263 \343\202\222 \343\201\237\343\201\271\343\201\276\343\201\231\343\200\202\',\n        romaji: \'Hashi de raamen o tabemasu.\',\n        meaningPt: \'Como l\303\241men com hashi. (Instrumento \343\201\247)\'\n      }\n    ]\n  },\n  {\n    id: \'g_n5_3\',\n    pattern: \'Verbo em Forma-TE + \343\201\217\343\201\240\343\201\225\343\201\204 (~te kudasai)\',\n    titlePt: \'Pedidos Polidos: \"Por favor, fa\303\247a...\"\',\n    jlpt: \'N5\',\n    category: \'Pedidos e Ordens\',\n    formationFormula: \'[Verbo na forma-te] + \343\201\217\343\201\240\343\201\225\343\201\204 (kudasai)\',\n    explanationPt: \'Utilizado para fazer pedidos cordiais e instru\303\247\303\265es no dia a dia. Para formar, transforma-se o verbo na Forma-TE e adiciona-se \343\201\217\343\201\240\343\201\225\343\201\204.\',\n    keyRulePt: \'Regras da Forma-TE:\\n\342\200\242 Ichidan: troca \343\202\213 por \343\201\246 (\351\243\237\343\201\271\343\202\213 \342\206\222 \351\243\237\343\201\271\343\201\246).\\n\342\200\242 Godan (\343\201\206, \343\201\244, \343\202\213): \343\201\243\343\201\246 (\345\276\205\343\201\244 \342\206\222 \345\276\205\343\201\243\343\201\246).\\n\342\200\242 Godan (\343\202\200, \343\201\266, \343\201\254): \343\202\223\343\201\247 (\351\243\262\343\202\200 \342\206\222 \351\243\262\343\202\223\343\201\247).\\n\342\200\242 Godan (\343\201\217): \343\201\204\343\201\246 (\346\233\270\343\201\217 \342\206\222 \346\233\270\343\201\204\343\201\246; exce\303\247\303\243o: \350\241\214\343\201\217 \342\206\222 \350\241\214\343\201\243\343\201\246).\\n\342\200\242 Godan (\343\201\220): \343\201\204\343\201\247 (\346\263\263\343\201\220 \342\206\222 \346\263\263\343\201\204\343\201\247).\\n\342\200\242 Godan (\343\201\231): \343\201\227\343\201\246 (\350\251\261\343\201\231 \342\206\222 \350\251\261\343\201\227\343\201\246).\\n\342\200\242 Irregulares: \343\201\231\343\202\213 \342\206\222 \343\201\227\343\201\246 / \346\235\245\343\202\213 \342\206\222 \343\201\215\343\201\246.\',\n    examples: [\n      {\n        jp: \'\343\201\241\343\202\207\343\201\243\343\201\250\345\276\205\343\201\243\343\201\246\343\201\217\343\201\240\343\201\225\343\201\204\343\200\202\',\n        reading: \'\343\201\241\343\202\207\343\201\243\343\201\250 \343\201\276\343\201\243\343\201\246\343\201\217\343\201\240\343\201\225\343\201\204\343\200\202\',\n        romaji: \'Chotto matte kudasai.\',\n        meaningPt: \'Por favor, espere um pouco.\'\n      },\n      {\n        jp: \'\346\227\245\346\234\254\350\252\236\343\201\247\346\233\270\343\201\204\343\201\246\343\201\217\343\201\240\343\201\225\343\201\204\343\200\202\',\n        reading: \'\343\201\253\343\201\273\343\202\223\343\201\224 \343\201\247 \343\201\213\343\201\204\343\201\246 \343\201\217\343\201\240\343\201\225\343\201\204\343\200\202\',\n        romaji: \'Nihongo de kaite kudasai.\',\n        meaningPt: \'Por favor, escreva em japon\303\252s.\'\n      },\n      {\n        jp: \'\343\201\223\343\201\223\343\201\253\345\272\247\343\201\243\343\201\246\343\201\217\343\201\240\343\201\225\343\201\204\343\200\202\',\n        reading: \'\343\201\223\343\201\223\343\201\253 \343\201\231\343\202\217\343\201\243\343\201\246 \343\201\217\343\201\240\343\201\225\343\201\204\343\200\202\',\n        romaji: \'Koko ni suwatte kudasai.\',\n        meaningPt: \'Por favor, sente-se aqui.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n5_4\',\n    pattern: \'Verbo (Raiz Masu) + \343\201\237\343\201\204\343\201\247\343\201\231 (~tai desu)\',\n    titlePt: \'Expressar Desejo Pr\303\263prio: \"Quero fazer...\"\',\n    jlpt: \'N5\',\n    category: \'Desejos e Inten\303\247\303\265es\',\n    formationFormula: \'[Verbo na Raiz MASU (sem o \"masu\")] + \343\201\237\343\201\204\343\201\247\343\201\231\',\n    explanationPt: \'Expressa a vontade ou desejo da primeira pessoa (\"eu quero fazer tal coisa\"). O objeto pode ser marcado tanto com a part\303\255cula \343\202\222 (o) quanto com \343\201\214 (ga).\',\n    keyRulePt: \'Conjuga\303\247\303\265es do \343\201\237\343\201\204 (comporta-se como um Adjetivo-I):\\n\342\200\242 Afirmativo: \351\243\237\343\201\271\343\201\237\343\201\204 (quero comer)\\n\342\200\242 Negativo: \351\243\237\343\201\271\343\201\237\343\201\217\343\201\252\343\201\204 (n\303\243o quero comer)\\n\342\200\242 Passado: \351\243\237\343\201\271\343\201\237\343\201\213\343\201\243\343\201\237 (quis comer)\\n\342\200\242 Passado Negativo: \351\243\237\343\201\271\343\201\237\343\201\217\343\201\252\343\201\213\343\201\243\343\201\237 (n\303\243o quis comer)\',\n    examples: [\n      {\n        jp: \'\346\227\245\346\234\254\343\201\270\350\241\214\343\201\215\343\201\237\343\201\204\343\201\247\343\201\231\343\200\202\',\n        reading: \'\343\201\253\343\201\273\343\202\223 \343\201\270 \343\201\204\343\201\215\343\201\237\343\201\204 \343\201\247\343\201\231\343\200\202\',\n        romaji: \'Nihon e ikitai desu.\',\n        meaningPt: \'Eu quero ir para o Jap\303\243o.\'\n      },\n      {\n        jp: \'\346\260\264\343\202\222\351\243\262\343\201\277\343\201\237\343\201\204\343\201\247\343\201\231\343\200\202\',\n        reading: \'\343\201\277\343\201\232 \343\202\222 \343\201\256\343\201\277\343\201\237\343\201\204 \343\201\247\343\201\231\343\200\202\',\n        romaji: \'Mizu o nomitai desu.\',\n        meaningPt: \'Quero beber \303\241gua.\'\n      }\n    ]\n  },\n\n  // ===================== N4 GRAMMAR =====================\n  {\n    id: \'g_n4_1\',\n    pattern: \'\343\200\234\343\201\252\343\201\221\343\202\214\343\201\260\343\201\252\343\202\211\343\201\252\343\201\204 (~nakereba naranai)\',\n    titlePt: \'Obriga\303\247\303\243o / Necessidade: \"Ter que fazer / \303\211 obrigat\303\263rio\"\',\n    jlpt: \'N4\',\n    category: \'Obriga\303\247\303\243o\',\n    formationFormula: \'[Verbo na forma-Nai] sem o \"\343\201\204\" + \343\201\221\343\202\214\343\201\260\343\201\252\343\202\211\343\201\252\343\201\204 / \343\201\221\343\202\214\343\201\260\343\201\204\343\201\221\343\201\276\343\201\233\343\202\223\',\n    explanationPt: \'Indica que algo deve impreterivelmente ser feito (dever ou obriga\303\247\303\243o moral/legal/pessoal). Literalmente significa \"se n\303\243o fizer, n\303\243o serve/n\303\243o vai\".\',\n    keyRulePt: \'Na fala cotidiana casual, costuma ser encurtado para: \343\200\234\343\201\252\343\201\215\343\202\203 (nakya) ou \343\200\234\343\201\252\343\201\217\343\201\241\343\202\203 (nakucha).\',\n    examples: [\n      {\n        jp: \'\346\257\216\346\227\245\343\200\201\346\274\242\345\255\227\343\202\222\345\276\251\347\277\222\343\201\227\343\201\252\343\201\221\343\202\214\343\201\260\343\201\252\343\202\212\343\201\276\343\201\233\343\202\223\343\200\202\',\n        reading: \'\343\201\276\343\201\204\343\201\253\343\201\241\343\200\201\343\201\213\343\202\223\343\201\230 \343\202\222 \343\201\265\343\201\217\343\201\227\343\202\205\343\201\206 \343\201\227\343\201\252\343\201\221\343\202\214\343\201\260 \343\201\252\343\202\212\343\201\276\343\201\233\343\202\223\343\200\202\',\n        romaji: \'Mainichi, kanji o fukushuu shinakereba narimasen.\',\n        meaningPt: \'Tenho que revisar kanji todos os dias.\'\n      },\n      {\n        jp: \'\350\226\254\343\202\222\351\243\262\343\201\276\343\201\252\343\201\221\343\202\214\343\201\260\343\201\252\343\202\211\343\201\252\343\201\204\343\200\202\',\n        reading: \'\343\201\217\343\201\231\343\202\212 \343\202\222 \343\201\256\343\201\276\343\201\252\343\201\221\343\202\214\343\201\260 \343\201\252\343\202\211\343\201\252\343\201\204\343\200\202\',\n        romaji: \'Kusuri o nomanakereba naranai.\',\n        meaningPt: \'Tenho que tomar o rem\303\251dio.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n4_2\',\n    pattern: \'\343\200\234\343\201\237\343\201\223\343\201\250\343\201\214\343\201\202\343\202\213 (~ta koto ga aru)\',\n    titlePt: \'Experi\303\252ncia Passada: \"J\303\241 fiz / J\303\241 estive em...\"\',\n    jlpt: \'N4\',\n    category: \'Experi\303\252ncias\',\n    formationFormula: \'[Verbo na forma-Ta (passado informal)] + \343\201\223\343\201\250\343\201\214\343\201\202\343\202\213 / \343\201\202\343\202\212\343\201\276\343\201\231\',\n    explanationPt: \'Usado para falar sobre experi\303\252ncias que a pessoa j\303\241 teve na vida pelo menos uma vez.\',\n    keyRulePt: \'Para dizer que \"nunca fez\", use a forma negativa: \343\200\234\343\201\237\343\201\223\343\201\250\343\201\214\343\201\252\343\201\204 / \343\201\202\343\202\212\343\201\276\343\201\233\343\202\223.\',\n    examples: [\n      {\n        jp: \'\345\257\214\345\243\253\345\261\261\343\201\253\347\231\273\343\201\243\343\201\237\343\201\223\343\201\250\343\201\214\343\201\202\343\202\212\343\201\276\343\201\231\343\200\202\',\n        reading: \'\343\201\265\343\201\230\343\201\225\343\202\223 \343\201\253 \343\201\256\343\201\274\343\201\243\343\201\237 \343\201\223\343\201\250\343\201\214 \343\201\202\343\202\212\343\201\276\343\201\231\343\200\202\',\n        romaji: \'Fujisan ni nobotta koto ga arimasu.\',\n        meaningPt: \'Eu j\303\241 subi o Monte Fuji.\'\n      },\n      {\n        jp: \'\347\264\215\350\261\206\343\202\222\351\243\237\343\201\271\343\201\237\343\201\223\343\201\250\343\201\214\343\201\202\343\202\212\343\201\276\343\201\233\343\202\223\343\200\202\',\n        reading: \'\343\201\252\343\201\243\343\201\250\343\201\206 \343\202\222 \343\201\237\343\201\271\343\201\237 \343\201\223\343\201\250\343\201\214 \343\201\202\343\202\212\343\201\276\343\201\233\343\202\223\343\200\202\',\n        romaji: \'Nattou o tabeta koto ga arimasen.\',\n        meaningPt: \'Eu nunca comi natto.\'\n      }\n    ]\n  },\n\n  // ===================== N3 GRAMMAR =====================\n  {\n    id: \'g_n3_1\',\n    pattern: \'\343\200\234\343\202\217\343\201\221\343\201\247\343\201\257\343\201\252\343\201\204 (~wake dewa nai)\',\n    titlePt: \'Nega\303\247\303\243o Parcial: \"N\303\243o \303\251 que... / N\303\243o quer dizer que...\"\',\n    jlpt: \'N3\',\n    category: \'Nuance e Julgamento\',\n    formationFormula: \'[Forma Simples (Verbo / Adj-i / Adj-na+\343\201\252 / Substantivo+\343\201\256)] + \343\202\217\343\201\221\343\201\247\343\201\257\343\201\252\343\201\204\',\n    explanationPt: \'Usado para suavizar uma afirma\303\247\303\243o ou evitar mal-entendidos, indicando que embora algo pare\303\247a de certa forma, n\303\243o \303\251 totalmente verdade.\',\n    keyRulePt: \'Diferen\303\247a sutil: \345\253\214\343\201\204\343\201\247\343\201\257\343\201\252\343\201\204 (n\303\243o odeio) vs. \345\253\214\343\201\204\343\201\252\343\202\217\343\201\221\343\201\247\343\201\257\343\201\252\343\201\204 (n\303\243o \303\251 que eu odeie, mas...)\',\n    examples: [\n      {\n        jp: \'\350\276\233\343\201\204\346\226\231\347\220\206\343\201\214\345\253\214\343\201\204\343\201\252\343\202\217\343\201\221\343\201\247\343\201\257\343\201\252\343\201\204\343\201\214\343\200\201\343\201\202\343\201\276\343\202\212\351\243\237\343\201\271\343\201\252\343\201\204\343\200\202\',\n        reading: \'\343\201\213\343\202\211\343\201\204 \343\202\212\343\202\207\343\201\206\343\202\212\343\201\214 \343\201\215\343\202\211\343\201\204\343\201\252 \343\202\217\343\201\221\343\201\247\343\201\257\343\201\252\343\201\204\343\201\214\343\200\201\343\201\202\343\201\276\343\202\212 \343\201\237\343\201\271\343\201\252\343\201\204\343\200\202\',\n        romaji: \'Karai ryouri ga kirai na wake dewa nai ga, amari tabenai.\',\n        meaningPt: \'N\303\243o \303\251 que eu n\303\243o goste de comida apimentada, mas n\303\243o como com frequ\303\252ncia.\'\n      }\n    ]\n  },\n\n  // ===================== N2 GRAMMAR =====================\n  {\n    id: \'g_n2_1\',\n    pattern: \'\343\200\234\343\201\253\351\201\225\343\201\204\343\201\252\343\201\204 (~ni chigainai)\',\n    titlePt: \'Certeza e Convic\303\247\303\243o: \"Com certeza \303\251 / Sem d\303\272vidas\"\',\n    jlpt: \'N2\',\n    category: \'Certeza / Dedu\303\247\303\243o\',\n    formationFormula: \'[Forma Simples (Verbo / Adj / Substantivo direto)] + \343\201\253\351\201\225\343\201\204\343\201\252\343\201\204\',\n    explanationPt: \'Expressa forte convic\303\247\303\243o do falante baseada em evid\303\252ncias ou l\303\263gica pessoal (\"n\303\243o pode ser de outro jeito\").\',\n    keyRulePt: \'Na linguagem falada casual frequentemente aparece como \343\201\253\351\201\225\343\201\204\343\201\252\343\201\204 (ou \343\201\253\343\201\241\343\201\214\343\201\204\343\201\252\343\201\204).\',\n    examples: [\n      {\n        jp: \'\345\275\274\343\201\257\346\257\216\346\227\245\345\244\234\351\201\205\343\201\217\343\201\276\343\201\247\345\213\211\345\274\267\343\201\227\343\201\246\343\201\204\343\201\237\343\201\213\343\202\211\343\200\201\345\220\210\346\240\274\343\201\231\343\202\213\343\201\253\351\201\225\343\201\204\343\201\252\343\201\204\343\200\202\',\n        reading: \'\343\201\213\343\202\214\343\201\257 \343\201\276\343\201\204\343\201\253\343\201\241 \343\202\210\343\202\213\343\201\212\343\201\235\343\201\217\343\201\276\343\201\247 \343\201\271\343\202\223\343\201\215\343\202\207\343\201\206\343\201\227\343\201\246\343\201\204\343\201\237\343\201\213\343\202\211\343\200\201\343\201\224\343\201\206\343\201\213\343\201\217\343\201\231\343\202\213 \343\201\253 \343\201\241\343\201\214\343\201\204\343\201\252\343\201\204\343\200\202\',\n        romaji: \'Kare wa mainichi yoru osoku made benkyou shite ita kara, goukaku suru ni chigainai.\',\n        meaningPt: \'Como ele estudava at\303\251 tarde da noite todo dia, com certeza passar\303\241 no exame.\'\n      }\n    ]\n  },\n\n  // ===================== N1 GRAMMAR =====================\n  {\n    id: \'g_n1_1\',\n    pattern: \'\343\200\234\343\201\276\343\201\230\343\201\215 (~majiki)\',\n    titlePt: \'Inadmiss\303\255vel / Inaceit\303\241vel para uma posi\303\247\303\243o: \"N\303\243o condiz com...\"\',\n    jlpt: \'N1\',\n    category: \'Linguagem Formal / Cr\303\255tica Moral\',\n    formationFormula: \'[Verbo na Forma Dicion\303\241rio] + \343\201\276\343\201\230\343\201\215 + [Substantivo (geralmente: \346\205\213\345\272\246, \350\241\214\347\202\272, \347\231\272\350\250\200)]\',\n    explanationPt: \'Express\303\243o liter\303\241ria e de alto n\303\255vel do JLPT N1 que condena veementemente um comportamento, afirmando que \303\251 inaceit\303\241vel dada a postura ou profiss\303\243o de quem o praticou.\',\n    keyRulePt: \'Geralmente combinado com: \350\250\261\343\201\231\343\201\276\343\201\230\343\201\215 (imperdo\303\241vel), \343\201\202\343\202\213\343\201\276\343\201\230\343\201\215 (inaceit\303\241vel existir). O verbo \343\201\231\343\202\213 torna-se \"\343\201\231\343\201\276\343\201\230\343\201\215\" ou \"\343\201\231\343\202\213\343\201\276\343\201\230\343\201\215\".\',\n    examples: [\n      {\n        jp: \'\346\225\231\345\270\253\343\201\250\343\201\227\343\201\246\343\201\202\343\202\213\343\201\276\343\201\230\343\201\215\350\241\214\347\202\272\343\201\240\343\200\202\',\n        reading: \'\343\201\215\343\202\207\343\201\206\343\201\227 \343\201\250\343\201\227\343\201\246 \343\201\202\343\202\213\343\201\276\343\201\230\343\201\215 \343\201\223\343\201\206\343\201\204\343\201\240\343\200\202\',\n        romaji: \'Kyoushi to shite arumajiki koui da.\',\n        meaningPt: \'\303\211 uma conduta inaceit\303\241vel para quem \303\251 professor.\'\n      }\n    ]\n  }\n];\n"
    }
