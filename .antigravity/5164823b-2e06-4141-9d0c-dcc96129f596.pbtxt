\204 \343\201\257 \343\201\212\343\201\212\343\201\215\343\201\204 \343\201\247\343\201\231\343\200\202\',\n      romaji: \'Watashi no heya wa ookii desu.\',\n      meaningPt: \'Meu quarto \303\251 grande.\'\n    }\n  },\n  {\n    id: \'v_n5_18\',\n    word: \'\345\260\217\343\201\225\343\201\204\',\n    reading: \'\343\201\241\343\201\204\343\201\225\343\201\204\',\n    romaji: \'chiisai\',\n    meaningPt: \'Pequeno\',\n    category: \'adjetivo_i\',\n    jlpt: \'N5\',\n    categoryLabelPt: \'Adjetivo-I (\343\201\204)\',\n    exampleSentence: {\n      jp: \'\345\260\217\343\201\225\343\201\204\347\214\253\343\201\214\343\201\204\343\201\276\343\201\231\343\200\202\',\n      reading: \'\343\201\241\343\201\204\343\201\225\343\201\204 \343\201\255\343\201\223 \343\201\214 \343\201\204\343\201\276\343\201\231\343\200\202\',\n      romaji: \'Chiisai neko ga imasu.\',\n      meaningPt: \'H\303\241 um gatinho pequeno.\'\n    }\n  },\n  {\n    id: \'v_n5_19\',\n    word: \'\346\226\260\343\201\227\343\201\204\',\n    reading: \'\343\201\202\343\201\237\343\202\211\343\201\227\343\201\204\',\n    romaji: \'atarashii\',\n    meaningPt: \'Novo\',\n    category: \'adjetivo_i\',\n    jlpt: \'N5\',\n    categoryLabelPt: \'Adjetivo-I (\343\201\204)\',\n    exampleSentence: {\n      jp: \'\346\226\260\343\201\227\343\201\204\351\235\264\343\202\222\350\262\267\343\201\204\343\201\276\343\201\227\343\201\237\343\200\202\',\n      reading: \'\343\201\202\343\201\237\343\202\211\343\201\227\343\201\204 \343\201\217\343\201\244 \343\202\222 \343\201\213\343\201\204\343\201\276\343\201\227\343\201\237\343\200\202\',\n      romaji: \'Atarashii kutsu o kaimashita.\',\n      meaningPt: \'Comprei um cal\303\247ado novo.\'\n    }\n  },\n  {\n    id: \'v_n5_20\',\n    word: \'\347\276\216\345\221\263\343\201\227\343\201\204\',\n    reading: \'\343\201\212\343\201\204\343\201\227\343\201\204\',\n    romaji: \'oishii\',\n    meaningPt: \'Gostoso / Saboroso\',\n    category: \'adjetivo_i\',\n    jlpt: \'N5\',\n    categoryLabelPt: \'Adjetivo-I (\343\201\204)\',\n    exampleSentence: {\n      jp: \'\343\201\223\343\201\256\343\203\251\343\203\274\343\203\241\343\203\263\343\201\257\343\201\250\343\201\246\343\202\202\347\276\216\345\221\263\343\201\227\343\201\204\343\201\247\343\201\231\343\200\202\',\n      reading: \'\343\201\223\343\201\256 \343\203\251\343\203\274\343\203\241\343\203\263 \343\201\257 \343\201\250\343\201\246\343\202\202 \343\201\212\343\201\204\343\201\227\343\201\204 \343\201\247\343\201\231\343\200\202\',\n      romaji: \'Kono raamen wa totemo oishii desu.\',\n      meaningPt: \'Este l\303\241men \303\251 muito gostoso.\'\n    }\n  },\n  {\n    id: \'v_n5_21\',\n    word: \'\351\253\230\343\201\204\',\n    reading: \'\343\201\237\343\201\213\343\201\204\',\n    romaji: \'takai\',\n    meaningPt: \'Alto / Caro\',\n    category: \'adjetivo_i\',\n    jlpt: \'N5\',\n    categoryLabelPt: \'Adjetivo-I (\343\201\204)\',\n    exampleSentence: {\n      jp: \'\343\201\223\343\201\256\346\231\202\350\250\210\343\201\257\351\253\230\343\201\204\343\201\247\343\201\231\343\200\202\',\n      reading: \'\343\201\223\343\201\256 \343\201\250\343\201\221\343\201\204 \343\201\257 \343\201\237\343\201\213\343\201\204 \343\201\247\343\201\231\343\200\202\',\n      romaji: \'Kono tokei wa takai desu.\',\n      meaningPt: \'Este rel\303\263gio \303\251 caro.\'\n    }\n  },\n\n  // ================= ADJETIVOS-NA (\343\201\252) =================\n  {\n    id: \'v_n5_22\',\n    word: \'\351\235\231\343\201\213\',\n    reading: \'\343\201\227\343\201\232\343\201\213\',\n    romaji: \'shizuka\',\n    meaningPt: \'Silencioso / Calmo / Tranquilo\',\n    category: \'adjetivo_na\',\n    jlpt: \'N5\',\n    categoryLabelPt: \'Adjetivo-Na (\343\201\252)\',\n    exampleSentence: {\n      jp: \'\345\244\234\343\201\256\347\224\272\343\201\257\351\235\231\343\201\213\343\201\247\343\201\231\343\200\202\',\n      reading: \'\343\202\210\343\202\213 \343\201\256 \343\201\276\343\201\241 \343\201\257 \343\201\227\343\201\232\343\201\213 \343\201\247\343\201\231\343\200\202\',\n      romaji: \'Yoru no machi wa shizuka desu.\',\n      meaningPt: \'A cidade \303\240 noite \303\251 silenciosa.\'\n    }\n  },\n  {\n    id: \'v_n5_23\',\n    word: \'\346\234\211\345\220\215\',\n    reading: \'\343\202\206\343\201\206\343\202\201\343\201\204\',\n    romaji: \'yuumei\',\n    meaningPt: \'Famoso / C\303\251lebre\',\n    category: \'adjetivo_na\',\n    jlpt: \'N5\',\n    categoryLabelPt: \'Adjetivo-Na (\343\201\252)\',\n    exampleSentence: {\n      jp: \'\344\272\254\351\203\275\343\201\257\346\234\211\345\220\215\343\201\252\350\246\263\345\205\211\345\234\260\343\201\247\343\201\231\343\200\202\',\n      reading: \'\343\201\215\343\202\207\343\201\206\343\201\250 \343\201\257 \343\202\206\343\201\206\343\202\201\343\201\204\343\201\252 \343\201\213\343\202\223\343\201\223\343\201\206\343\201\241 \343\201\247\343\201\231\343\200\202\',\n      romaji: \'Kyouto wa yuumei na kankouchi desu.\',\n      meaningPt: \'Kyoto \303\251 um destino tur\303\255stico famoso.\'\n    }\n  },\n  {\n    id: \'v_n5_24\',\n    word: \'\345\205\203\346\260\227\',\n    reading: \'\343\201\222\343\202\223\343\201\215\',\n    romaji: \'genki\',\n    meaningPt: \'Disposto / Saud\303\241vel / En\303\251rgico\',\n    category: \'adjetivo_na\',\n    jlpt: \'N5\',\n    categoryLabelPt: \'Adjetivo-Na (\343\201\252)\',\n    exampleSentence: {\n      jp: \'\343\201\212\345\205\203\346\260\227\343\201\247\343\201\231\343\201\213\343\200\202\',\n      reading: \'\343\201\212\343\201\222\343\202\223\343\201\215 \343\201\247\343\201\231 \343\201\213\343\200\202\',\n      romaji: \'O-genki desu ka.\',\n      meaningPt: \'Como voc\303\252 est\303\241? (Est\303\241 bem/saud\303\241vel?)\'\n    }\n  },\n\n  // ================= SUBSTANTIVOS =================\n  {\n    id: \'v_n5_25\',\n    word: \'\345\255\246\346\240\241\',\n    reading: \'\343\201\214\343\201\243\343\201\223\343\201\206\',\n    romaji: \'gakkou\',\n    meaningPt: \'Escola\',\n    category: \'substantivo\',\n    jlpt: \'N5\',\n    categoryLabelPt: \'Substantivo\',\n    exampleSentence: {\n      jp: \'\350\207\252\350\273\242\350\273\212\343\201\247\345\255\246\346\240\241\343\201\270\350\241\214\343\201\215\343\201\276\343\201\231\343\200\202\',\n      reading: \'\343\201\230\343\201\246\343\202\223\343\201\227\343\202\203 \343\201\247 \343\201\214\343\201\243\343\201\223\343\201\206 \343\201\270 \343\201\204\343\201\215\343\201\276\343\201\231\343\200\202\',\n      romaji: \'Jitensha de gakkou e ikimasu.\',\n      meaningPt: \'Vou para a escola de bicicleta.\'\n    }\n  },\n  {\n    id: \'v_n5_26\',\n    word: \'\345\217\213\351\201\224\',\n    reading: \'\343\201\250\343\202\202\343\201\240\343\201\241\',\n    romaji: \'tomodachi\',\n    meaningPt: \'Amigo / Colega\',\n    category: \'substantivo\',\n    jlpt: \'N5\',\n    categoryLabelPt: \'Substantivo\',\n    exampleSentence: {\n      jp: \'\345\217\213\351\201\224\343\201\250\344\270\200\347\267\222\343\201\253\346\230\240\347\224\273\343\202\222\350\246\213\343\201\276\343\201\227\343\201\237\343\200\202\',\n      reading: \'\343\201\250\343\202\202\343\201\240\343\201\241 \343\201\250 \343\201\204\343\201\243\343\201\227\343\202\207 \343\201\253 \343\201\210\343\201\204\343\201\214 \343\202\222 \343\201\277\343\201\276\343\201\227\343\201\237\343\200\202\',\n      romaji: \'Tomodachi to issho ni eiga o mimashita.\',\n      meaningPt: \'Assisti a um filme junto com um amigo.\'\n    }\n  },\n  {\n    id: \'v_n5_27\',\n    word: \'\346\231\202\351\226\223\',\n    reading: \'\343\201\230\343\201\213\343\202\223\',\n    romaji: \'jikan\',\n    meaningPt: \'Tempo / Hora\',\n    category: \'substantivo\',\n    jlpt: \'N5\',\n    categoryLabelPt: \'Substantivo\',\n    exampleSentence: {\n      jp: \'\343\201\276\343\201\240\346\231\202\351\226\223\343\201\214\343\201\237\343\201\217\343\201\225\343\202\223\343\201\202\343\202\212\343\201\276\343\201\231\343\200\202\',\n      reading: \'\343\201\276\343\201\240 \343\201\230\343\201\213\343\202\223 \343\201\214 \343\201\237\343\201\217\343\201\225\343\202\223 \343\201\202\343\202\212\343\201\276\343\201\231\343\200\202\',\n      romaji: \'Mada jikan ga takusan arimasu.\',\n      meaningPt: \'Ainda temos bastante tempo.\'\n    }\n  },\n\n  // ================= ADV\303\211RBIOS & EXPRESS\303\225ES =================\n  {\n    id: \'v_n5_28\',\n    word: \'\343\201\204\343\201\244\343\202\202\',\n    reading: \'\343\201\204\343\201\244\343\202\202\',\n    romaji: \'itsumo\',\n    meaningPt: \'Sempre\',\n    category: \'adverbio\',\n    jlpt: \'N5\',\n    categoryLabelPt: \'Adv\303\251rbio\',\n    exampleSentence: {\n      jp: \'\343\201\204\343\201\244\343\202\202\346\234\235\343\201\224\343\201\257\343\202\223\343\202\222\351\243\237\343\201\271\343\201\276\343\201\231\343\200\202\',\n      reading: \'\343\201\204\343\201\244\343\202\202 \343\201\202\343\201\225\343\201\224\343\201\257\343\202\223 \343\202\222 \343\201\237\343\201\271\343\201\276\343\201\231\343\200\202\',\n      romaji: \'Itsumo asagohan o tabemasu.\',\n      meaningPt: \'Sempre tomo caf\303\251 da manh\303\243.\'\n    }\n  },\n  {\n    id: \'v_n5_29\',\n    word: \'\343\201\250\343\201\246\343\202\202\',\n    reading: \'\343\201\250\343\201\246\343\202\202\',\n    romaji: \'totemo\',\n    meaningPt: \'Muito (intensidade)\',\n    category: \'adverbio\',\n    jlpt: \'N5\',\n    categoryLabelPt: \'Adv\303\251rbio\',\n    exampleSentence: {\n      jp: \'\344\273\212\346\227\245\343\201\257\343\201\250\343\201\246\343\202\202\345\257\222\343\201\204\343\201\247\343\201\231\343\200\202\',\n      reading: \'\343\201\215\343\202\207\343\201\206 \343\201\257 \343\201\250\343\201\246\343\202\202 \343\201\225\343\202\200\343\201\204 \343\201\247\343\201\231\343\200\202\',\n      romaji: \'Kyou wa totemo samui desu.\',\n      meaningPt: \'Hoje est\303\241 muito frio.\'\n    }\n  },\n  {\n    id: \'v_n5_30\',\n    word: \'\343\201\202\343\202\212\343\201\214\343\201\250\343\201\206\',\n    reading: \'\343\201\202\343\202\212\343\201\214\343\201\250\343\201\206\',\n    romaji: \'arigatou\',\n    meaningPt: \'Obrigado(a)\',\n    category: \'expressao\',\n    jlpt: \'N5\',\n    categoryLabelPt: \'Express\303\243o Cotidiana\',\n    exampleSentence: {\n      jp: \'\346\211\213\344\274\235\343\201\243\343\201\246\343\201\217\343\202\214\343\201\246\343\201\202\343\202\212\343\201\214\343\201\250\343\201\206\343\201\224\343\201\226\343\201\204\343\201\276\343\201\231\343\200\202\',\n      reading: \'\343\201\246\343\201\244\343\201\240\343\201\243\343\201\246\343\201\217\343\202\214\343\201\246 \343\201\202\343\202\212\343\201\214\343\201\250\343\201\206 \343\201\224\343\201\226\343\201\204\343\201\276\343\201\231\343\200\202\',\n      romaji: \'Tetsudatte kurete arigatou gozaimasu.\',\n      meaningPt: \'Muito obrigado por me ajudar.\'\n    }\n  }\n];\n"
