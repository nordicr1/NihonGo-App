      replacement_content: "import { QuizQuestion } from \'../types\';\n\nexport const QUIZ_QUESTIONS: QuizQuestion[] = [\n  // ===================== N5 QUESTIONS =====================\n  {\n    id: \'q_1\',\n    jlpt: \'N5\',\n    category: \'Part\303\255culas\',\n    question: \'\343\202\217\343\201\237\343\201\227 ____ \347\224\260\344\270\255 \343\201\247\343\201\231\343\200\202\',\n    questionRomaji: \'Watashi ___ Tanaka desu.\',\n    questionPt: \'Escolha a part\303\255cula de t\303\263pico correta para completar: \"Eu sou Tanaka.\"\',\n    options: [\'\343\201\257 (wa)\', \'\343\202\222 (o)\', \'\343\201\247 (de)\', \'\343\201\270 (e)\'],\n    correctIndex: 0,\n    explanationPt: \'A part\303\255cula \343\201\257 (pronunciada \"wa\") \303\251 a marcadora de T\303\263pico da frase (\"Quanto a mim, sou o Tanaka\").\'\n  },\n  {\n    id: \'q_2\',\n    jlpt: \'N5\',\n    category: \'Part\303\255culas\',\n    question: \'\343\203\254\343\202\271\343\203\210\343\203\251\343\203\263 ____ \345\257\277\345\217\270\343\202\222\351\243\237\343\201\271\343\201\276\343\201\231\343\200\202\',\n    questionRomaji: \'Resutoran ___ sushi o tabemasu.\',\n    questionPt: \'Escolha a part\303\255cula que indica o LOCAL onde uma a\303\247\303\243o din\303\242mica acontece: \"Como sushi no restaurante.\"\',\n    options: [\'\343\201\253 (ni)\', \'\343\201\247 (de)\', \'\343\201\270 (e)\', \'\343\201\250 (to)\'],\n    correctIndex: 1,\n    explanationPt: \'A part\303\255cula \343\201\247 (de) indica o local onde uma a\303\247\303\243o ativa ou din\303\242mica ocorre.\'\n  },\n  {\n    id: \'q_3\',\n    jlpt: \'N5\',\n    category: \'Kanji\',\n    question: \'Qual \303\251 o significado em Portugu\303\252s do Kanji \343\200\214\346\260\264\343\200\215?\',\n    questionRomaji: \'Mizu (sui)\',\n    questionPt: \'Identifique o elemento e significado correto:\',\n    options: [\'Fogo\', \'\303\201rvore\', \'\303\201gua\', \'Ouro / Dinheiro\'],\n    correctIndex: 2,\n    explanationPt: \'\343\200\214\346\260\264\343\200\215 l\303\252-se \"mizu\" (leitura kun) ou \"sui\" (leitura on) e significa \303\201gua.\'\n  },\n  {\n    id: \'q_n5_k1\',\n    jlpt: \'N5\',\n    category: \'Kanji\',\n    question: \'Como se l\303\252 a palavra em kanji \343\200\214\346\227\245\346\234\254\343\200\215?\',\n    questionRomaji: \'Kanji: \346\227\245\346\234\254\',\n    questionPt: \'Identifique a leitura correta do pa\303\255s Jap\303\243o:\',\n    options: [\'\343\201\253\343\201\273\343\202\223 (nihon)\', \'\343\201\276\343\201\204\343\201\241\343\201\253 (mainichi)\', \'\343\201\253\343\201\241\343\202\210\343\201\206 (nichiyou)\', \'\343\201\273\343\202\223\343\201\230\343\202\223 (honjin)\'],\n    correctIndex: 0,\n    explanationPt: \'\343\200\214\346\227\245\346\234\254\343\200\215 combina \346\227\245 (sol) e \346\234\254 (origem), lendo-se \"Nihon\" ou \"Nippon\" (Origem do Sol / Jap\303\243o).\'\n  },\n  {\n    id: \'q_n5_k2\',\n    jlpt: \'N5\',\n    category: \'Kanji\',\n    question: \'Qual kanji representa \"Grande\" em japon\303\252s?\',\n    questionRomaji: \'Grande / Ookii\',\n    questionPt: \'Selecione o ideograma correspondente a Grande:\',\n    options: [\'\345\260\217 (chii)\', \'\345\244\247 (oo / dai)\', \'\344\270\255 (naka)\', \'\351\253\230 (taka)\'],\n    correctIndex: 1,\n    explanationPt: \'\343\200\214\345\244\247\343\200\215 significa Grande (ex: \345\244\247\343\201\215\343\201\204 ookii, \345\244\247\345\255\246 daigaku).\'\n  },\n  {\n    id: \'q_4\',\n    jlpt: \'N5\',\n    category: \'Vocabul\303\241rio\',\n    question: \'Como se diz \"Gostoso / Delicioso\" em japon\303\252s?\',\n    questionRomaji: \'Delicioso / Saboroso\',\n    questionPt: \'Selecione o adjetivo correspondente:\',\n    options: [\'\343\201\237\343\201\213\343\201\204 (takai)\', \'\343\201\212\343\201\204\343\201\227\343\201\204 (oishii)\', \'\343\201\202\343\201\237\343\202\211\343\201\227\343\201\204 (atarashii)\', \'\343\201\227\343\201\232\343\201\213 (shizuka)\'],\n    correctIndex: 1,\n    explanationPt: \'\343\200\214\343\201\212\343\201\204\343\201\227\343\201\204 (\347\276\216\345\221\263\343\201\227\343\201\204)\343\200\215 significa gostoso, delicioso.\'\n  },\n\n  // ===================== N4 QUESTIONS =====================\n  {\n    id: \'q_5\',\n    jlpt: \'N4\',\n    category: \'Gram\303\241tica\',\n    question: \'\346\227\245\346\234\254\343\201\270\350\241\214\343\201\243\343\201\237 ____ \343\201\214\343\201\202\343\202\212\343\201\276\343\201\231\343\200\202\',\n    questionRomaji: \'Nihon e itta ___ ga arimasu.\',\n    questionPt: \'Complete a estrutura que indica EXPERI\303\212NCIA PASSADA (\"J\303\241 estive no Jap\303\243o\"):\',\n    options: [\'\343\201\223\343\201\250 (koto)\', \'\343\202\202\343\201\256 (mono)\', \'\343\201\250\343\201\215 (toki)\', \'\343\201\237\343\202\201 (tame)\'],\n    correctIndex: 0,\n    explanationPt: \'A estrutura \343\200\234\343\201\237\343\201\223\343\201\250\343\201\214\343\201\202\343\202\213 (forma ta + koto ga aru) \303\251 usada para expressar experi\303\252ncias passadas.\'\n  },\n  {\n    id: \'q_n4_k1\',\n    jlpt: \'N4\',\n    category: \'Kanji\',\n    question: \'Qual \303\251 a leitura da palavra em kanji \343\200\214\345\256\266\346\227\217\343\200\215?\',\n    questionRomaji: \'Kanji: \345\256\266\346\227\217\',\n    questionPt: \'Identifique a leitura correspondente a \"Fam\303\255lia\":\',\n    options: [\'\343\201\213\343\201\236\343\201\217 (kazoku)\', \'\343\201\215\343\202\207\343\201\206\343\201\240\343\201\204 (kyoudai)\', \'\343\201\224\343\201\227\343\202\205\343\201\230\343\202\223 (goshujin)\', \'\343\201\250\343\202\202\343\201\240\343\201\241 (tomodachi)\'],\n    correctIndex: 0,\n    explanationPt: \'\343\200\214\345\256\266\346\227\217\343\200\215 combina \345\256\266 (casa) e \346\227\217 (fam\303\255lia/cl\303\243), lendo-se \"Kazoku\" (Fam\303\255lia).\'\n  },\n  {\n    id: \'q_n4_k2\',\n    jlpt: \'N4\',\n    category: \'Kanji\',\n    question: \'O kanji \343\200\214\345\206\231\343\200\215 em \343\200\214\345\206\231\347\234\237 (shashin)\343\200\215 significa:\',\n    questionRomaji: \'Kanji: \345\206\231 (sha / utsu.su)\',\n    questionPt: \'Identifique o conceito base do ideograma:\',\n    options: [\'Comer\', \'Copiar / Fotografar / Refletir\', \'Viajar\', \'Ensinar\'],\n    correctIndex: 1,\n    explanationPt: \'\343\200\214\345\206\231\343\200\215 significa copiar/fotografar. Junto com \347\234\237 (verdade), forma \345\206\231\347\234\237 (fotografia = c\303\263pia da verdade).\'\n  },\n  {\n    id: \'q_6\',\n    jlpt: \'N4\',\n    category: \'Gram\303\241tica\',\n    question: \'\350\226\254\343\202\222 ____ \343\201\252\343\201\221\343\202\214\343\201\260\343\201\252\343\202\212\343\201\276\343\201\233\343\202\223\343\200\202\',\n    questionRomaji: \'Kusuri o ___ nakereba narimasen.\',\n    questionPt: \'Complete com a forma correta do verbo \351\243\262\343\202\200 (beber/tomar rem\303\251dio) para indicar obriga\303\247\303\243o (\"Tenho que tomar rem\303\251dio\"):\',\n    options: [\'\351\243\262\343\201\276 (noma)\', \'\351\243\262\343\201\277 (nomi)\', \'\351\243\262\343\202\223\343\201\247 (nonde)\', \'\351\243\262\343\202\200 (nomu)\'],\n    correctIndex: 0,\n    explanationPt: \'A f\303\263rmula de obriga\303\247\303\243o utiliza a raiz negativa sem o \343\201\204 (forma nai: \351\243\262\343\201\276\343\201\252\343\201\204 \342\236\224 \351\243\262\343\201\276 + \343\201\252\343\201\221\343\202\214\343\201\260\343\201\252\343\202\212\343\201\276\343\201\233\343\202\223).\'\n  },\n\n  // ===================== N3 QUESTIONS =====================\n  {\n    id: \'q_n3_k1\',\n    jlpt: \'N3\',\n    category: \'Kanji\',\n    question: \'Qual \303\251 o significado da palavra em kanji \343\200\214\347\265\214\346\270\210\343\200\215?\',\n    questionRomaji: \'Keizai (\347\265\214\346\270\210)\',\n    questionPt: \'Selecione o significado correto deste voc\303\241bulo N3:\',\n    options: [\'Economia\', \'Pol\303\255tica\', \'Casamento\', \'Tecnologia\'],\n    correctIndex: 0,\n    explanationPt: \'\343\200\214\347\265\214\346\270\210 (\343\201\221\343\201\204\343\201\226\343\201\204 - keizai)\343\200\215 significa Economia.\'\n  },\n  {\n    id: \'q_n3_k2\',\n    jlpt: \'N3\',\n    category: \'Kanji\',\n    question: \'O que significa a palavra \343\200\214\347\242\272\350\252\215\343\200\215 no dia a dia japon\303\252s?\',\n    questionRomaji: \'Kakunin (\347\242\272\350\252\215)\',\n    questionPt: \'Identifique a a\303\247\303\243o:\',\n    options: [\'Confirma\303\247\303\243o / Checagem\', \'Cancelamento\', \'Atraso de trem\', \'Demiss\303\243o\'],\n    correctIndex: 0,\n    explanationPt: \'\343\200\214\347\242\272\350\252\215 (\343\201\213\343\201\217\343\201\253\343\202\223 - kakunin)\343\200\215 significa Confirma\303\247\303\243o, verifica\303\247\303\243o ou checagem.\'\n  },\n  {\n    id: \'q_7\',\n    jlpt: \'N3\',\n    category: \'Gram\303\241tica\',\n    question: \'\350\276\233\343\201\204\346\226\231\347\220\206\343\201\214\345\253\214\343\201\204\343\201\252 ____ \343\201\247\343\201\257\343\201\252\343\201\204\343\201\214\343\200\201\343\201\202\343\201\276\343\202\212\351\243\237\343\201\271\343\201\252\343\201\204\343\200\202\',\n    questionRomaji: \'Karai ryouri ga kirai na ___ dewa nai ga, amari tabenai.\',\n    questionPt: \'Selecione o termo que expressa nega\303\247\303\243o parcial (\"N\303\243o \303\251 que eu n\303\243o goste...\"):\',\n    options: [\'\343\202\217\343\201\221 (wake)\', \'\343\201\257\343\201\232 (hazu)\', \'\343\201\244\343\202\202\343\202\212 (tsumori)\', \'\343\201\250\343\201\223\343\202\215 (tokoro)\'],\n    correctIndex: 0,\n    explanationPt: \'\343\200\234\343\202\217\343\201\221\343\201\247\343\201\257\343\201\252\343\201\204 (wake dewa nai) expressa nega\303\247\303\243o parcial: \"N\303\243o significa que...\" ou \"N\303\243o \303\251 que...\".\'\n  },\n\n  // ===================== N2 QUESTIONS =====================\n  {\n    id: \'q_n2_1\',\n    jlpt: \'N2\',\n    category: \'Gram\303\241tica\',\n    question: \'\345\275\274\343\201\257\346\257\216\346\227\245\345\213\211\345\274\267\343\201\227\343\201\246\343\201\204\343\201\237\343\201\213\343\202\211\343\200\201\350\251\246\351\250\223\343\201\253\345\220\210\346\240\274\343\201\231\343\202\213\343\201\253 ____\343\200\202\',\n    questionRomaji: \'Kare wa mainichi benkyou shite ita kara, shiken ni goukaku suru ni ___.\',\n    questionPt: \'Complete com a express\303\243o que indica forte convic\303\247\303\243o / certeza absoluta (\"Sem d\303\272vida passar\303\241 no exame\"):\',\n    options: [\'\351\201\225\343\201\204\343\201\252\343\201\204 (chigainai)\', \'\351\231\220\343\202\211\343\201\252\343\201\204 (kagiranai)\', \'\343\201\273\343\201\213\343\201\252\343\202\211\343\201\252\343\201\204 (hokanaranai)\', \'\343\201\231\343\201\216\343\201\252\343\201\204 (suginai)\'],\n    correctIndex: 0,\n    explanationPt: \'\343\200\234\343\201\253\351\201\225\343\201\204\343\201\252\343\201\204 (ni chigainai) expressa forte certeza e convic\303\247\303\243o do falante baseada em fatos.\'\n  },\n  {\n    id: \'q_n2_2\',\n    jlpt: \'N2\',\n    category: \'Kanji\',\n    question: \'O kanji \343\200\214\346\206\262\343\200\215 na palavra \343\200\214\346\206\262\346\263\225 (kenpou)\343\200\215 significa:\',\n    questionRomaji: \'Kenpou (\346\206\262\346\263\225)\',\n    questionPt: \'Qual o significado deste kanji formal de n\303\255vel N2?\',\n    options: [\'Constitui\303\247\303\243o / Lei Fundamental\', \'Tr\303\242nsito\', \'Agricultura\', \'Clima\'],\n    correctIndex: 0,\n    explanationPt: \'\343\200\214\346\206\262\343\200\215 refere-se \303\240 Constitui\303\247\303\243o e leis fundamentais do Estado (\346\206\262\346\263\225 - kenpou).\'\n  },\n  {\n    id: \'q_n2_3\',\n    jlpt: \'N2\',\n    category: \'Gram\303\241tica\',\n    question: \'\343\202\242\343\203\263\343\202\261\343\203\274\343\203\210\350\252\277\346\237\273\343\201\256\347\265\220\346\236\234\343\201\253 ____ \346\226\260\350\243\275\345\223\201\343\202\222\351\226\213\347\231\272\343\201\227\343\201\237\343\200\202\',\n    questionRomaji: \'Ankeeto chousa no kekka ni ___ shinseihin o kaihatsu shita.\',\n    questionPt: \'Complete indicando fundamenta\303\247\303\243o (\"Com base nos resultados da pesquisa\"):\',\n    options: [\'\345\237\272\343\201\245\343\201\204\343\201\246 (motozuite)\', \'\343\201\227\343\201\237\343\201\214\343\201\243\343\201\246 (shitagatte)\', \'\343\201\244\343\202\214\343\201\246 (tsurete)\', \'\343\201\223\343\201\237\343\201\210\343\201\246 (kotaete)\'],\n    correctIndex: 0,\n    explanationPt: \'\343\200\234\343\201\253\345\237\272\343\201\245\343\201\204\343\201\246 (ni motozuite) expressa que algo foi constru\303\255do ou decidido tendo dados e fatos como base.\'\n  },\n  {\n    id: \'q_n2_4\',\n    jlpt: \'N2\',\n    category: \'Kanji\',\n    question: \'Como se l\303\252 e o que significa o kanji \343\200\214\350\262\277\346\230\223\343\200\215?\',\n    questionRomaji: \'Kanji: \350\262\277\346\230\223\',\n    questionPt: \'Identifique a leitura e o significado:\',\n    options: [\n      \'\343\201\274\343\201\206\343\201\210\343\201\215 (boueki) - Com\303\251rcio exterior\',\n      \'\343\201\250\343\201\206\343\201\215\343\202\207\343\201\206 (toukyou) - Capital\',\n      \'\343\202\212\343\202\207\343\201\223\343\201\206 (ryokou) - Viagem tur\303\255stica\',\n      \'\343\201\215\343\201\216\343\202\207\343\201\206 (kigyou) - Empresa privada\'\n    ],\n    correctIndex: 0,\n    explanationPt: \'\343\200\214\350\262\277\346\230\223 (\343\201\274\343\201\206\343\201\210\343\201\215 - boueki)\343\200\215 \303\251 a palavra para Com\303\251rcio Exterior / Importa\303\247\303\243o e Exporta\303\247\303\243o.\'\n  },\n  {\n    id: \'q_n2_5\',\n    jlpt: \'N2\',\n    category: \'Gram\303\241tica\',\n    question: \'\346\230\216\346\227\245\343\201\257\345\244\247\344\272\213\343\201\252\343\203\227\343\203\254\343\202\274\343\203\263\343\201\214\343\201\202\343\202\213\343\201\213\343\202\211\343\200\201\344\274\221\343\202\200 ____ \343\201\253\343\201\257\343\201\204\343\201\213\343\201\252\343\201\204\343\200\202\',\n    questionRomaji: \'Ashita wa daiji na purezen ga aru kara, yasumu ___ ni wa ikanai.\',\n    questionPt: \'Complete indicando restri\303\247\303\243o moral/profissional (\"N\303\243o posso me dar ao luxo de faltar\"):\',\n    options: [\'\343\202\217\343\201\221 (wake)\', \'\343\201\223\343\201\250 (koto)\', \'\343\202\202\343\201\256 (mono)\', \'\343\201\257\343\201\232 (hazu)\'],\n    correctIndex: 0,\n    explanationPt: \'\343\200\234\343\202\217\343\201\221\343\201\253\343\201\257\343\201\204\343\201\213\343\201\252\343\201\204 (wake ni wa ikanai) indica impossibilidade por raz\303\265es \303\251ticas, profissionais ou sociais.\'\n  },\n\n  // ===================== N1 QUESTIONS =====================\n  {\n    id: \'q_n1_1\',\n    jlpt: \'N1\',\n    category: \'Gram\303\241tica\',\n    question: \'\343\203\227\343\203\255\343\201\256\346\225\231\350\202\262\350\200\205\343\201\250\343\201\227\343\201\246\343\201\202\343\202\213 ____ \350\241\214\347\202\272\343\201\240\343\200\202\',\n    questionRomaji: \'Puro no kyouikusha to shite aru ___ koui da.\',\n    questionPt: \'Complete com o padr\303\243o liter\303\241rio que expressa indigna\303\247\303\243o por postura inaceit\303\241vel (\"Inadmiss\303\255vel para quem ocupa tal cargo\"):\',\n    options: [\'\343\201\276\343\201\230\343\201\215 (majiki)\', \'\343\201\271\343\201\215 (beki)\', \'\343\201\226\343\202\213 (zaru)\', \'\343\201\224\343\201\250\343\201\215 (gotoki)\'],\n    correctIndex: 0,\n    explanationPt: \'\343\200\234\343\201\276\343\201\230\343\201\215 (majiki) \303\251 uma estrutura formal N1 que condena uma conduta como inaceit\303\241vel para a posi\303\247\303\243o de algu\303\251m.\'\n  },\n  {\n    id: \'q_n1_2\',\n    jlpt: \'N1\',\n    category: \'Kanji\',\n    question: \'Qual \303\251 o kanji de 29 tra\303\247os que significa \"Melancolia / Depress\303\243o cl\303\255nica\" na palavra \343\200\214\346\206\202\351\254\261 (yuuutsu)\343\200\215?\',\n    questionRomaji: \'Yuuutsu / Utsubyou\',\n    questionPt: \'Identifique o ideograma c\303\251lebre do JLPT N1:\',\n    options: [\'\351\254\261 (utsu)\', \'\351\221\221 (kan)\', \'\350\246\207 (ha)\', \'\345\214\277 (toku)\'],\n    correctIndex: 0,\n    explanationPt: \'\343\200\214\351\254\261 (\343\202\246\343\203\204 - utsu)\343\200\215 \303\251 o kanji de 29 tra\303\247os que representa melancolia e depress\303\243o (\346\206\202\351\254\261 / \351\254\261\347\227\205).\'\n  },\n  {\n    id: \'q_n1_3\',\n    jlpt: \'N1\',\n    category: \'Gram\303\241tica\',\n    question: \'\347\220\206\347\224\261\343\201\214\344\275\225 ____\343\200\201\344\273\226\344\272\272\343\201\253\345\215\261\345\256\263\343\202\222\345\212\240\343\201\210\343\202\213\343\201\223\343\201\250\343\201\257\350\250\261\343\201\225\343\202\214\343\201\252\343\201\204\343\200\202\',\n    questionRomaji: \'Riyuu ga nani ___, tanin ni kigai o kuwaeru koto wa yurusarenai.\',\n    questionPt: \'Complete expressando universalidade categ\303\263rica (\"N\303\243o importa qual seja a raz\303\243o...\"):\',\n    options: [\'\343\201\247\343\201\202\343\202\214 (de are)\', \'\343\201\253\343\201\227\343\201\246 (ni shite)\', \'\343\201\250\343\201\202\343\201\243\343\201\246 (to atte)\', \'\343\202\222\343\201\212\343\201\204\343\201\246 (o oite)\'],\n    correctIndex: 0,\n    explanationPt: \'\343\200\234\343\201\247\343\201\202\343\202\214 (de are) significa \"seja o que for / n\303\243o importa a condi\303\247\303\243o\", enfatizando uma verdade inegoci\303\241vel.\'\n  },\n  {\n    id: \'q_n1_4\',\n    jlpt: \'N1\',\n    category: \'Kanji\',\n    question: \'O kanji \343\200\214\351\221\221\343\200\215 na palavra \343\200\214\351\221\221\350\263\2