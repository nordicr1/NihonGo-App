    replacement_chunks {
      replacement_content: "import { GrammarItem } from \'../types\';\n\nexport const GRAMMAR_N3: GrammarItem[] = [\n  {\n    id: \'g_n3_1\',\n    pattern: \'\343\200\234\343\202\217\343\201\221\343\201\247\343\201\257\343\201\252\343\201\204 (~wake dewa nai)\',\n    titlePt: \'Nega\303\247\303\243o Parcial: \"N\303\243o \303\251 que... / N\303\243o quer dizer necessariamente que...\"\',\n    jlpt: \'N3\',\n    category: \'Nuance & Nega\303\247\303\243o Parcial\',\n    formationFormula: \'[Forma Simples (Verbo / Adj-I / Adj-NA+\343\201\252 / Substantivo+\343\201\247\343\201\202\343\202\213/\343\201\256)] + \343\202\217\343\201\221\343\201\247\343\201\257\343\201\252\343\201\204\',\n    explanationPt: \'Utilizado para evitar generaliza\303\247\303\265es exageradas ou amenizar uma afirma\303\247\303\243o, esclarecendo que embora uma impress\303\243o possa existir, a realidade n\303\243o \303\251 t\303\243o extrema.\',\n    keyRulePt: \'\342\200\242 Compara\303\247\303\243o: \345\253\214\343\201\204\343\201\247\343\201\257\343\201\252\343\201\204 (N\303\243o odeio) vs. \345\253\214\343\201\204\343\201\252\343\202\217\343\201\221\343\201\247\343\201\257\343\201\252\343\201\204 (N\303\243o \303\251 que eu odeie... h\303\241 circunst\303\242ncias).\',\n    examples: [\n      {\n        jp: \'\350\276\233\343\201\204\346\226\231\347\220\206\343\201\214\345\253\214\343\201\204\343\201\252\343\202\217\343\201\221\343\201\247\343\201\257\343\201\252\343\201\204\343\201\214\343\200\201\343\201\202\343\201\276\343\202\212\351\243\237\343\201\271\343\201\252\343\201\204\343\200\202\',\n        reading: \'\343\201\213\343\202\211\343\201\204 \343\202\212\343\202\207\343\201\206\343\202\212 \343\201\214 \343\201\215\343\202\211\343\201\204\343\201\252 \343\202\217\343\201\221\343\201\247\343\201\257\343\201\252\343\201\204 \343\201\214\343\200\201\343\201\202\343\201\276\343\202\212 \343\201\237\343\201\271\343\201\252\343\201\204\343\200\202\',\n        romaji: \'Karai ryouri ga kirai na wake dewa nai ga, amari tabenai.\',\n        meaningPt: \'N\303\243o \303\251 que eu n\303\243o goste de comida apimentada, mas n\303\243o como com frequ\303\252ncia.\'\n      },\n      {\n        jp: \'\346\227\245\346\234\254\350\252\236\343\201\214\345\205\250\343\201\217\350\251\261\343\201\233\343\201\252\343\201\204\343\202\217\343\201\221\343\201\247\343\201\257\343\201\202\343\202\212\343\201\276\343\201\233\343\202\223\343\200\202\',\n        reading: \'\343\201\253\343\201\273\343\202\223\343\201\224 \343\201\214 \343\201\276\343\201\243\343\201\237\343\201\217 \343\201\257\343\201\252\343\201\233\343\201\252\343\201\204 \343\202\217\343\201\221\343\201\247\343\201\257\343\201\202\343\202\212\343\201\276\343\201\233\343\202\223\343\200\202\',\n        romaji: \'Nihongo ga mattaku hanasenai wake dewa arimasen.\',\n        meaningPt: \'N\303\243o quer dizer que eu n\303\243o fale absolutamente nada de japon\303\252s.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n3_2\',\n    pattern: \'\343\200\234\343\202\217\343\201\221\343\201\214\343\201\252\343\201\204 / \343\200\234\343\201\257\343\201\232\343\201\214\343\201\252\343\201\204 (~wake ga nai / hazu ga nai)\',\n    titlePt: \'Impossibilidade Absoluta: \"N\303\243o h\303\241 como ser... / \303\211 imposs\303\255vel que...\"\',\n    jlpt: \'N3\',\n    category: \'Impossibilidade & Certeza\',\n    formationFormula: \'[Forma Simples (Adj-NA+\343\201\252 / Substantivo+\343\201\256)] + \343\202\217\343\201\221\343\201\214\343\201\252\343\201\204 / \343\201\257\343\201\232\343\201\214\343\201\252\343\201\204\',\n    explanationPt: \'Expressa convic\303\247\303\243o total de que algo \303\251 completamente inconceb\303\255vel ou il\303\263gico segundo os fatos conhecidos.\',\n    keyRulePt: \'Equivale enfaticamente a \"\347\265\266\345\257\276\343\201\253\343\200\234\343\201\252\343\201\204\" (Com certeza n\303\243o \303\251 verdade).\',\n    examples: [\n      {\n        jp: \'\345\275\274\343\201\214\345\230\230\343\202\222\343\201\244\343\201\217\343\202\217\343\201\221\343\201\214\343\201\202\343\202\212\343\201\276\343\201\233\343\202\223\343\200\202\',\n        reading: \'\343\201\213\343\202\214 \343\201\214 \343\201\206\343\201\235 \343\202\222 \343\201\244\343\201\217 \343\202\217\343\201\221 \343\201\214 \343\201\202\343\202\212\343\201\276\343\201\233\343\202\223\343\200\202\',\n        romaji: \'Kare ga uso o tsuku wake ga arimasen.\',\n        meaningPt: \'N\303\243o h\303\241 a menor possibilidade de ele mentir (Ele jamais mentiria).\'\n      },\n      {\n        jp: \'\343\201\223\343\202\223\343\201\252\343\201\253\347\260\241\345\215\230\343\201\252\345\225\217\351\241\214\343\201\214\343\202\217\343\201\213\343\202\211\343\201\252\343\201\204\343\201\257\343\201\232\343\201\214\343\201\252\343\201\204\343\200\202\',\n        reading: \'\343\201\223\343\202\223\343\201\252\343\201\253 \343\201\213\343\202\223\343\201\237\343\202\223\343\201\252 \343\202\202\343\202\223\343\201\240\343\201\204 \343\201\214 \343\202\217\343\201\213\343\202\211\343\201\252\343\201\204 \343\201\257\343\201\232\343\201\214\343\201\252\343\201\204\343\200\202\',\n        romaji: \'Konna ni kantan na mondai ga wakaranai hazu ga nai.\',\n        meaningPt: \'\303\211 imposs\303\255vel que voc\303\252 n\303\243o entenda uma quest\303\243o t\303\243o simples como esta.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n3_3\',\n    pattern: \'\343\200\234\343\201\206\343\201\241\343\201\253 / \343\200\234\343\201\252\343\201\204\343\201\206\343\201\241\343\201\253 (~uchi ni / nai uchi ni)\',\n    titlePt: \'Janela de Oportunidade: \"Enquanto ainda... / Antes que mude...\"\',\n    jlpt: \'N3\',\n    category: \'Tempo & Limite\',\n    formationFormula: \'[Verbo na forma Dicion\303\241rio / Forma-TE \343\201\204\343\202\213 / Forma-NAI / Adj-I / Adj-NA+\343\201\252 / Substantivo+\343\201\256] + \343\201\206\343\201\241\343\201\253\',\n    explanationPt: \'Indica que uma a\303\247\303\243o deve ser realizada enquanto um determinado estado favor\303\241vel permanece, antes que uma mudan\303\247a inevit\303\241vel aconte\303\247a.\',\n    keyRulePt: \'\342\200\242 \343\200\234\343\201\252\343\201\204\343\201\206\343\201\241\343\201\253 significa literalmente \"antes que aconte\303\247a X\": \346\232\227\343\201\217\343\201\252\343\202\211\343\201\252\343\201\204\343\201\206\343\201\241\343\201\253 (antes que escure\303\247a).\',\n    examples: [\n      {\n        jp: \'\346\270\251\343\201\213\343\201\204\343\201\206\343\201\241\343\201\253\345\217\254\343\201\227\344\270\212\343\201\214\343\201\243\343\201\246\343\201\217\343\201\240\343\201\225\343\201\204\343\200\202\',\n        reading: \'\343\201\202\343\201\237\343\201\237\343\201\213\343\201\204 \343\201\206\343\201\241 \343\201\253 \343\202\201\343\201\227\343\201\202\343\201\214\343\201\243\343\201\246\343\201\217\343\201\240\343\201\225\343\201\204\343\200\202\',\n        romaji: \'Atatakai uchi ni meshagatte kudasai.\',\n        meaningPt: \'Por favor, coma enquanto a comida ainda est\303\241 quentinha.\'\n      },\n      {\n        jp: \'\345\277\230\343\202\214\343\201\252\343\201\204\343\201\206\343\201\241\343\201\253\343\203\241\343\203\242\343\202\222\343\201\227\343\201\246\343\201\212\343\201\215\343\201\276\343\201\231\343\200\202\',\n        reading: \'\343\202\217\343\201\231\343\202\214\343\201\252\343\201\204 \343\201\206\343\201\241 \343\201\253 \343\203\241\343\203\242 \343\202\222 \343\201\227\343\201\246 \343\201\212\343\201\215\343\201\276\343\201\231\343\200\202\',\n        romaji: \'Wasurenai uchi ni memo o shite okimasu.\',\n        meaningPt: \'Vou anotar antes que eu me esque\303\247a.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n3_4\',\n    pattern: \'\343\200\234\351\226\223\343\201\253 (\343\200\234aida ni) vs \343\200\234\351\226\223 (\343\200\234aida)\',\n    titlePt: \'Dura\303\247\303\243o Cont\303\255nua vs A\303\247\303\243o Pontual no Intervalo\',\n    jlpt: \'N3\',\n    category: \'Tempo & Dura\303\247\303\243o\',\n    formationFormula: \'[Verbo no Cont\303\255nuo \343\200\234\343\201\246\343\201\204\343\202\213 / Substantivo+\343\201\256] + \351\226\223 (cont\303\255nuo simult\303\242neo) / \351\226\223\343\201\253 (a\303\247\303\243o pontual)\',\n    explanationPt: \'Distin\303\247\303\243o cl\303\241ssica de prova JLPT N3:\\n\342\200\242 \343\200\234\351\226\223: Ambas as a\303\247\303\265es ocorreram ininterruptamente durante todo o intervalo.\\n\342\200\242 \343\200\234\351\226\223\343\201\253: Uma a\303\247\303\243o moment\303\242nea aconteceu em algum instante dentro daquele intervalo.\',\n    keyRulePt: \'\342\200\242 Exemplo de \351\226\223 (cont\303\255nuo): \345\244\217\344\274\221\343\201\277\343\201\256\351\226\223\343\200\201\343\201\232\343\201\243\343\201\250\343\202\242\343\203\253\343\203\220\343\202\244\343\203\210\343\202\222\343\201\227\343\201\246\343\201\204\343\201\237 (Durante todas as f\303\251rias trabalhei).\\n\342\200\242 Exemplo de \351\226\223\343\201\253 (pontual): \347\225\231\345\256\210\343\201\256\351\226\223\343\201\253\343\200\201\350\215\267\347\211\251\343\201\214\345\261\212\343\201\204\343\201\237 (A encomenda chegou enquanto eu estava fora).\',\n    examples: [\n      {\n        jp: \'\345\255\220\344\276\233\343\201\214\345\257\235\343\201\246\343\201\204\343\202\213\351\226\223\343\201\253\343\200\201\345\256\266\344\272\213\343\202\222\346\270\210\343\201\276\343\201\233\343\201\276\343\201\227\343\201\237\343\200\202\',\n        reading: \'\343\201\223\343\201\251\343\202\202 \343\201\214 \343\201\255\343\201\246\343\201\204\343\202\213 \343\201\202\343\201\204\343\201\240 \343\201\253\343\200\201\343\201\213\343\201\230 \343\202\222 \343\201\231\343\201\276\343\201\233\343\201\276\343\201\227\343\201\237\343\200\202\',\n        romaji: \'Kodomo ga nete iru aida ni, kaji o sumasemashita.\',\n        meaningPt: \'Terminei os afazeres dom\303\251sticos enquanto a crian\303\247a estava dormindo.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n3_5\',\n    pattern: \'\343\200\234\343\201\212\343\201\213\343\201\222\343\201\247 (Positivo) vs \343\200\234\343\201\233\343\201\204\343\201\247 (Negativo)\',\n    titlePt: \'Causa e Efeito: \"Gra\303\247as a...\" vs \"Por culpa de...\"\',\n    jlpt: \'N3\',\n    category: \'Causa & Consequ\303\252ncia\',\n    formationFormula: \'[Forma Simples (Adj-NA+\343\201\252 / Substantivo+\343\201\256)] + \343\201\212\343\201\213\343\201\222\343\201\247 (resultado bom) / \343\201\233\343\201\204\343\201\247 (resultado ruim)\',\n    explanationPt: \'Ambas explicam o motivo de algo, por\303\251m com forte carga emocional do falante:\\n\342\200\242 \343\201\212\343\201\213\343\201\222\343\201\247: Expressa agradecimento pelo resultado pr\303\263spero ou positivo.\\n\342\200\242 \343\201\233\343\201\204\343\201\247: Atribui culpa ou responsabilidade por um rev\303\251s ou preju\303\255zo.\',\n    keyRulePt: \'Cuidado com o uso ir\303\264nico de \343\201\212\343\201\213\343\201\222\343\201\247 em alguns contextos conversacionais.\',\n    examples: [\n      {\n        jp: \'\345\205\210\347\224\237\343\201\256\343\201\212\343\201\213\343\201\222\343\201\247\343\200\201\350\251\246\351\250\223\343\201\253\345\220\210\346\240\274\343\201\247\343\201\215\343\201\276\343\201\227\343\201\237\343\200\202\',\n        reading: \'\343\201\233\343\202\223\343\201\233\343\201\204 \343\201\256 \343\201\212\343\201\213\343\201\222 \343\201\247\343\200\201\343\201\227\343\201\221\343\202\223 \343\201\253 \343\201\224\343\201\206\343\201\213\343\201\217 \343\201\247\343\201\215\343\201\276\343\201\227\343\201\237\343\200\202\',\n        romaji: \'Sensei no okage de, shiken ni goukaku dekimashita.\',\n        meaningPt: \'Gra\303\247as ao professor, consegui ser aprovado no exame.\'\n      },\n      {\n        jp: \'\345\244\247\351\233\250\343\201\256\343\201\233\343\201\204\343\201\247\343\200\201\351\233\273\350\273\212\343\201\214\351\201\205\343\202\214\343\201\276\343\201\227\343\201\237\343\200\202\',\n        reading: \'\343\201\212\343\201\212\343\201\202\343\202\201 \343\201\256 \343\201\233\343\201\204 \343\201\247\343\200\201\343\201\247\343\202\223\343\201\227\343\202\203 \343\201\214 \343\201\212\343\201\217\343\202\214\343\201\276\343\201\227\343\201\237\343\200\202\',\n        romaji: \'Ooame no sei de, densha ga okuremashita.\',\n        meaningPt: \'Por culpa da tempestade, o trem atrasou.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n3_6\',\n    pattern: \'\343\200\234\344\273\243\343\202\217\343\202\212\343\201\253 (~kawari ni)\',\n    titlePt: \'Substitui\303\247\303\243o & Compensa\303\247\303\243o: \"Em vez de / Em troca de\"\',\n    jlpt: \'N3\',\n    category: \'Troca & Substitui\303\247\303\243o\',\n    formationFormula: \'[Verbo na Forma Dicion\303\241rio / Substantivo+\343\201\256] + \344\273\243\343\202\217\343\202\212\343\201\253\',\n    explanationPt: \'Expressa que uma pessoa, coisa ou a\303\247\303\243o substituiu outra, ou que se oferece uma contrapartida como compensa\303\247\303\243o por um favor.\',\n    keyRulePt: \'Muito comum em acordos e trocas de trabalho ou fun\303\247\303\265es.\',\n    examples: [\n      {\n        jp: \'\350\213\261\350\252\236\343\202\222\346\225\231\343\201\210\343\201\246\343\202\202\343\202\211\343\201\206\344\273\243\343\202\217\343\202\212\343\201\253\343\200\201\346\227\245\346\234\254\350\252\236\343\202\222\346\225\231\343\201\210\343\201\276\343\201\231\343\200\202\',\n        reading: \'\343\201\210\343\201\204\343\201\224 \343\202\222 \343\201\212\343\201\227\343\201\210\343\201\246 \343\202\202\343\202\211\343\201\206 \343\201\213\343\202\217\343\202\212 \343\201\253\343\200\201\343\201\253\343\201\273\343\202\223\343\201\224 \343\202\222 \343\201\212\343\201\227\343\201\210\343\201\276\343\201\231\343\200\202\',\n        romaji: \'Eigo o oshiete morau kawari ni, nihongo o oshiemasu.\',\n        meaningPt: \'Em troca de voc\303\252 me ensinar ingl\303\252s, eu lhe ensino japon\303\252s.\'\n      },\n      {\n        jp: \'\347\227\205\346\260\227\343\201\256\351\203\250\351\225\267\343\201\256\344\273\243\343\202\217\343\202\212\343\201\253\343\200\201\347\247\201\343\201\214\344\274\232\350\255\260\343\201\253\345\207\272\345\270\255\343\201\227\343\201\276\343\201\231\343\200\202\',\n        reading: \'\343\201\263\343\202\207\343\201\206\343\201\215 \343\201\256 \343\201\266\343\201\241\343\202\207\343\201\206 \343\201\256 \343\201\213\343\202\217\343\202\212 \343\201\253\343\200\201\343\202\217\343\201\237\343\201\227 \343\201\214 \343\201\213\343\201\204\343\201\216 \343\201\253 \343\201\227\343\202\205\343\201\243\343\201\233\343\201\215 \343\201\227\343\201\276\343\201\231\343\200\202\',\n        romaji: \'Byouki no buchou no kawari ni, watashi ga kaigi ni shusseki shimasu.\',\n        meaningPt: \'No lugar do gerente que adoeceu, eu participarei da reuni\303\243o.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n3_7\',\n    pattern: \'\343\200\234\343\201\253\345\257\276\343\201\227\343\201\246 (~ni taishite)\',\n    titlePt: \'Contraste & Postura: \"Em contraste com / Em rela\303\247\303\243o a\"\',\n    jlpt: \'N3\',\n    category: \'Contraste & Alvo\',\n    formationFormula: \'[Substantivo] + \343\201\253\345\257\276\343\201\227\343\201\246 | [Forma Simples + \343\201\256] + \343\201\253\345\257\276\343\201\227\343\201\246\',\n    explanationPt: \'Tem dois usos principais: 1) Tra\303\247ar um contraste n\303\255tido entre duas pessoas ou situa\303\247\303\265es, 2) Indicar a postura ou atitude direcionada a um destinat\303\241rio.\',\n    keyRulePt: \'Para modificar um substantivo seguinte: \343\200\234\343\201\253\345\257\276\343\201\231\343\202\213 + [Substantivo] (ex: \343\201\212\345\256\242\346\247\230\343\201\253\345\257\276\343\201\231\343\202\213\346\205\213\345\272\246 - a atitude perante os clientes).\',\n    examples: [\n      {\n        jp: \'\345\205\204\343\201\214\345\244\226\344\272\244\347\232\204\343\201\252\343\201\256\343\201\253\345\257\276\343\201\227\343\201\246\343\200\201\345\274\237\343\201\257\343\201\250\343\201\246\343\202\202\345\206\205\346\260\227\343\201\247\343\201\231\343\200\202\',\n        reading: \'\343\201\202\343\201\253 \343\201\214 \343\201\214\343\201\204\343\201\223\343\201\206\343\201\246\343\201\215 \343\201\252 \343\201\256 \343\201\253 \343\201\237\343\201\204\343\201\227\343\201\246\343\200\201\343\201\212\343\201\250\343\201\206\343\201\250 \343\201\257 \343\201\250\343\201\246\343\202\202 \343\201\206\343\201\241\343\201\215 \343\201\247\343\201\231\343\200\202\',\n        romaji: \'Ani ga gaikouteki na no ni taishite, otouto wa totemo uchiki desu.\',\n        meaningPt: \'Enquanto o irm\303\243o mais velho \303\251 extrovertido, o mais novo \303\251 muito t\303\255mido.\'\n      },\n      {\n        jp: \'\343\201\212\345\256\242\346\247\230\343\201\253\345\257\276\343\201\227\343\201\246\343\200\201\343\201\204\343\201\244\343\202\202\344\270\201\345\257\247\343\201\252\350\250\200\350\221\211\343\202\222\344\275\277\343\201\204\343\201\276\343\201\231\343\200\202\',\n        reading: \'\343\201\212\343\201\215\343\202\203\343\201\217\343\201\225\343\201\276 \343\201\253 \343\201\237\343\201\204\343\201\227\343\201\246\343\200\201\343\201\204\343\201\244\343\202\202 \343\201\246\343\201\204\343\201\255\343\201\204\343\201\252 \343\201\223\343\201\250\343\201\260 \343\202\222 \343\201\244\343\201\213\343\201\204\343\201\276\343\201\231\343\200\202\',\n        romaji: \'Okyakusama ni taishite, itsumo teinei na kotoba o tsukai masu.\',\n        meaningPt: \'Sempre uso linguagem polida para com os clientes.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n3_8\',\n    pattern: \'\343\200\234\343\201\253\343\201\244\343\201\204\343\201\246 / \343\200\234\343\201\253\351\226\242\343\201\227\343\201\246 (~ni tsuite / ~ni kanshite)\',\n    titlePt: \'T\303\263pico de Discuss\303\243o: \"A respeito de / Relativo a...\"\',\n    jlpt: \'N3\',\n    category: \'Tema & Assunto\',\n    formationFormula: \'[Substantivo] + \343\201\253\343\201\244\343\201\204\343\201\246 / \343\201\253\351\226\242\343\201\227\343\201\246\',\n    explanationPt: \'Usado para introduzir o assunto, tema ou objeto de estudo, pesquisa ou debate. \343\201\253\351\226\242\343\201\227\343\201\246 \303\251 mais formal que \343\201\253\343\201\244\343\201\204\343\201\246.\',\n    keyRulePt: \'Para ligar a um substantivo: \343\200\234\343\201\253\343\201\244\343\201\204\343\201\246\343\201\256 + [Substantivo] ou \343\200\234\343\201\253\351\226\242\343\201\231\343\202\213 + [Substantivo].\',\n    examples: [\n      {\n        jp: \'\346\227\245\346\234\254\343\201\256\346\255\264\345\217\262\343\201\253\343\201\244\343\201\204\343\201\246\350\252\277\343\201\271\343\201\246\343\201\204\343\201\276\343\201\231\343\200\202\',\n        reading: \'\343\201\253\343\201\273\343\202\223 \343\201\256 \343\202\214\343\201\215\343\201\227 \343\201\253 \343\201\244\343\201\204\343\201\246 \343\201\227\343\202\211\343\201\271\343\201\246 \343\201\204\343\201\276\343\201\231\343\200\202\',\n        romaji: \'Nihon no rekishi ni tsuite shirabete imasu.\',\n        meaningPt: \'Estou pesquisando a respeito da hist\303\263ria do Jap\303\243o.\'\n      },\n      {\n        jp: \'\343\201\223\343\201\256\345\225\217\351\241\214\343\201\253\351\226\242\343\201\231\343\202\213\346\204\217\350\246\213\343\202\222\350\201\236\343\201\213\343\201\233\343\201\246\343\201\217\343\201\240\343\201\225\343\201\204\343\200\202\',\n        reading: \'\343\201\223\343\201\256 \343\202\202\343\202\223\343\201\240\343\201\204 \343\201\253 \343\201\213\343\202\223\343\201\231\343\202\213 \343\201\204\343\201\221\343\202\223 \343\202\222 \343\201\215\343\201\213\343\201\233\343\201\246 \343\201\217\343\201\240\343\201\225\343\201\204\343\200\202\',\n        romaji: \'Kono mondai ni kansuru iken o kikasete kudasai.\',\n        meaningPt: \'Por favor, deixe-me ouvir sua opini\303\243o relativa a esta quest\303\243o.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n3_9\',\n    pattern: \'\343\200\234\343\201\253\343\202\210\343\201\243\343\201\246 / \343\200\234\343\201\253\343\202\210\343\202\213 (~ni yotte / ~ni yoru)\',\n    titlePt: \'Meio, Causa, Autoria & Diversidade: \"Atrav\303\251s de / Dependendo de\"\',\n    jlpt: \'N3\',\n    category: \'Causa, Meio & Varia\303\247\303\243o\',\n    formationFormula: \'[Substantivo] + \343\201\253\343\202\210\343\201\243\343\201\246 / \343\201\253\343\202\210\343\202\213\343\201\250 / \343\201\253\343\202\210\343\202\213\',\n    explanationPt: \'Estrutura extremamente frequente no JLPT N3 com 4 facetas:\\n1) Meio ou m\303\251todo: \343\202\244\343\203\263\343\202\277\343\203\274\343\203\215\343\203\203\343\203\210\343\201\253\343\202\210\343\201\243\343\201\246 (atrav\303\251s da internet)\\n2) Causa: \345\234\260\351\234\207\343\201\253\343\202\210\343\201\243\343\201\246 (devido ao terremoto)\\n3) Varia\303\247\303\243o / Depend\303\252ncia: \344\272\272\343\201\253\343\202\210\343\201\243\343\201\246\351\201\225\343\201\206 (varia de pessoa para pessoa)\\n4) Autoria passiva: \343\202\267\343\202\247\343\202\244\343\202\257\343\202\271\343\203\224\343\202\242\343\201\253\343\202\210\343\201\243\343\201\246\346\233\270\343\201\213\343\202\214\343\201\237 (escrito por Shakespeare).\',\n    keyRulePt: \'Como modificador de substantivo vira \343\201\253\343\202\210\343\202\213 (ex: \345\217\260\351\242\250\343\201\253\343\202\210\343\202\213\350\242\253\345\256\263 = danos causados pelo tuf\303\243o).\',\n    examples: [\n      {\n        jp: \'\346\226\207\345\214\226\343\201\257\345\233\275\343\201\253\343\202\210\343\201\243\343\201\246\345\244\247\343\201\215\343\201\217\347\225\260\343\201\252\343\202\212\343\201\276\343\201\231\343\200\202\',\n        reading: \'\343\201\266\343\202\223\343\201\213 \343\201\257 \343\201\217\343\201\253 \343\201\253 \343\202\210\343\201\243\343\201\246 \343\201\212\343\201\212\343\201\215\343\201\217 \343\201\223\343\201\250\343\201\252\343\202\212\343\201\276\343\201\231\343\200\202\',\n        romaji: \'Bunka wa kuni ni yotte ookiku kotonarimasu.\',\n        meaningPt: \'A cultura varia grandemente dependendo do pa\303\255s.\'\n      },\n      {\n        jp: \'\343\201\223\343\201\256\347\265\265\343\201\257\346\234\211\345\220\215\343\201\252\347\224\273\345\256\266\343\201\253\343\202\210\343\201\243\343\201\246\346\217\217\343\201\213\343\202\214\343\201\276\343\201\227\343\201\237\343\200\202\',\n        reading: \'\343\201\223\343\201\256 \343\201\210 \343\201\257 \343\202\206\343\201\206\343\202\201\343\201\204\343\201\252 \343\201\214\343\201\213 \343\201\253 \343\202\210\343\201\243\343\201\246 \343\201\210\343\201\214\343\201\213\343\202\214\343\201\276\343\201\227\343\201\237\343\200\202\',\n        romaji: \'Kono e wa yuumei na gaka ni yotte egakaremashita.\',\n        meaningPt: \'Este quadro foi pintado por um pintor renomado.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n3_10\',\n    pattern: \'Verbo (Forma-TA) + \343\201\250\343\201\237\343\202\223 / \343\201\250\343\201\237\343\202\223\343\201\253 (~totan / totan ni)\',\n    titlePt: \'Sucess\303\243o Imediata: \"No exato instante em que... / Assim que\"\',\n    jlpt: \'N3\',\n    category: \'Tempo & Sucess\303\243o\',\n    formationFormula: \'[Verbo na forma-TA] + \343\201\250\343\201\237\343\202\223\343\201\253\',\n    explanationPt: \'Descreve que uma segunda a\303\247\303\243o ou acontecimento inesperado e surpreendente ocorreu no mesm\303\255ssimo segundo em que a primeira a\303\247\303\243o terminou.\',\n    keyRulePt: \'A ora\303\247\303\243o seguinte geralmente traz algo que surpreendeu o falante, n\303\243o podendo ser uma ordem ou voli\303\247\303\243o planejada.\',\n    examples: [\n      {\n        jp: \'\343\203\211\343\202\242\343\202\222\351\226\213\343\201\221\343\201\237\343\201\250\343\201\237\343\202\223\343\200\201\347\214\253\343\201\214\351\243\233\343\201\263\345\207\272\343\201\227\343\201\246\343\201\215\343\201\237\343\200\202\',\n        reading: \'\343\203\211\343\202\242 \343\202\222 \343\201\202\343\201\221\343\201\237 \343\201\250\343\201\237\343\202\223\343\200\201\343\201\255\343\201\223 \343\201\214 \343\201\250\343\201\263\343\201\240\343\201\227\343\201\246\343\201\215\343\201\237\343\200\202\',\n        romaji: \'Doa o aketa totan, neko ga tobidashite kita.\',\n        meaningPt: \'No exato instante em que abri a porta, um gato saltou para fora.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n3_11\',\n    pattern: \'Raiz MASU + \345\210\207\343\202\213 / \345\210\207\343\202\214\343\201\252\343\201\204 (~kiru / ~kirenai)\',\n    titlePt: \'Completude Extrema: \"Fazer tudo at\303\251 o fim / Esgotar totalmente\"\',\n    jlpt: \'N3\',\n    category: \'Completude & Limite\',\n    formationFormula: \'[Raiz do Verbo (sem \"masu\")] + \345\210\207\343\202\213 (kiru) / \345\210\207\343\202\214\343\201\252\343\201\204 (kirenai)\',\n    explanationPt: \'Expressa que uma a\303\247\303\243o foi executada at\303\251 a \303\272ltima gota, sem sobrar nada. Na negativa (~kirenai), indica que a quantidade \303\251 t\303\243o vasta que \303\251 imposs\303\255vel concluir tudo.\',\n    keyRulePt: \'\342\200\242 \344\275\277\343\201\204\345\210\207\343\202\213 (gastar tudo at\303\251 o \303\272ltimo centavo)\\n\342\200\242 \351\243\237\343\201\271\345\210\207\343\202\214\343\201\252\343\201\204 (tanta comida que n\303\243o cabe aguentar comer tudo)\\n\342\200\242 \347\226\262\343\202\214\345\210\207\343\201\243\343\201\237 (completamente exausto/esgotado).\',\n    examples: [\n      {\n        jp: \'\351\225\267\343\201\204\345\260\217\350\252\254\343\202\222\344\270\200\346\227\245\343\201\247\350\252\255\343\201\277\345\210\207\343\202\212\343\201\276\343\201\227\343\201\237\343\200\202\',\n        reading: \'\343\201\252\343\201\214\343\201\204 \343\201\227\343\202\207\343\201\206\343\201\233\343\201\244 \343\202\222 \343\201\204\343\201\241\343\201\253\343\201\241 \343\201\247 \343\202\210\343\201\277\343\201\215\343\202\212\343\201\276\343\201\227\343\201\237\343\200\202\',\n        romaji: \'Nagai shousetsu o ichinichi de yomikirimashita.\',\n        meaningPt: \'Li o longo romance at\303\251 o fim em apenas um dia.\'\n      },\n      {\n        jp: \'\346\226\231\347\220\206\343\201\214\345\244\232\343\201\231\343\201\216\343\201\246\343\200\201\343\201\250\343\201\246\343\202\202\351\243\237\343\201\271\345\210\207\343\202\214\343\201\276\343\201\233\343\202\223\343\200\202\',\n        reading: \'\343\202\212\343\202\207\343\201\206\343\202\212 \343\201\214 \343\201\212\343\201\212\343\201\231\343\201\216\343\201\246\343\200\201\343\201\250\343\201\246\343\202\202 \343\201\237\343\201\271\343\201\215\343\202\214\343\201\276\343\201\233\343\202\223\343\200\202\',\n        romaji: \'Ryouri ga oosugite, totemo tabekiremasen.\',\n        meaningPt: \'Tem comida demais, \303\251 imposs\303\255vel comer tudo.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n3_12\',\n    pattern: \'Raiz MASU + \343\201\213\343\201\221 / \343\201\213\343\201\221\343\202\213 (~kake / ~kakeru)\',\n    titlePt: \'A\303\247\303\243o Inacabada: \"No meio do caminho / Prestes a...\"\',\n    jlpt: \'N3\',\n    category: \'Aspecto & Interrup\303\247\303\243o\',\n    formationFormula: \'[Raiz do Verbo (sem \"masu\")] + \343\201\213\343\201\221\343\202\213 (forma verbal) / \343\201\213\343\201\221\343\201\256 [Substantivo] (como modificador)\',\n    explanationPt: \'Indica uma a\303\247\303\243o que come\303\247ou mas foi interrompida no meio, ficando incompleta.\',\n    keyRulePt: \'\342\200\242 \351\243\237\343\201\271\343\201\213\343\201\221\343\201\256\343\203\221\343\203\263 (p\303\243o que foi mordido/comido pela metade)\\n\342\200\242 \350\252\255\343\201\277\343\201\213\343\201\221\343\201\256\346\234\254 (livro que comecei a ler e ainda n\303\243o terminei).\',\n    examples: [\n      {\n        jp: \'\346\234\272\343\201\256\344\270\212\343\201\253\351\243\262\343\201\277\343\201\213\343\201\221\343\201\256\343\202\263\343\203\274\343\203\222\343\203\274\343\201\214\347\275\256\343\201\204\343\201\246\343\201\202\343\202\212\343\201\276\343\201\231\343\200\202\',\n        reading: \'\343\201\244\343\201\217\343\201\210 \343\201\256 \343\201\206\343\201\210 \343\201\253 \343\201\256\343\201\277\343\201\213\343\201\221 \343\201\256 \343\202\263\343\203\274\343\203\222\343\203\274 \343\201\214 \343\201\212\343\201\204\343\201\246 \343\201\202\343\202\212\343\201\276\343\201\231\343\200\202\',\n        romaji: \'Tsukue no ue ni nomikake no koohii ga oite arimasu.\',\n        meaningPt: \'Tem um caf\303\251 tomado pela metade em cima da mesa.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n3_13\',\n    pattern: \'Verbo (Forma Dicion\303\241rio / Substantivo) + \343\201\237\343\201\263\343\201\253 (~tabi ni)\',\n    titlePt: \'Frequ\303\252ncia Recorrente: \"Toda vez que... / Sempre que...\"\',\n    jlpt: \'N3\',\n    category: \'Repeti\303\247\303\243o & Regularidade\',\n    formationFormula: \'[Verbo na Forma Dicion\303\241rio] + \343\201\237\343\201\263\343\201\253 | [Substantivo] + \343\201\256 + \343\201\237\343\201\263\343\201\253\',\n    explanationPt: \'Expressa que invariavelmente, sempre que a a\303\247\303\243o A ocorre, o resultado B tamb\303\251m acontece ao mesmo tempo.\',\n    keyRulePt: \'N\303\243o \303\251 usado para fatos cotidianos \303\263bvios (como \"toda vez que acordo\"), mas para eventos que despertam sentimentos ou consequ\303\252ncias marcantes.\',\n    examples: [\n      {\n        jp: \'\343\201\223\343\201\256\345\206\231\347\234\237\343\202\222\350\246\213\343\202\213\343\201\237\343\201\263\343\201\253\343\200\201\346\225\205\351\203\267\343\201\256\345\256\266\346\227\217\343\202\222\346\200\235\343\201\204\345\207\272\343\201\227\343\201\276\343\201\231\343\200\202\',\n        reading: \'\343\201\223\343\201\256 \343\201\227\343\202\203\343\201\227\343\202\223 \343\202\222 \343\201\277\343\202\213 \343\201\237\343\201\263 \343\201\253\343\200\201\343\201\265\343\202\213\343\201\225\343\201\250 \343\201\256 \343\201\213\343\201\236\343\201\217 \343\202\222 \343\201\212\343\202\202\343\201\204\343\201\240\343\201\227\343\201\276\343\201\231\343\200\202\',\n        romaji: \'Kono shashin o miru tabi ni, furusato no kazoku o omoidashimasu.\',\n        meaningPt: \'Toda vez que vejo esta fotografia, lembro-me da minha fam\303\255lia na minha terra natal.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n3_14\',\n    pattern: \'\343\200\234\343\202\222\343\201\257\343\201\230\343\202\201 / \343\200\234\343\202\222\343\201\257\343\201\230\343\202\201\343\201\250\343\201\231\343\202\213 (~o hajime)\',\n    titlePt: \'Representante Principal: \"A come\303\247ar por... / Principalmente...\"\',\n    jlpt: \'N3\',\n    category: \'Exemplifica\303\247\303\243o Formal\',\n    formationFormula: \'[Substantivo] + \343\202\222\343\201\257\343\201\230\343\202\201 / \343\202\222\343\201\257\343\201\230\343\202\201\343\201\250\343\201\227\343\201\246 / \343\202\222\343\201\257\343\201\230\343\202\201\343\201\250\343\201\231\343\202\213 [Substantivo]\',\n    explanationPt: \'Apresenta o exemplo mais not\303\241vel ou representativo de um grupo maior para introduzir todos os demais.\',\n    keyRulePt: \'Estrutura formal comum em apresenta\303\247\303\265es, discursos e reda\303\247\303\265es acad\303\252micas.\',\n    examples: [\n      {\n        jp: \'\345\257\214\345\243\253\345\261\261\343\202\222\343\201\257\343\201\230\343\202\201\343\200\201\346\227\245\346\234\254\343\201\253\343\201\257\347\276\216\343\201\227\343\201\204\345\261\261\343\201\214\343\201\237\343\201\217\343\201\225\343\202\223\343\201\202\343\202\212\343\201\276\343\201\231\343\200\202\',\n        reading: \'\343\201\265\343\201\230\343\201\225\343\202\223 \343\202\222 \343\201\257\343\201\230\343\202\201\343\200\201\343\201\253\343\201\273\343\202\223 \343\201\253 \343\201\257 \343\201\206\343\201\244\343\201\217\343\201\227\343\201\204 \343\202\204\343\201\276 \343\201\214 \343\201\237\343\201\217\343\201\225\343\202\223 \343\201\202\343\202\212\343\201\276\343\201\231\343\200\202\',\n        romaji: \'Fujisan o hajime, nihon ni wa utsukushii yama ga takusan arimasu.\',\n        meaningPt: \'A come\303\247ar pelo Monte Fuji, o Jap\303\243o possui muitas montanhas bel\303\255ssimas.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n3_15\',\n    pattern: \'\343\200\234\343\201\225\343\201\210 (~sae)\',\n    titlePt: \'\303\212nfase Extrema: \"At\303\251 mesmo... / Nem sequer...\"\',\n    jlpt: \'N3\',\n    category: \'\303\212nfase & Extremos\',\n    formationFormula: \'[Substantivo] + (\343\201\247)\343\201\225\343\201\210 | [Forma Condicional] + \343\201\225\343\201\210 + \343\201\231\343\202\214\343\201\260 (contanto que apenas fa\303\247a)\',\n    explanationPt: \'1) Cita o caso mais evidente ou b\303\241sico para sugerir que o resto \303\251 ainda mais \303\263bvio (\"at\303\251 mesmo uma crian\303\247a saberia\"). 2) Em combina\303\247\303\243o com condicional (\343\200\234\343\201\225\343\201\210\343\200\234\343\201\260), significa \"bastando apenas que...\".\',\n    keyRulePt: \'\342\200\242 \343\201\262\343\202\211\343\201\214\343\201\252\343\201\225\343\201\210\350\252\255\343\202\201\343\201\252\343\201\204 (N\303\243o sabe ler nem sequer hiragana).\\n\342\200\242 \350\226\254\343\202\222\351\243\262\343\201\277\343\201\225\343\201\210\343\201\231\343\202\214\343\201\260\346\262\273\343\202\212\343\201\276\343\201\231 (Basta tomar o rem\303\251dio que voc\303\252 se cura).\',\n    examples: [\n      {\n        jp: \'\343\201\223\343\201\256\346\274\242\345\255\227\343\201\257\345\255\220\344\276\233\343\201\247\343\201\225\343\201\210\350\252\255\343\202\201\343\201\276\343\201\231\343\200\202\',\n        reading: \'\343\201\223\343\201\256 \343\201\213\343\202\223\343\201\230 \343\201\257 \343\201\223\343\201\251\343\202\202 \343\201\247\343\201\225\343\201\210 \343\202\210\343\202\201\343\201\276\343\201\231\343\200\202\',\n        romaji: \'Kono kanji wa kodomo desae yomemasu.\',\n        meaningPt: \'At\303\251 mesmo crian\303\247as conseguem ler este kanji.\'\n      },\n      {\n        jp: \'\345\201\245\345\272\267\343\201\247\343\201\225\343\201\210\343\201\202\343\202\214\343\201\260\343\200\201\344\275\225\343\201\247\343\202\202\343\201\247\343\201\215\343\201\276\343\201\231\343\200\202\',\n        reading: \'\343\201\221\343\202\223\343\201\223\343\201\206 \343\201\247\343\201\225\343\201\210 \343\201\202\343\202\214\343\201\260\343\200\201\343\201\252\343\202\223\343\201\247\343\202\202 \343\201\247\343\201\215\343\201\276\343\201\231\343\200\202\',\n        romaji: \'Kenkou desae areba, nan demo dekimasu.\',\n        meaningPt: \'Contanto que voc\303\252 tenha sa\303\272de, voc\303\252 pode fazer qualquer coisa.\'\n      }\n    ]\n  }\n];\n"
    }
