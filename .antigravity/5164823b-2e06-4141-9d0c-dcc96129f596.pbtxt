        lines {
          text: "    keyRulePt: \'Conjuga\303\247\303\265es do \343\201\237\343\201\204 (comporta-se como um Adjetivo-I):\\n\342\200\242 Afirmativo: \351\243\237\343\201\271\343\201\237\343\201\204 (quero comer)\\n\342\200\242 Negativo: \351\243\237\343\201\271\343\201\237\343\201\217\343\201\252\343\201\204 (n\303\243o quero comer)\\n\342\200\242 Passado: \351\243\237\343\201\271\343\201\237\343\201\213\343\201\243\343\201\237 (quis comer)\\n\342\200\242 Passado Negativo: \351\243\237\343\201\271\343\201\237\343\201\217\343\201\252\343\201\213\343\201\243\343\201\237 (n\303\243o quis comer)\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
