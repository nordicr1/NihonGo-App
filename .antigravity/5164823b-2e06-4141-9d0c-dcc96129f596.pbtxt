  file_change {
    absolute_path_uri: "file:///src/data/grammarN2N1.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { GrammarItem } from \'../types\';\n\nexport const GRAMMAR_N2_N1: GrammarItem[] = [\n  // ===================== N2 GRAMMAR =====================\n  {\n    id: \'g_n2_1\',\n    pattern: \'\343\200\234\343\201\253\351\201\225\343\201\204\343\201\252\343\201\204 (~ni chigainai)\',\n    titlePt: \'Certeza e Convic\303\247\303\243o: \"Com certeza \303\251 / Sem d\303\272vidas\"\',\n    jlpt: \'N2\',\n    category: \'Certeza & Dedu\303\247\303\243o\',\n    formationFormula: \'[Forma Simples (Verbo / Adj / Substantivo direto)] + \343\201\253\351\201\225\343\201\204\343\201\252\343\201\204\',\n    explanationPt: \'Expressa forte convic\303\247\303\243o do falante baseada em evid\303\252ncias s\303\263lidas ou racioc\303\255nio l\303\263gico claro (\"n\303\243o pode ser de outro jeito\").\',\n    keyRulePt: \'Frequentemente usado com adv\303\251rbios de certeza como \343\201\215\343\201\243\343\201\250 (kitto) ou \343\201\213\343\201\252\343\202\211\343\201\232 (kanarazu).\',\n    examples: [\n      {\n        jp: \'\345\275\274\343\201\257\346\257\216\346\227\245\345\244\234\351\201\205\343\201\217\343\201\276\343\201\247\345\213\211\345\274\267\343\201\227\343\201\246\343\201\204\343\201\237\343\201\213\343\202\211\343\200\201\345\220\210\346\240\274\343\201\231\343\202\213\343\201\253\351\201\225\343\201\204\343\201\252\343\201\204\343\200\202\',\n        reading: \'\343\201\213\343\202\214 \343\201\257 \343\201\276\343\201\204\343\201\253\343\201\241 \343\202\210\343\202\213\343\201\212\343\201\235\343\201\217 \343\201\276\343\201\247 \343\201\271\343\202\223\343\201\215\343\202\207\343\201\206 \343\201\227\343\201\246\343\201\204\343\201\237 \343\201\213\343\202\211\343\200\201\343\201\224\343\201\206\343\201\213\343\201\217 \343\201\231\343\202\213 \343\201\253 \343\201\241\343\201\214\343\201\204\343\201\252\343\201\204\343\200\202\',\n        romaji: \'Kare wa mainichi yoru osoku made benkyou shite ita kara, goukaku suru ni chigainai.\',\n        meaningPt: \'Como ele estudava at\303\251 tarde da noite todo dia, com certeza passar\303\241 no exame.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n2_2\',\n    pattern: \'\343\200\234\343\201\253\345\237\272\343\201\245\343\201\204\343\201\246 (~ni motozuite)\',\n    titlePt: \'Fundamenta\303\247\303\243o: \"Com base em / Fundamentado em\"\',\n    jlpt: \'N2\',\n    category: \'Crit\303\251rio & Base\',\n    formationFormula: \'[Substantivo] + \343\201\253\345\237\272\343\201\245\343\201\204\343\201\246 / \343\201\253\345\237\272\343\201\245\343\201\217 [Substantivo]\',\n    explanationPt: \'Indica que uma a\303\247\303\243o, plano, decis\303\243o ou obra foi criada tendo dados, fatos, leis ou pesquisas como alicerce fundamental.\',\n    keyRulePt: \'Como modificador de substantivo posterior usa-se \343\201\253\345\237\272\343\201\245\343\201\217 (ex: \344\272\213\345\256\237\343\201\253\345\237\272\343\201\245\343\201\217\346\230\240\347\224\273 = filme baseado em fatos reais).\',\n    examples: [\n      {\n        jp: \'\343\202\242\343\203\263\343\202\261\343\203\274\343\203\210\350\252\277\346\237\273\343\201\256\347\265\220\346\236\234\343\201\253\345\237\272\343\201\245\343\201\204\343\201\246\343\200\201\346\226\260\345\225\206\345\223\201\343\202\222\351\226\213\347\231\272\343\201\227\343\201\276\343\201\227\343\201\237\343\200\202\',\n        reading: \'\343\202\242\343\203\263\343\202\261\343\203\274\343\203\210 \343\201\241\343\202\207\343\201\206\343\201\225 \343\201\256 \343\201\221\343\201\243\343\201\213 \343\201\253 \343\202\202\343\201\250\343\201\245\343\201\204\343\201\246\343\200\201\343\201\227\343\202\223\343\201\227\343\202\207\343\201\206\343\201\262\343\202\223 \343\202\222 \343\201\213\343\201\204\343\201\257\343\201\244 \343\201\227\343\201\276\343\201\227\343\201\237\343\200\202\',\n        romaji: \'Ankeeto chousa no kekka ni motozuite, shinshouhin o kaihatsu shimashita.\',\n        meaningPt: \'Desenvolvemos o novo produto com base nos resultados da pesquisa de question\303\241rio.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n2_3\',\n    pattern: \'\343\200\234\343\201\253\343\201\227\343\201\237\343\201\214\343\201\243\343\201\246 / \343\200\234\343\201\253\343\201\244\343\202\214\343\201\246 (~ni shitagatte / ~ni tsurete)\',\n    titlePt: \'Propor\303\247\303\243o e Acompanhamento: \"\303\200 medida que... / Conforme...\"\',\n    jlpt: \'N2\',\n    category: \'Propor\303\247\303\243o & Mudan\303\247a\',\n    formationFormula: \'[Verbo Forma Dicion\303\241rio / Substantivo de a\303\247\303\243o] + \343\201\253\343\201\227\343\201\237\343\201\214\343\201\243\343\201\246 / \343\201\253\343\201\244\343\202\214\343\201\246\',\n    explanationPt: \'Descreve que \303\240 medida que uma mudan\303\247a avan\303\247a em A, uma transforma\303\247\303\243o correspondente ocorre em B de forma cont\303\255nua e natural.\',\n    keyRulePt: \'\343\201\253\343\201\244\343\202\214\343\201\246 foca na evolu\303\247\303\243o natural com o tempo; \343\201\253\343\201\227\343\201\237\343\201\214\343\201\243\343\201\246 pode ser usado tamb\303\251m para seguir regras ou ordens.\',\n    examples: [\n      {\n        jp: \'\346\250\231\351\253\230\343\201\214\351\253\230\343\201\217\343\201\252\343\202\213\343\201\253\343\201\227\343\201\237\343\201\214\343\201\243\343\201\246\343\200\201\346\260\227\346\270\251\343\201\214\344\270\213\343\201\214\343\202\212\343\201\276\343\201\231\343\200\202\',\n        reading: \'\343\201\262\343\202\207\343\201\206\343\201\223\343\201\206 \343\201\214 \343\201\237\343\201\213\343\201\217 \343\201\252\343\202\213 \343\201\253 \343\201\227\343\201\237\343\201\214\343\201\243\343\201\246\343\200\201\343\201\215\343\201\212\343\202\223 \343\201\214 \343\201\225\343\201\214\343\202\212\343\201\276\343\201\231\343\200\202\',\n        romaji: \'Hyoukou ga takaku naru ni shitagatte, kion ga sagarimasu.\',\n        meaningPt: \'\303\200 medida que a altitude aumenta, a temperatura cai.\'\n      },\n      {\n        jp: \'\345\217\260\351\242\250\343\201\214\350\277\221\343\201\245\343\201\217\343\201\253\343\201\244\343\202\214\343\201\246\343\200\201\351\242\250\351\233\250\343\201\214\345\274\267\343\201\217\343\201\252\343\201\243\343\201\246\343\201\215\343\201\237\343\200\202\',\n        reading: \'\343\201\237\343\201\204\343\201\265\343\201\206 \343\201\214 \343\201\241\343\201\213\343\201\245\343\201\217 \343\201\253 \343\201\244\343\202\214\343\201\246\343\200\201\343\201\265\343\201\206\343\201\206 \343\201\214 \343\201\244\343\202\210\343\201\217 \343\201\252\343\201\243\343\201\246\343\201\215\343\201\237\343\200\202\',\n        romaji: \'Taifuu ga chikazuku ni tsurete, fuuu ga tsuyoku natte kita.\',\n        meaningPt: \'Conforme o tuf\303\243o se aproximava, o vento e a chuva foram ficando mais intensos.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n2_4\',\n    pattern: \'\343\200\234\343\202\217\343\201\221\343\201\253\343\201\257\343\201\204\343\201\213\343\201\252\343\201\204 (~wake ni wa ikanai)\',\n    titlePt: \'Impossibilidade Moral/Social: \"N\303\243o posso me dar ao luxo de...\"\',\n    jlpt: \'N2\',\n    category: \'Dever & Restri\303\247\303\243o Social\',\n    formationFormula: \'[Verbo Forma Dicion\303\241rio] + \343\202\217\343\201\221\343\201\253\343\201\257\343\201\204\343\201\213\343\201\252\343\201\204 (N\303\243o posso fazer) / [Verbo Forma Nai] + \343\201\252\343\201\204\343\202\217\343\201\221\343\201\253\343\201\257\343\201\204\343\201\213\343\201\252\343\201\204 (N\303\243o posso deixar de fazer = sou obrigado a fazer)\',\n    explanationPt: \'Indica que, por motivos \303\251ticos, de dever profissional ou considera\303\247\303\243o social, a pessoa n\303\243o pode realizar determinada a\303\247\303\243o, embora fisicamente fosse poss\303\255vel.\',\n    keyRulePt: \'Diferente de \343\201\247\343\201\215\343\201\252\343\201\204 (habilidade f\303\255sica), aqui o motivo \303\251 bom senso, responsabilidade ou vergonha.\',\n    examples: [\n      {\n        jp: \'\346\230\216\346\227\245\343\201\257\345\244\247\344\272\213\343\201\252\344\274\232\350\255\260\343\201\214\343\201\202\343\202\213\343\201\213\343\202\211\343\200\201\344\274\221\343\202\200\343\202\217\343\201\221\343\201\253\343\201\257\343\201\204\343\201\213\343\201\252\343\201\204\343\200\202\',\n        reading: \'\343\201\202\343\201\227\343\201\237 \343\201\257 \343\201\240\343\201\204\343\201\230 \343\201\252 \343\201\213\343\201\204\343\201\216 \343\201\214 \343\201\202\343\202\213 \343\201\213\343\202\211\343\200\201\343\202\204\343\201\231\343\202\200 \343\202\217\343\201\221 \343\201\253 \343\201\257 \343\201\204\343\201\213\343\201\252\343\201\204\343\200\202\',\n        romaji: \'Ashita wa daiji na kaigi ga aru kara, yasumu wake ni wa ikanai.\',\n        meaningPt: \'Como amanh\303\243 tem uma reuni\303\243o importante, n\303\243o posso simplesmente faltar.\'\n      },\n      {\n        jp: \'\343\201\212\344\270\226\350\251\261\343\201\253\343\201\252\343\201\243\343\201\237\345\205\210\347\224\237\343\201\256\351\240\274\343\201\277\343\201\240\343\201\213\343\202\211\343\200\201\345\274\225\343\201\215\345\217\227\343\201\221\343\201\252\343\201\204\343\202\217\343\201\221\343\201\253\343\201\257\343\201\204\343\201\213\343\201\252\343\201\204\343\200\202\',\n        reading: \'\343\201\212\343\201\233\343\202\217 \343\201\253 \343\201\252\343\201\243\343\201\237 \343\201\233\343\202\223\343\201\233\343\201\204 \343\201\256 \343\201\237\343\201\256\343\201\277 \343\201\240\343\201\213\343\202\211\343\200\201\343\201\262\343\201\215\343\201\206\343\201\221\343\201\252\343\201\204 \343\202\217\343\201\221 \343\201\253 \343\201\257 \343\201\204\343\201\213\343\201\252\343\201\204\343\200\202\',\n        romaji: \'Osewa ni natta sensei no tanomi dakara, hikiukenai wake ni wa ikanai.\',\n        meaningPt: \'Por ser um pedido do professor que tanto me ajudou, n\303\243o posso deixar de aceitar.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n2_5\',\n    pattern: \'\343\200\234\343\201\253\343\201\231\343\201\216\343\201\252\343\201\204 (~ni suginai)\',\n    titlePt: \'Limita\303\247\303\243o e Mod\303\251stia: \"N\303\243o passa de... / Apenas...\"\',\n    jlpt: \'N2\',\n    category: \'Limita\303\247\303\243o & \303\212nfase\',\n    formationFormula: \'[Forma Simples (Verbo / Adj / Substantivo)] + \343\201\253\343\201\231\343\201\216\343\201\252\343\201\204\',\n    explanationPt: \'Enfatiza que algo n\303\243o ultrapassa certo limite pequeno, insignificante ou simples (\"n\303\243o \303\251 mais do que isso\").\',\n    keyRulePt: \'Usado frequentemente para minimizar algo ou enfatizar uma realidade modesta.\',\n    examples: [\n      {\n        jp: \'\347\247\201\343\201\257\345\215\230\343\201\252\343\202\213\344\270\200\347\244\276\345\223\241\343\201\253\343\201\231\343\201\216\343\201\276\343\201\233\343\202\223\343\200\202\346\261\272\345\256\232\346\250\251\343\201\257\343\201\202\343\202\212\343\201\276\343\201\233\343\202\223\343\200\202\',\n        reading: \'\343\202\217\343\201\237\343\201\227 \343\201\257 \343\201\237\343\202\223\343\201\252\343\202\213 \343\201\204\343\201\243 \343\201\227\343\202\203\343\201\204\343\202\223 \343\201\253 \343\201\231\343\201\216\343\201\276\343\201\233\343\202\223\343\200\202\343\201\221\343\201\243\343\201\246\343\201\204\343\201\221\343\202\223 \343\201\257 \343\201\202\343\202\212\343\201\276\343\201\233\343\202\223\343\200\202\',\n        romaji: \'Watashi wa tannaru isshain ni sugimasen. Ketteiken wa arimasen.\',\n        meaningPt: \'Eu n\303\243o passo de um simples funcion\303\241rio. N\303\243o tenho poder de decis\303\243o.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n2_6\',\n    pattern: \'\343\200\234\343\201\253\343\201\273\343\201\213\343\201\252\343\202\211\343\201\252\343\201\204 (~ni hokanaranai)\',\n    titlePt: \'Certeza Enf\303\241tica: \"N\303\243o \303\251 nada mais nada menos que...\"\',\n    jlpt: \'N2\',\n    category: \'Causa & Convic\303\247\303\243o Absoluta\',\n    formationFormula: \'[Substantivo] + (\343\201\213\343\202\211 / \343\201\237\343\202\201) + \343\201\253\343\201\273\343\201\213\343\201\252\343\202\211\343\201\252\343\201\204\',\n    explanationPt: \'Expressa com veem\303\252ncia que aquela \303\251 a \303\232NICA e verdadeira raz\303\243o ou natureza de um fato.\',\n    keyRulePt: \'Tom formal e assertivo, comum em disserta\303\247\303\265es e discursos formais.\',\n    examples: [\n      {\n        jp: \'\345\275\274\343\201\256\346\210\220\345\212\237\343\201\257\343\200\201\351\225\267\345\271\264\343\201\256\345\212\252\345\212\233\343\201\256\347\265\220\346\236\234\343\201\253\343\201\273\343\201\213\343\201\252\343\202\211\343\201\252\343\201\204\343\200\202\',\n        reading: \'\343\201\213\343\202\214 \343\201\256 \343\201\233\343\201\204\343\201\223\343\201\206 \343\201\257\343\200\201\343\201\252\343\201\214\343\201\255\343\202\223 \343\201\256 \343\201\251\343\202\212\343\202\207\343\201\217 \343\201\256 \343\201\221\343\201\243\343\201\213 \343\201\253 \343\201\273\343\201\213\343\201\252\343\202\211\343\201\252\343\201\204\343\200\202\',\n        romaji: \'Kare no seikou wa, naganen no doryoku no kekka ni hokanaranai.\',\n        meaningPt: \'O sucesso dele nada mais \303\251 do que o resultado de longos anos de esfor\303\247o.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n2_7\',\n    pattern: \'\343\200\234\343\201\226\343\202\213\343\202\222\345\276\227\343\201\252\343\201\204 (~zaru o enai)\',\n    titlePt: \'Inescapabilidade: \"Sou for\303\247ado a / N\303\243o tenho outra escolha sen\303\243o...\"\',\n    jlpt: \'N2\',\n    category: \'Obriga\303\247\303\243o Inevit\303\241vel\',\n    formationFormula: \'[Verbo Forma Nai sem \343\201\252\343\201\204] + \343\201\226\343\202\213\343\202\222\345\276\227\343\201\252\343\201\204 (exce\303\247\303\243o: \343\201\231\343\202\213 \342\236\224 \343\201\233\343\201\226\343\202\213\343\202\222\345\276\227\343\201\252\343\201\204)\',\n    explanationPt: \'Significa que, contra a sua pr\303\263pria vontade ou prefer\303\252ncia pessoal, as circunst\303\242ncias o for\303\247am inevitavelmente a tomar tal atitude.\',\n    keyRulePt: \'Aten\303\247\303\243o especial \303\240 irregularidade do verbo \343\201\231\343\202\213: vira \343\201\233\343\201\226\343\202\213\343\202\222\345\276\227\343\201\252\343\201\204 (sezaru o enai).\',\n    examples: [\n      {\n        jp: \'\350\250\274\346\213\240\343\201\214\343\201\223\343\202\214\343\201\240\343\201\221\346\217\203\343\201\243\343\201\246\343\201\204\343\202\214\343\201\260\343\200\201\345\275\274\343\201\256\344\270\273\345\274\265\343\202\222\350\252\215\343\202\201\343\201\226\343\202\213\343\202\222\345\276\227\343\201\252\343\201\204\343\200\202\',\n        reading: \'\343\201\227\343\202\207\343\201\206\343\201\223 \343\201\214 \343\201\223\343\202\214\343\201\240\343\201\221 \343\201\235\343\202\215\343\201\243\343\201\246\343\201\204\343\202\214\343\201\260\343\200\201\343\201\213\343\202\214 \343\201\256 \343\201\227\343\202\205\343\201\241\343\202\207\343\201\206 \343\202\222 \343\201\277\343\201\250\343\202\201\343\201\226\343\202\213 \343\202\222 \343\201\210\343\201\252\343\201\204\343\200\202\',\n        romaji: \'Shouko ga koredake sorotte ireba, kare no shuchou o mitomezaru o enai.\',\n        meaningPt: \'Com tantas evid\303\252ncias reunidas, n\303\243o temos outra escolha sen\303\243o aceitar a alega\303\247\303\243o dele.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n2_8\',\n    pattern: \'\343\200\234\343\202\222\351\200\232\343\201\230\343\201\246 / \343\200\234\343\202\222\351\200\232\343\201\227\343\201\246 (~o tsuujite / ~o tooshite)\',\n    titlePt: \'Intermedia\303\247\303\243o e Dura\303\247\303\243o: \"Por meio de / Ao longo de todo o...\"\',\n    jlpt: \'N2\',\n    category: \'Meio & Per\303\255odo Cont\303\255nuo\',\n    formationFormula: \'[Substantivo] + \343\202\222\351\200\232\343\201\230\343\201\246 / \343\202\222\351\200\232\343\201\227\343\201\246\',\n    explanationPt: \'Tem dois sentidos principais: 1) Utilizar algu\303\251m ou um canal como mediador; 2) Um estado cont\303\255nuo durante todo o per\303\255odo (ex: ao longo do ano).\',\n    keyRulePt: \'Quando significa \"per\303\255odo inteiro\", \303\251 comum com \345\233\233\345\255\243 (quatro esta\303\247\303\265es), \344\270\200\345\271\264 (o ano todo).\',\n    examples: [\n      {\n        jp: \'\345\217\213\344\272\272\343\201\256\347\264\271\344\273\213\343\202\222\351\200\232\343\201\230\343\201\246\343\200\201\347\217\276\345\234\250\343\201\256\345\246\273\343\201\250\347\237\245\343\202\212\345\220\210\343\201\204\343\201\276\343\201\227\343\201\237\343\200\202\',\n        reading: \'\343\202\206\343\201\206\343\201\230\343\202\223 \343\201\256 \343\201\227\343\202\207\343\201\206\343\201\213\343\201\204 \343\202\222 \343\201\244\343\201\206\343\201\230\343\201\246\343\200\201\343\201\222\343\202\223\343\201\226\343\201\204 \343\201\256 \343\201\244\343\201\276 \343\201\250 \343\201\227\343\202\212\343\201\202\343\201\204\343\201\276\343\201\227\343\201\237\343\200\202\',\n        romaji: \'Yuujin no shoukai o tsuujite, genzai no tsuma to shiriai mashita.\',\n        meaningPt: \'Conheci minha atual esposa por interm\303\251dio da apresenta\303\247\303\243o de um amigo.\'\n      },\n      {\n        jp: \'\343\201\223\343\201\256\345\234\260\345\237\237\343\201\257\344\270\200\345\271\264\343\202\222\351\200\232\343\201\230\343\201\246\346\270\251\346\232\226\343\201\252\346\260\227\345\200\231\343\201\247\343\201\231\343\200\202\',\n        reading: \'\343\201\223\343\201\256 \343\201\241\343\201\204\343\201\215 \343\201\257 \343\201\204\343\201\241\343\201\255\343\202\223 \343\202\222 \343\201\244\343\201\206\343\201\230\343\201\246 \343\201\212\343\202\223\343\201\240\343\202\223\343\201\252 \343\201\215\343\201\223\343\201\206 \343\201\247\343\201\231\343\200\202\',\n        romaji: \'Kono chiiki wa ichinen o tsuujite ondanna kikou desu.\',\n        meaningPt: \'Esta regi\303\243o desfruta de um clima ameno ao longo de todo o ano.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n2_9\',\n    pattern: \'\343\200\234\343\201\222 (~ge)\',\n    titlePt: \'Apar\303\252ncia Emocional: \"Com ar de... / Parecendo...\"\',\n    jlpt: \'N2\',\n    category: \'Impress\303\243o & Nuance\',\n    formationFormula: \'[Raiz do Adj-I (sem \343\201\204) / Adj-NA] + \343\201\222 (ex: \345\254\211\343\201\227\343\201\222, \345\257\202\343\201\227\343\201\222, \350\207\252\344\277\241\343\201\202\343\202\212\343\201\222)\',\n    explanationPt: \'Expressa a sensa\303\247\303\243o visual de que algu\303\251m parece estar sentindo determinada emo\303\247\303\243o ou condi\303\247\303\243o psicol\303\263gica.\',\n    keyRulePt: \'Usado para observar os sentimentos de terceiros.\',\n    examples: [\n      {\n        jp: \'\345\275\274\345\245\263\343\201\257\345\257\202\343\201\227\343\201\222\343\201\252\350\241\250\346\203\205\343\201\247\351\201\240\343\201\217\343\202\222\350\246\213\343\201\244\343\202\201\343\201\246\343\201\204\343\201\237\343\200\202\',\n        reading: \'\343\201\213\343\201\256\343\201\230\343\202\207 \343\201\257 \343\201\225\343\201\263\343\201\227\343\201\222 \343\201\252 \343\201\262\343\202\207\343\201\206\343\201\230\343\202\207\343\201\206 \343\201\247 \343\201\250\343\201\212\343\201\217 \343\202\222 \343\201\277\343\201\244\343\202\201\343\201\246 \343\201\204\343\201\237\343\200\202\',\n        romaji: \'Kanojo wa sabishige na hyoujou de tooku o mitsumete ita.\',\n        meaningPt: \'Ela olhava para longe com uma express\303\243o visivelmente melanc\303\263lica.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n2_10\',\n    pattern: \'\343\200\234\343\201\244\343\201\244\343\201\202\343\202\213 (~tsutsu aru)\',\n    titlePt: \'Transforma\303\247\303\243o Cont\303\255nua: \"Estar em pleno processo de...\"\',\n    jlpt: \'N2\',\n    category: \'Mudan\303\247a em Andamento\',\n    formationFormula: \'[Raiz do Verbo (Forma Masu sem \343\201\276\343\201\231)] + \343\201\244\343\201\244\343\201\202\343\202\213\',\n    explanationPt: \'Indica uma mudan\303\247a cont\303\255nua e gradual que est\303\241 em pleno andamento rumo a uma nova dire\303\247\303\243o.\',\n    keyRulePt: \'Estilo formal, muito comum em not\303\255cias de economia, clima e relat\303\263rios.\',\n    examples: [\n      {\n        jp: \'\346\231\257\346\260\227\343\201\257\345\260\221\343\201\227\343\201\232\343\201\244\345\233\236\345\276\251\343\201\227\343\201\244\343\201\244\343\201\202\343\202\213\343\200\202\',\n        reading: \'\343\201\221\343\201\204\343\201\215 \343\201\257 \343\201\231\343\201\223\343\201\227\343\201\232\343\201\244 \343\201\213\343\201\204\343\201\265\343\201\217 \343\201\227\343\201\244\343\201\244\343\201\202\343\202\213\343\200\202\',\n        romaji: \'Keiki wa sukoshizutsu kaifuku shitsutsu aru.\',\n        meaningPt: \'A economia est\303\241 se recuperando gradativamente.\'\n      }\n    ]\n  },\n\n  // ===================== N1 GRAMMAR =====================\n  {\n    id: \'g_n1_1\',\n    pattern: \'\343\200\234\343\201\276\343\201\230\343\201\215 (~majiki)\',\n    titlePt: \'Inadmiss\303\255vel para a Posi\303\247\303\243o: \"N\303\243o condiz com / Inaceit\303\241vel\"\',\n    jlpt: \'N1\',\n    category: \'Linguagem Formal & Cr\303\255tica Moral\',\n    formationFormula: \'[Verbo na Forma Dicion\303\241rio] + \343\201\276\343\201\230\343\201\215 + [Substantivo]\',\n    explanationPt: \'Express\303\243o liter\303\241ria e de alto n\303\255vel que condena veementemente um comportamento, afirmando que \303\251 inaceit\303\241vel dada a postura ou fun\303\247\303\243o de quem o cometeu.\',\n    keyRulePt: \'Geralmente combinado com: \350\250\261\343\201\231\343\201\276\343\201\230\343\201\215 (imperdo\303\241vel) ou \343\201\202\343\202\213\343\201\276\343\201\230\343\201\215 (inaceit\303\241vel de existir). O verbo \343\201\231\343\202\213 vira \"\343\201\231\343\201\276\343\201\230\343\201\215\".\',\n    examples: [\n      {\n        jp: \'\343\203\227\343\203\255\343\201\256\343\202\271\343\203\235\343\203\274\343\203\204\351\201\270\346\211\213\343\201\250\343\201\227\343\201\246\343\201\202\343\202\213\343\201\276\343\201\230\343\201\215\350\241\214\347\202\272\343\201\240\343\200\202\',\n        reading: \'\343\203\227\343\203\255 \343\201\256 \343\202\271\343\203\235\343\203\274\343\203\204\343\201\233\343\202\223\343\201\227\343\202\205 \343\201\250\343\201\227\343\201\246 \343\201\202\343\202\213\343\201\276\343\201\230\343\201\215 \343\201\223\343\201\206\343\201\204 \343\201\240\343\200\202\',\n        romaji: \'Puro no supootsu senshu to shite arumajiki koui da.\',\n        meaningPt: \'\303\211 uma atitude completamente inaceit\303\241vel para quem \303\251 um atleta profissional.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n1_2\',\n    pattern: \'\343\200\234\346\245\265\343\201\276\343\202\212\343\201\252\343\201\204 / \343\200\234\346\245\265\343\201\276\343\202\213 (~kiwamarinai / ~kiwamaru)\',\n    titlePt: \'Grau M\303\241ximo e Extremo: \"Extremamente / Nada mais do que...\"\',\n    jlpt: \'N1\',\n    category: \'Grau M\303\241ximo\',\n    formationFormula: \'[Adj-NA (sem \343\201\252)] + \346\245\265\343\201\276\343\202\212\343\201\252\343\201\204 / \346\245\265\343\201\276\343\202\213 / [Adj-I (sem \343\201\204)] + \343\201\223\343\201\250\346\245\265\343\201\276\343\202\212\343\201\252\343\201\204\',\n    explanationPt: \'Expressa que um estado atingiu o \303\241pice absoluto, geralmente com conota\303\247\303\243o de indigna\303\247\303\243o, perigo ou surpresa.\',\n    keyRulePt: \'Ex: \345\215\261\351\231\272\346\245\265\343\201\276\343\202\212\343\201\252\343\201\204 (extremamente perigoso), \345\244\261\347\244\274\346\245\265\343\201\276\343\202\212\343\201\252\343\201\204 (da mais profunda grosseria).\',\n    examples: [\n      {\n        jp: \'\345\275\274\343\201\256\346\205\213\345\272\246\343\201\257\345\244\261\347\244\274\346\245\265\343\201\276\343\202\212\343\201\252\343\201\204\343\200\202\344\272\214\345\272\246\343\201\250\344\274\232\343\201\204\343\201\237\343\201\217\343\201\252\343\201\204\343\200\202\',\n        reading: \'\343\201\213\343\202\214 \343\201\256 \343\201\237\343\201\204\343\201\251 \343\201\257 \343\201\227\343\201\244\343\202\214\343\201\204 \343\201\215\343\202\217\343\201\276\343\202\212\343\201\252\343\201\204\343\200\202\343\201\253\343\201\251\343\201\250 \343\201\202\343\201\204\343\201\237\343\201\217\343\201\252\343\201\204\343\200\202\',\n        romaji: \'Kare no taido wa shitsurei kiwamarinai. Nidoto aitakunai.\',\n        meaningPt: \'A atitude dele \303\251 da mais extrema falta de educa\303\247\303\243o. N\303\243o quero v\303\252-lo nunca mais.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n1_3\',\n    pattern: \'\343\200\234\343\202\222\347\232\256\345\210\207\343\202\212\343\201\253 (~o kawakiri ni)\',\n    titlePt: \'Marco Inicial em Cadeia: \"A come\303\247ar por... / Tendo como pontap\303\251 inicial...\"\',\n    jlpt: \'N1\',\n    category: \'In\303\255cio & Sequ\303\252ncia de Sucessos\',\n    formationFormula: \'[Substantivo] + \343\202\222\347\232\256\345\210\207\343\202\212\343\201\253(\343\201\227\343\201\246) / \343\202\222\347\232\256\345\210\207\343\202\212\343\201\250\343\201\227\343\201\246\',\n    explanationPt: \'Indica que uma a\303\247\303\243o inicial serviu de estopim ou pontap\303\251 de partida para uma s\303\251rie consecutiva de eventos similares em escala crescente.\',\n    keyRulePt: \'Muito usado em not\303\255cias sobre turn\303\252s de shows, lan\303\247amentos de filiais e eventos comemorativos.\',\n    examples: [\n      {\n        jp: \'\346\235\261\344\272\254\345\205\254\346\274\224\343\202\222\347\232\256\345\210\207\343\202\212\343\201\253\343\200\201\345\205\250\345\233\275\357\274\221\357\274\220\351\203\275\345\270\202\343\201\247\343\202\263\343\203\263\343\202\265\343\203\274\343\203\210\343\201\214\351\226\213\345\202\254\343\201\225\343\202\214\343\202\213\343\200\202\',\n        reading: \'\343\201\250\343\201\206\343\201\215\343\202\207\343\201\206 \343\201\223\343\201\206\343\201\210\343\202\223 \343\202\222 \343\201\213\343\202\217\343\201\215\343\202\212 \343\201\253\343\200\201\343\201\234\343\202\223\343\201\223\343\201\217 \343\201\230\343\202\205\343\201\243 \343\201\250\343\201\227 \343\201\247 \343\202\263\343\203\263\343\202\265\343\203\274\343\203\210 \343\201\214 \343\201\213\343\201\204\343\201\225\343\201\204 \343\201\225\343\202\214\343\202\213\343\200\202\',\n        romaji: \'Toukyou kouen o kawakiri ni, zenkoku juttoshi de konsaato ga kaisai sareru.\',\n        meaningPt: \'A come\303\247ar pela apresenta\303\247\303\243o em T\303\263quio, concertos ser\303\243o realizados em 10 cidades por todo o pa\303\255s.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n1_4\',\n    pattern: \'\343\200\234\343\201\247\343\201\202\343\202\214 / \343\200\234\343\201\247\343\201\202\343\202\215\343\201\206\343\201\250 (~de are / ~de arou to)\',\n    titlePt: \'Universalidade Absoluta: \"Mesmo que seja... / N\303\243o importa se...\"\',\n    jlpt: \'N1\',\n    category: \'Condi\303\247\303\243o Irrelevante & Igualdade\',\n    formationFormula: \'[Substantivo / Pronome interrogativo] + \343\201\247\343\201\202\343\202\214 / \343\201\247\343\201\202\343\202\215\343\201\206\343\201\250 (ou A\343\201\247\343\201\202\343\202\214B\343\201\247\343\201\202\343\202\214)\',\n    explanationPt: \'Enfatiza que sob qualquer circunst\303\242ncia, status ou identidade, o resultado ou a regra permanece estritamente invari\303\241vel.\',\n    keyRulePt: \'Frequentemente expressa princ\303\255pios legais, \303\251ticos e universais.\',\n    examples: [\n      {\n        jp: \'\347\220\206\347\224\261\343\201\214\344\275\225\343\201\247\343\201\202\343\202\214\343\200\201\346\232\264\345\212\233\343\202\222\346\214\257\343\202\213\343\201\206\343\201\223\343\201\250\343\201\257\350\250\261\343\201\225\343\202\214\343\201\252\343\201\204\343\200\202\',\n        reading: \'\343\202\212\343\202\206\343\201\206 \343\201\214 \343\201\252\343\201\253 \343\201\247\343\201\202\343\202\214\343\200\201\343\201\274\343\201\206\343\202\212\343\202\207\343\201\217 \343\202\222 \343\201\265\343\202\213\343\201\206 \343\201\223\343\201\250 \343\201\257 \343\202\206\343\202\213\343\201\225\343\202\214\343\201\252\343\201\204\343\200\202\',\n        romaji: \'Riyuu ga nani de are, bouryoku o furuu koto wa yurusarenai.\',\n        meaningPt: \'N\303\243o importa qual seja a raz\303\243o, cometer viol\303\252ncia \303\251 imperdo\303\241vel.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n1_5\',\n    pattern: \'\343\200\234\344\275\231\345\204\200\343\201\252\343\201\217\343\201\225\343\202\214\343\202\213 (~yogi naku sareru)\',\n    titlePt: \'Imposi\303\247\303\243o For\303\247ada: \"Ser for\303\247ado pelas circunst\303\242ncias a...\"\',\n    jlpt: \'N1\',\n    category: \'Causa Inevit\303\241vel & For\303\247a Maior\',\n    formationFormula: \'[Substantivo de a\303\247\303\243o] + \343\202\222\344\275\231\345\204\200\343\201\252\343\201\217\343\201\225\343\202\214\343\202\213 / [Verbo] + \343\201\223\343\201\250\343\202\222\344\275\231\345\204\200\343\201\252\343\201\217\343\201\225\343\202\214\343\202\213\',\n    explanationPt: \'Expressa que, devido a uma situa\303\247\303\243o externa incontrol\303\241vel (como desastres, crises financeiras ou doen\303\247as), a pessoa/institui\303\247\303\243o n\303\243o tem escolha sen\303\243o cancelar, adiar ou mudar seus planos.\',\n    keyRulePt: \'\343\200\234\344\275\231\345\204\200\343\201\252\343\201\217\343\201\225\343\201\233\343\202\213 (ativo) significa \"a situa\303\247\303\243o for\303\247ou algu\303\251m a...\"; \343\200\234\344\275\231\345\204\200\343\201\252\343\201\217\343\201\225\343\202\214\343\202\213 (passivo) significa \"o sujeito foi for\303\247ado a...\".\',\n    examples: [\n      {\n        jp: \'\345\244\247\345\236\213\345\217\260\351\242\250\343\201\256\345\275\261\351\237\277\343\201\247\343\200\201\343\202\244\343\203\231\343\203\263\343\203\210\343\201\257\344\270\255\346\255\242\343\202\222\344\275\231\345\204\200\343\201\252\343\201\217\343\201\225\343\202\214\343\201\237\343\200\202\',\n        reading: \'\343\201\212\343\201\212\343\201\214\343\201\237 \343\201\237\343\201\204\343\201\265\343\201\206 \343\201\256 \343\201\210\343\201\204\343\201\215\343\202\207\343\201\206 \343\201\247\343\200\201\343\202\244\343\203\231\343\203\263\343\203\210 \343\201\257 \343\201\241\343\202\205\343\201\206\343\201\227 \343\202\222 \343\202\210\343\201\216 \343\201\252\343\201\217 \343\201\225\343\202\214\343\201\237\343\200\202\',\n        romaji: \'Oogata taifuu no eikyou de, ibento wa chuushi o yogi naku sareta.\',\n        meaningPt: \'Devido ao impacto do grande tuf\303\243o, fomos inevitavelmente for\303\247ados a cancelar o evento.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n1_6\',\n    pattern: \'\343\200\234\343\202\223\343\201\260\343\201\213\343\202\212\343\201\253 (~n bakari ni)\',\n    titlePt: \'Prestes / Quase como se: \"Como se estivesse a ponto de...\"\',\n    jlpt: \'N1\',\n    category: \'Grau & Apar\303\252ncia Quase Real\',\n    formationFormula: \'[Verbo Forma Nai sem \343\201\252\343\201\204] + \343\202\223\343\201\260\343\201\213\343\202\212\343\201\253 (exce\303\247\303\243o: \343\201\231\343\202\213 \342\236\224 \343\201\233\343\202\223\343\201\260\343\201\213\343\202\212\343\201\253)\',\n    explanationPt: \'Descreve metaforicamente que o estado ou a express\303\243o de algu\303\251m est\303\241 t\303\243o intensa que parece que vai realizar aquela a\303\247\303\243o a qualquer segundo.\',\n    keyRulePt: \'Ex: \346\263\243\343\201\215\345\207\272\343\201\225\343\202\223\343\201\260\343\201\213\343\202\212 (quase chorando), \351\243\233\343\201\263\344\270\212\343\201\214\343\202\211\343\202\223\343\201\260\343\201\213\343\202\212 (quase pulando de alegria).\',\n    examples: [\n      {\n        jp: \'\345\275\274\343\201\257\343\200\214\346\227\251\343\201\217\345\270\260\343\202\214\343\200\215\343\201\250\350\250\200\343\202\217\343\202\223\343\201\260\343\201\213\343\202\212\343\201\256\346\205\213\345\272\246\343\202\222\343\201\250\343\201\243\343\201\237\343\200\202\',\n        reading: \'\343\201\213\343\202\214 \343\201\257 \343\200\214\343\201\257\343\202\204\343\201\217 \343\201\213\343\201\210\343\202\214\343\200\215 \343\201\250 \343\201\204\343\202\217\343\202\223\343\201\260\343\201\213\343\202\212 \343\201\256 \343\201\237\343\201\204\343\201\251 \343\202\222 \343\201\250\343\201\243\343\201\237\343\200\202\',\n        romaji: \'Kare wa \"hayaku kaere\" to iwan bakari no taido o totta.\',\n        meaningPt: \'Ele agiu com uma atitude que praticamente dizia \"v\303\241 logo para casa\".\'\n      }\n    ]\n  },\n  {\n    id: \'g_n1_7\',\n    pattern: \'\343\200\234\343\201\224\343\201\250\343\201\215 / \343\200\234\343\201\224\343\201\250\343\201\217 (~gotoki / ~gotoku)\',\n    titlePt: \'Semelhan\303\247a Liter\303\241ria ou Desd\303\251m: \"Assim como... / Feito um...\"\',\n    jlpt: \'N1\',\n    category: \'Compara\303\247\303\243o & Ret\303\263rica Cl\303\241ssica\',\n    formationFormula: \'[Substantivo / Verbo] + \343\201\256 + \343\201\224\343\201\250\343\201\215 [Substantivo] / \343\201\224\343\201\250\343\201\217 [Verbo/Adj]\',\n    explanationPt: \'Uso liter\303\241rio cl\303\241ssico similar a \343\200\234\343\201\256\343\202\210\343\201\206\343\201\240. Pode indicar tamb\303\251m mod\303\251stia humilde (\347\247\201\343\201\224\343\201\250\343\201\215 = algu\303\251m insignificante como eu) ou desd\303\251m.\',\n    keyRulePt: \'\343\201\224\343\201\250\343\201\215 modifica substantivos; \343\201\224\343\201\250\343\201\217 funciona como adv\303\251rbio modificando verbos.\',\n    examples: [\n      {\n        jp: \'\345\205\211\351\231\260\347\237\242\343\201\256\343\201\224\343\201\250\343\201\227\343\200\202\346\231\202\351\226\223\343\201\257\347\237\242\343\201\256\343\202\210\343\201\206\343\201\253\346\227\251\343\201\217\351\201\216\343\201\216\345\216\273\343\202\213\343\200\202\',\n        reading: \'\343\201\223\343\201\206\343\201\204\343\202\223 \343\202\204 \343\201\256 \343\201\224\343\201\250\343\201\227\343\200\202\343\201\230\343\201\213\343\202\223 \343\201\257 \343\202\204 \343\201\256 \343\202\210\343\201\206\343\201\253 \343\201\257\343\202\204\343\201\217 \343\201\231\343\201\216\343\201\225\343\202\213\343\200\202\',\n        romaji: \'Kouin ya no gotoshi. Jikan wa ya no you ni hayaku sugisaru.\',\n        meaningPt: \'O tempo voa como uma flecha (prov\303\251rbio cl\303\241ssico japon\303\252s).\'\n      },\n      {\n        jp: \'\347\247\201\343\201\224\343\201\250\343\201\215\343\201\253\343\201\235\343\201\256\343\202\210\343\201\206\343\201\252\345\244\247\345\275\271\343\201\257\345\213\231\343\201\276\343\202\212\343\201\276\343\201\233\343\202\223\343\200\202\',\n        reading: \'\343\202\217\343\201\237\343\201\217\343\201\227 \343\201\224\343\201\250\343\201\215 \343\201\253 \343\201\235\343\201\256\343\202\210\343\201\206\343\201\252 \343\201\237\343\201\204\343\202\204\343\201\217 \343\201\257 \343\201\244\343\201\250\343\201\276\343\202\212\343\201\276\343\201\233\343\202\223\343\200\202\',\n        romaji: \'Watakushi gotoki ni sono you na taiyaku wa tsutomarimasen.\',\n        meaningPt: \'Algu\303\251m humilde e simples como eu n\303\243o \303\251 capaz de desempenhar papel t\303\243o nobre.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n1_8\',\n    pattern: \'\343\200\234\343\201\232\343\201\253\343\201\257\343\201\212\343\201\213\343\201\252\343\201\204 (~zu ni wa okanai)\',\n    titlePt: \'Inevitabilidade Provocada: \"Certamente provocar\303\241 / N\303\243o deixar\303\241 de...\"\',\n    jlpt: \'N1\',\n    category: \'Impacto Inevit\303\241vel\',\n    formationFormula: \'[Verbo Forma Nai sem \343\201\252\343\201\204] + \343\201\232\343\201\253\343\201\257\343\201\212\343\201\213\343\201\252\343\201\204 (exce\303\247\303\243o: \343\201\231\343\202\213 \342\236\224 \343\201\233\343\201\232\343\201\253\343\201\257\343\201\212\343\201\213\343\201\252\343\201\204)\',\n    explanationPt: \'Expressa forte convic\303\247\303\243o de que algo inevitavelmente ter\303\241 uma influ\303\252ncia profunda ou provocar\303\241 uma rea\303\247\303\243o emocional inevit\303\241vel em todos.\',\n    keyRulePt: \'Geralmente combinado com verbos de como\303\247\303\243o, como \346\204\237\345\213\225\343\201\225\343\201\233\343\202\213 (emocionar), \346\200\222\343\202\211\343\201\233\343\202\213 (enfurecer).\',\n    examples: [\n      {\n        jp: \'\345\275\274\343\201\256\346\204\237\345\213\225\347\232\204\343\201\252\343\202\271\343\203\224\343\203\274\343\203\201\343\201\257\343\200\201\350\201\264\350\241\206\343\202\222\346\263\243\343\201\213\343\201\233\343\201\232\343\201\253\343\201\257\343\201\212\343\201\213\343\201\252\343\201\213\343\201\243\343\201\237\343\200\202\',\n        reading: \'\343\201\213\343\202\214 \343\201\256 \343\201\213\343\202\223\343\201\251\343\201\206\343\201\246\343\201\215 \343\201\252 \343\202\271\343\203\224\343\203\274\343\203\201 \343\201\257\343\200\201\343\201\241\343\202\207\343\201\206\343\201\227\343\202\205\343\201\206 \343\202\222 \343\201\252\343\201\213\343\201\233\343\201\232 \343\201\253 \343\201\257 \343\201\212\343\201\213\343\201\252\343\201\213\343\201\243\343\201\237\343\200\202\',\n        romaji: \'Kare no kandouteki na supiichi wa, choushuu o nakasezu ni wa okanakatta.\',\n        meaningPt: \'O discurso emocionante dele inevitavelmente levou toda a plateia \303\240s l\303\241grimas.\'\n      }\n    ]\n  }\n];\n"
    }
