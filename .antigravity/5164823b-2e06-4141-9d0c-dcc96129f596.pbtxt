274\201\346\245\255\', reading: \'\343\201\215\343\201\216\343\202\207\343\201\206 (kigyou)\', meaningPt: \'Empresa / Corpora\303\247\303\243o\' },\n      { word: \'\344\274\201\347\224\273\', reading: \'\343\201\215\343\201\213\343\201\217 (kikaku)\', meaningPt: \'Planejamento / Projeto\' },\n      { word: \'\344\274\201\343\201\246\343\202\213\', reading: \'\343\201\217\343\202\217\343\201\240\343\201\246\343\202\213 (kuwadaeru)\', meaningPt: \'Tramar / Empreender\' }\n    ]\n  },\n  {\n    id: \'k_n2_4\',\n    kanji: \'\345\216\263\',\n    onyomi: [\'\343\202\262\343\203\263 (gen)\', \'\343\202\264\343\203\263 (gon)\'],\n    kunyomi: [\'\343\201\215\343\201\263.\343\201\227\343\201\204 (kibi.shii)\', \'\343\201\212\343\201\224\343\201\235.\343\201\213 (ogoso.ka)\'],\n    meaningPt: \'Severo, Estrito, Solene\',\n    strokes: 17,\n    radical: \'\345\217\243 (boca)\',\n    jlpt: \'N2\',\n    examples: [\n      { word: \'\345\216\263\343\201\227\343\201\204\', reading: \'\343\201\215\343\201\263\343\201\227\343\201\204 (kibishii)\', meaningPt: \'Severo / Rigoroso\' },\n      { word: \'\345\216\263\351\207\215\', reading: \'\343\201\222\343\202\223\343\201\230\343\202\205\343\201\206 (genjuu)\', meaningPt: \'Seguran\303\247a rigorosa\' }\n    ]\n  },\n  {\n    id: \'k_n2_5\',\n    kanji: \'\345\271\205\',\n    onyomi: [\'\343\203\225\343\202\257 (fuku)\'],\n    kunyomi: [\'\343\201\257\343\201\260 (haba)\'],\n    meaningPt: \'Largura, Amplitude, Margem\',\n    strokes: 12,\n    radical: \'\345\267\276 (pano)\',\n    jlpt: \'N2\',\n    examples: [\n      { word: \'\345\271\205\', reading: \'\343\201\257\343\201\260 (haba)\', meaningPt: \'Largura / Amplitude\' },\n      { word: \'\345\244\247\345\271\205\', reading: \'\343\201\212\343\201\212\343\201\257\343\201\260 (oohaba)\', meaningPt: \'Em grande escala / Dr\303\241stico\' }\n    ]\n  },\n\n  // ===================== N1 KANJIS =====================\n  {\n    id: \'k_n1_1\',\n    kanji: \'\351\221\221\',\n    onyomi: [\'\343\202\253\343\203\263 (kan)\'],\n    kunyomi: [\'\343\201\213\343\201\214\343\201\277 (kagami)\', \'\343\201\213\343\202\223\343\201\214.\343\201\277\343\202\213 (kanga.miru)\'],\n    meaningPt: \'Apreciar arte, Per\303\255cia, Espelho exemplar\',\n    strokes: 23,\n    radical: \'\351\207\221 (metal)\',\n    jlpt: \'N1\',\n    examples: [\n      { word: \'\351\221\221\350\263\236\', reading: \'\343\201\213\343\202\223\343\201\227\343\202\207\343\201\206 (kanshou)\', meaningPt: \'Aprecia\303\247\303\243o art\303\255stica\' },\n      { word: \'\351\221\221\345\256\232\', reading: \'\343\201\213\343\202\223\343\201\246\343\201\204 (kantei)\', meaningPt: \'Per\303\255cia / Avalia\303\247\303\243o\' },\n      { word: \'\345\233\263\351\221\221\', reading: \'\343\201\232\343\201\213\343\202\223 (zukan)\', meaningPt: \'Enciclop\303\251dia ilustrada\' }\n    ]\n  },\n  {\n    id: \'k_n1_2\',\n    kanji: \'\350\246\207\',\n    onyomi: [\'\343\203\217 (ha)\', \'\343\203\217\343\202\257 (haku)\'],\n    kunyomi: [],\n    meaningPt: \'Hegemonia, Supremacia, Campe\303\243o\',\n    strokes: 19,\n    radical: \'\350\245\277 (oeste)\',\n    jlpt: \'N1\',\n    examples: [\n      { word: \'\350\246\207\346\250\251\', reading: \'\343\201\257\343\201\221\343\202\223 (haken)\', meaningPt: \'Hegemonia\' },\n      { word: \'\351\200\243\350\246\207\', reading: \'\343\202\214\343\202\223\343\201\261 (renpa)\', meaningPt: \'T\303\255tulos consecutivos\' },\n      { word: \'\345\210\266\350\246\207\', reading: \'\343\201\233\343\201\204\343\201\257 (seiha)\', meaningPt: \'Conquista e domina\303\247\303\243o\' }\n    ]\n  },\n  {\n    id: \'k_n1_3\',\n    kanji: \'\351\254\261\',\n    onyomi: [\'\343\202\246\343\203\204 (utsu)\'],\n    kunyomi: [\'\343\201\265\343\201\225.\343\201\220 (fusa.gu)\'],\n    meaningPt: \'Melancolia, Depress\303\243o cl\303\255nica, Denso\',\n    strokes: 29,\n    radical: \'\351\254\257 (erva arom\303\241tica)\',\n    jlpt: \'N1\',\n    examples: [\n      { word: \'\346\206\202\351\254\261\', reading: \'\343\202\206\343\201\206\343\201\206\343\201\244 (yuuutsu)\', meaningPt: \'Melanc\303\263lico / Triste\' },\n      { word: \'\351\254\261\347\227\205\', reading: \'\343\201\206\343\201\244\343\201\263\343\202\207\343\201\206 (utsubyou)\', meaningPt: \'Depress\303\243o cl\303\255nica\' },\n      { word: \'\346\232\227\351\254\261\', reading: \'\343\201\202\343\202\223\343\201\206\343\201\244 (anutsu)\', meaningPt: \'Sombrio\' }\n    ]\n  },\n  {\n    id: \'k_n1_4\',\n    kanji: \'\347\263\276\',\n    onyomi: [\'\343\202\255\343\203\245\343\202\246 (kyuu)\'],\n    kunyomi: [],\n    meaningPt: \'Investigar, Entrela\303\247ar, Denunciar\',\n    strokes: 9,\n    radical: \'\347\263\270 (fio)\',\n    jlpt: \'N1\',\n    examples: [\n      { word: \'\347\263\276\345\274\276\', reading: \'\343\201\215\343\202\205\343\201\206\343\201\240\343\202\223 (kyuudan)\', meaningPt: \'Den\303\272ncia / Censura severa\' },\n      { word: \'\347\264\233\347\263\276\', reading: \'\343\201\265\343\202\223\343\201\215\343\202\205\343\201\206 (funkyuu)\', meaningPt: \'Complica\303\247\303\243o / Impasse\' }\n    ]\n  }\n];\n"
