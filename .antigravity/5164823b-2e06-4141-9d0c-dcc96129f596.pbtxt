        }
        lines {
          text: "    category: \'Dar & Receber\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    formationFormula: \'[Verbo na forma-TE] + \343\201\202\343\201\222\343\202\213 (eu fa\303\247o para outro) / \343\201\217\343\202\214\343\202\213 (algu\303\251m faz para mim) / \343\202\202\343\202\211\343\201\206 (eu recebo a gentileza de algu\303\251m)\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanationPt: \'Em japon\303\252s \303\251 fundamental explicitar a dire\303\247\303\243o da gentileza e o sentimento de gratid\303\243o em rela\303\247\303\243o a quem realizou o favor.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    keyRulePt: \'\342\200\242 \343\200\234\343\201\246\343\201\202\343\201\222\343\202\213: Eu ou algu\303\251m do meu grupo faz em benef\303\255cio de outro.\\n\342\200\242 \343\200\234\343\201\246\343\201\217\343\202\214\343\202\213: Algu\303\251m faz espontaneamente em meu benef\303\255cio (sou o recebedor).\\n\342\200\242 \343\200\234\343\201\246\343\202\202\343\202\211\343\201\206: Eu solicito/recebo a a\303\247\303\243o de outra pessoa (marcada por \343\201\253).\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
