    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { GrammarItem } from \'../types\';\n\nexport const GRAMMAR_N4: GrammarItem[] = [\n  {\n    id: \'g_n4_1\',\n    pattern: \'\343\200\234\343\201\252\343\201\221\343\202\214\343\201\260\343\201\252\343\202\211\343\201\252\343\201\204 / \343\200\234\343\201\252\343\201\217\343\201\246\343\201\257\343\201\204\343\201\221\343\201\252\343\201\204 (~nakereba naranai / nakute wa ikenai)\',\n    titlePt: \'Obriga\303\247\303\243o e Dever: \"Ter que fazer / \303\211 obrigat\303\263rio\"\',\n    jlpt: \'N4\',\n    category: \'Obriga\303\247\303\243o & Dever\',\n    formationFormula: \'[Verbo na forma-Nai] sem o \"\343\201\204\" + \343\201\221\343\202\214\343\201\260\343\201\252\343\202\211\343\201\252\343\201\204 / \343\201\221\343\202\214\343\201\260\343\201\204\343\201\221\343\201\276\343\201\233\343\202\223\',\n    explanationPt: \'Expressa obriga\303\247\303\265es legais, sociais, de sa\303\272de ou regras que n\303\243o podem ser evitadas. Literalmente \"se n\303\243o fizer, n\303\243o vai\".\',\n    keyRulePt: \'\342\200\242 No dia a dia casual, costuma ser abreviado para: \343\200\234\343\201\252\343\201\215\343\202\203 (nakya) ou \343\200\234\343\201\252\343\201\217\343\201\241\343\202\203 (nakucha).\\n\342\200\242 Para dizer \"n\303\243o precisa fazer\": \343\200\234\343\201\252\343\201\217\343\201\246\343\202\202\343\201\204\343\201\204\343\201\247\343\201\231 (~nakute mo ii desu).\',\n    examples: [\n      {\n        jp: \'\346\257\216\346\227\245\343\200\201\346\274\242\345\255\227\343\202\222\345\276\251\347\277\222\343\201\227\343\201\252\343\201\221\343\202\214\343\201\260\343\201\252\343\202\212\343\201\276\343\201\233\343\202\223\343\200\202\',\n        reading: \'\343\201\276\343\201\204\343\201\253\343\201\241\343\200\201\343\201\213\343\202\223\343\201\230 \343\202\222 \343\201\265\343\201\217\343\201\227\343\202\205\343\201\206 \343\201\227\343\201\252\343\201\221\343\202\214\343\201\260 \343\201\252\343\202\212\343\201\276\343\201\233\343\202\223\343\200\202\',\n        romaji: \'Mainichi, kanji o fukushuu shinakereba narimasen.\',\n        meaningPt: \'Tenho que revisar kanji todos os dias.\'\n      },\n      {\n        jp: \'\346\230\216\346\227\245\343\201\257\344\274\221\343\201\277\343\201\240\343\201\213\343\202\211\343\200\201\346\227\251\343\201\217\350\265\267\343\201\215\343\201\252\343\201\217\343\201\246\343\202\202\343\201\204\343\201\204\343\201\247\343\201\231\343\200\202\',\n        reading: \'\343\201\202\343\201\227\343\201\237 \343\201\257 \343\202\204\343\201\231\343\201\277 \343\201\240\343\201\213\343\202\211\343\200\201\343\201\257\343\202\204\343\201\217 \343\201\212\343\201\215\343\201\252\343\201\217\343\201\246\343\202\202 \343\201\204\343\201\204\343\201\247\343\201\231\343\200\202\',\n        romaji: \'Ashita wa yasumi dakara, hayaku okinakute mo ii desu.\',\n        meaningPt: \'Como amanh\303\243 \303\251 folga, n\303\243o preciso acordar cedo.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n4_2\',\n    pattern: \'Verbo (Forma Dicion\303\241rio / Forma-NAI) + \343\201\244\343\202\202\343\202\212\343\201\247\343\201\231 (~tsumori desu)\',\n    titlePt: \'Inten\303\247\303\243o e Decis\303\243o Pessoal: \"Pretendo fazer...\"\',\n    jlpt: \'N4\',\n    category: \'Planos & Inten\303\247\303\265es\',\n    formationFormula: \'[Verbo na Forma Dicion\303\241rio ou Forma-Nai] + \343\201\244\343\202\202\343\202\212\343\201\247\343\201\231\',\n    explanationPt: \'Indica um plano ou inten\303\247\303\243o pessoal que o falante j\303\241 decidiu e pretende executar no futuro.\',\n    keyRulePt: \'\342\200\242 Afirmativo: \350\241\214\343\201\217\343\201\244\343\202\202\343\202\212\343\201\247\343\201\231 (pretendo ir)\\n\342\200\242 Negativo: \350\241\214\343\201\213\343\201\252\343\201\204\343\201\244\343\202\202\343\202\212\343\201\247\343\201\231 (pretendo n\303\243o ir) ou \350\241\214\343\201\217\343\201\244\343\202\202\343\202\212\343\201\257\343\201\202\343\202\212\343\201\276\343\201\233\343\202\223 (n\303\243o tenho qualquer inten\303\247\303\243o de ir).\',\n    examples: [\n      {\n        jp: \'\346\235\245\345\271\264\343\200\201\346\227\245\346\234\254\343\201\270\347\225\231\345\255\246\343\201\231\343\202\213\343\201\244\343\202\202\343\202\212\343\201\247\343\201\231\343\200\202\',\n        reading: \'\343\202\211\343\201\204\343\201\255\343\202\223\343\200\201\343\201\253\343\201\273\343\202\223 \343\201\270 \343\202\212\343\202\205\343\201\206\343\201\214\343\201\217 \343\201\231\343\202\213 \343\201\244\343\202\202\343\202\212 \343\201\247\343\201\231\343\200\202\',\n        romaji: \'Rainen, nihon e ryuugaku suru tsumori desu.\',\n        meaningPt: \'Pretendo fazer interc\303\242mbio no Jap\303\243o no ano que vem.\'\n      },\n      {\n        jp: \'\343\202\277\343\203\220\343\202\263\343\202\222\343\202\204\343\202\201\343\202\213\343\201\244\343\202\202\343\202\212\343\201\247\343\201\231\343\200\202\',\n        reading: \'\343\202\277\343\203\220\343\202\263 \343\202\222 \343\202\204\343\202\201\343\202\213 \343\201\244\343\202\202\343\202\212 \343\201\247\343\201\231\343\200\202\',\n        romaji: \'Tabako o yameru tsumori desu.\',\n        meaningPt: \'Pretendo parar de fumar.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n4_3\',\n    pattern: \'Verbo / Substantivo + \344\272\210\345\256\232\343\201\247\343\201\231 (~yotei desu)\',\n    titlePt: \'Plano ou Cronograma Oficial: \"Est\303\241 programado para...\"\',\n    jlpt: \'N4\',\n    category: \'Planos & Inten\303\247\303\265es\',\n    formationFormula: \'[Verbo na Forma Dicion\303\241rio] + \344\272\210\345\256\232\343\201\247\343\201\231 | [Substantivo] + \343\201\256 + \344\272\210\345\256\232\343\201\247\343\201\231\',\n    explanationPt: \'Diferente de \343\201\244\343\202\202\343\202\212 (que \303\251 inten\303\247\303\243o pessoal), \344\272\210\345\256\232 (yotei) expressa um compromisso oficial, agenda p\303\272blica ou itiner\303\241rio j\303\241 definido.\',\n    keyRulePt: \'Muito usado em contextos corporativos, viagens e eventos com hora e data agendadas.\',\n    examples: [\n      {\n        jp: \'\344\274\232\350\255\260\343\201\257\344\270\211\346\231\202\343\201\213\343\202\211\345\247\213\343\201\276\343\202\213\344\272\210\345\256\232\343\201\247\343\201\231\343\200\202\',\n        reading: \'\343\201\213\343\201\204\343\201\216 \343\201\257 \343\201\225\343\202\223\343\201\230 \343\201\213\343\202\211 \343\201\257\343\201\230\343\201\276\343\202\213 \343\202\210\343\201\246\343\201\204 \343\201\247\343\201\231\343\200\202\',\n        romaji: \'Kaigi wa sanji kara hajimaru yotei desu.\',\n        meaningPt: \'A reuni\303\243o est\303\241 agendada para come\303\247ar \303\240s 15h.\'\n      },\n      {\n        jp: \'\346\235\245\351\200\261\343\200\201\345\207\272\345\274\265\343\201\256\344\272\210\345\256\232\343\201\247\343\201\231\343\200\202\',\n        reading: \'\343\202\211\343\201\204\343\201\227\343\202\205\343\201\206\343\200\201\343\201\227\343\202\205\343\201\243\343\201\241\343\202\207\343\201\206 \343\201\256 \343\202\210\343\201\246\343\201\204 \343\201\247\343\201\231\343\200\202\',\n        romaji: \'Raishuu, shutchou no yotei desu.\',\n        meaningPt: \'Estou com viagem a neg\303\263cios programada para a pr\303\263xima semana.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n4_4\',\n    pattern: \'Forma Simples + \343\201\250\346\200\235\343\201\204\343\201\276\343\201\231 (~to omoimasu)\',\n    titlePt: \'Opini\303\243o & Pensamento: \"Acho que / Penso que...\"\',\n    jlpt: \'N4\',\n    category: \'Opini\303\265es & Julgamento\',\n    formationFormula: \'[Forma Simples (Futsuukei)] + \343\201\250\346\200\235\343\201\204\343\201\276\343\201\231\',\n    explanationPt: \'Utilizado para expressar a opini\303\243o pessoal do falante de maneira polida e n\303\243o impositiva, ou para amenizar uma afirma\303\247\303\243o.\',\n    keyRulePt: \'\342\200\242 Para Adjetivo-NA e Substantivo no presente afirmativo, adiciona-se \343\201\240 (da): \346\230\216\346\227\245\343\201\257\351\233\250\343\201\240\343\201\250\346\200\235\343\201\204\343\201\276\343\201\231 (Acho que amanh\303\243 chove).\\n\342\200\242 Com a Forma Volitiva (\343\200\234\343\202\210\343\201\206\343\201\250\346\200\235\343\201\206): expressa uma decis\303\243o que acabou de tomar (\"estou pensando em fazer\").\',\n    examples: [\n      {\n        jp: \'\346\230\216\346\227\245\343\201\256\350\251\246\351\250\223\343\201\257\351\233\243\343\201\227\343\201\204\343\201\250\346\200\235\343\201\204\343\201\276\343\201\231\343\200\202\',\n        reading: \'\343\201\202\343\201\227\343\201\237 \343\201\256 \343\201\227\343\201\221\343\202\223 \343\201\257 \343\202\200\343\201\232\343\201\213\343\201\227\343\201\204 \343\201\250 \343\201\212\343\202\202\343\201\204\343\201\276\343\201\231\343\200\202\',\n        romaji: \'Ashita no shiken wa muzukashii to omoimasu.\',\n        meaningPt: \'Acho que a prova de amanh\303\243 ser\303\241 dif\303\255cil.\'\n      },\n      {\n        jp: \'\346\226\260\343\201\227\343\201\204\343\203\221\343\202\275\343\202\263\343\203\263\343\202\222\350\262\267\343\201\212\343\201\206\343\201\250\346\200\235\343\201\243\343\201\246\343\201\204\343\201\276\343\201\231\343\200\202\',\n        reading: \'\343\201\202\343\201\237\343\202\211\343\201\227\343\201\204 \343\203\221\343\202\275\343\202\263\343\203\263 \343\202\222 \343\201\213\343\201\212\343\201\206 \343\201\250 \343\201\212\343\202\202\343\201\243\343\201\246\343\201\204\343\201\276\343\201\231\343\200\202\',\n        romaji: \'Atarashii pasokon o kaou to omotte imasu.\',\n        meaningPt: \'Estou pensando em comprar um computador novo.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n4_5\',\n    pattern: \'As 4 Condicionais do Japon\303\252s (\343\200\234\343\201\237\343\202\211, \343\200\234\343\201\260, \343\200\234\343\201\252\343\202\211, \343\200\234\343\201\250)\',\n    titlePt: \'Guia Definitivo das Condicionais em Japon\303\252s\',\n    jlpt: \'N4\',\n    category: \'Condicionais\',\n    formationFormula: \'1) \343\200\234\343\201\237\343\202\211 (Passado + \343\202\211) | 2) \343\200\234\343\201\260 (troca \"u\" por \"eba\") | 3) \343\200\234\343\201\252\343\202\211 (Substantivo/Adj direto) | 4) \343\200\234\343\201\250 (Forma Dicion\303\241rio + \343\201\250)\',\n    explanationPt: \'Cada condicional possui um tom e aplica\303\247\303\243o l\303\263gica distinta no dia a dia:\',\n    keyRulePt: \'\342\200\242 \343\200\234\343\201\237\343\202\211 (tara): Condicional universal (\"Se/Quando\"). Muito natural e usada para sequ\303\252ncias temporais (\351\233\250\343\201\214\351\231\215\343\201\243\343\201\237\343\202\211\350\241\214\343\201\213\343\201\252\343\201\204).\\n\342\200\242 \343\200\234\343\201\260 (ba): Condicional l\303\263gica (\"Se e somente se\"): \345\256\211\343\201\221\343\202\214\343\201\260\350\262\267\343\201\204\343\201\276\343\201\231 (Se for barato, eu compro).\\n\342\200\242 \343\200\234\343\201\252\343\202\211 (nara): Condicional contextual (\"Se for o caso de... / Se voc\303\252 for...\"): \344\272\254\351\203\275\343\201\253\350\241\214\343\201\217\343\201\252\343\202\211\343\200\201\351\207\221\351\226\243\345\257\272\343\201\214\343\201\212\343\201\231\343\201\231\343\202\201.\\n\342\200\242 \343\200\234\343\201\250 (to): Condicional natural/mec\303\242nica (\"Sempre que acontece A, inevitavelmente ocorre B\"): \343\203\234\343\202\277\343\203\263\343\202\222\346\212\274\343\201\231\343\201\250\343\200\201\346\260\264\343\201\214\345\207\272\343\201\276\343\201\231 (Ao apertar o bot\303\243o, a \303\241gua sai).\',\n    examples: [\n      {\n        jp: \'\346\231\202\351\226\223\343\201\214\345\220\210\343\201\243\343\201\237\343\202\211\343\200\201\346\230\240\347\224\273\343\202\222\350\246\213\343\201\253\350\241\214\343\201\215\343\201\276\343\201\227\343\202\207\343\201\206\343\200\202\',\n        reading: \'\343\201\230\343\201\213\343\202\223 \343\201\214 \343\201\202\343\201\243\343\201\237\343\202\211\343\200\201\343\201\210\343\201\204\343\201\214 \343\202\222 \343\201\277 \343\201\253 \343\201\204\343\201\215\343\201\276\343\201\227\343\202\207\343\201\206\343\200\202\',\n        romaji: \'Jikan ga attara, eiga o mi ni ikimashou.\',\n        meaningPt: \'Se tivermos tempo, vamos ao cinema.\'\n      },\n      {\n        jp: \'\343\201\223\343\201\256\343\203\234\343\202\277\343\203\263\343\202\222\346\212\274\343\201\231\343\201\250\343\200\201\343\203\211\343\202\242\343\201\214\351\226\213\343\201\215\343\201\276\343\201\231\343\200\202\',\n        reading: \'\343\201\223\343\201\256 \343\203\234\343\202\277\343\203\263 \343\202\222 \343\201\212\343\201\231 \343\201\250\343\200\201\343\203\211\343\202\242 \343\201\214 \343\201\202\343\201\215\343\201\276\343\201\231\343\200\202\',\n        romaji: \'Kono botan o osu to, doa ga akimasu.\',\n        meaningPt: \'Ao apertar este bot\303\243o, a porta se abre.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n4_6\',\n    pattern: \'Raiz MASU + \343\201\231\343\201\216\343\201\276\343\201\231 (~sugimasu)\',\n    titlePt: \'Excesso / Exagero: \"Demais / Em excesso\"\',\n    jlpt: \'N4\',\n    category: \'Intensificadores\',\n    formationFormula: \'[Raiz do Verbo] / [Raiz de Adj-I sem \343\201\204] / [Adj-NA] + \343\201\231\343\201\216\343\202\213 / \343\201\231\343\201\216\343\201\276\343\201\231\',\n    explanationPt: \'Expressa que uma a\303\247\303\243o ou estado ultrapassou o limite saud\303\241vel ou desej\303\241vel, gerando um resultado negativo ou inc\303\264modo.\',\n    keyRulePt: \'\342\200\242 Verbo: \351\243\237\343\201\271\343\201\231\343\201\216\343\202\213 (comer demais) / \351\243\262\343\201\277\343\201\231\343\201\216\343\201\237 (bebi demais)\\n\342\200\242 Adjetivo-I: \351\253\230\343\201\231\343\201\216\343\202\213 (caro demais) / \350\276\233\343\201\231\343\201\216\343\202\213 (apimentado demais)\\n\342\200\242 Adjetivo-NA: \351\235\231\343\201\213\343\201\231\343\201\216\343\202\213 (calmo/silencioso demais)\',\n    examples: [\n      {\n        jp: \'\345\244\225\351\243\237\343\202\222\351\243\237\343\201\271\343\201\231\343\201\216\343\201\246\343\200\201\343\201\212\350\205\271\343\201\214\347\227\233\343\201\204\343\201\247\343\201\231\343\200\202\',\n        reading: \'\343\202\206\343\201\206\343\201\227\343\202\207\343\201\217 \343\202\222 \343\201\237\343\201\271\343\201\231\343\201\216\343\201\246\343\200\201\343\201\212\343\201\252\343\201\213 \343\201\214 \343\201\204\343\201\237\343\201\204 \343\201\247\343\201\231\343\200\202\',\n        romaji: \'Yuushoku o tabesugite, onaka ga itai desu.\',\n        meaningPt: \'Comi demais no jantar e agora estou com dor de barriga.\'\n      },\n      {\n        jp: \'\343\201\223\343\201\256\345\225\217\351\241\214\343\201\257\351\233\243\343\201\227\343\201\231\343\201\216\343\201\276\343\201\231\343\200\202\',\n        reading: \'\343\201\223\343\201\256 \343\202\202\343\202\223\343\201\240\343\201\204 \343\201\257 \343\202\200\343\201\232\343\201\213\343\201\227\343\201\231\343\201\216\343\201\276\343\201\231\343\200\202\',\n        romaji: \'Kono mondai wa muzukashisugimasu.\',\n        meaningPt: \'Este problema \303\251 dif\303\255cil demais.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n4_7\',\n    pattern: \'Raiz MASU + \343\202\204\343\201\231\343\201\204 / \343\201\253\343\201\217\343\201\204 (~yasui / ~nikui)\',\n    titlePt: \'Facilidade e Dificuldade: \"F\303\241cil / Dif\303\255cil de fazer\"\',\n    jlpt: \'N4\',\n    category: \'Grau & Tend\303\252ncia\',\n    formationFormula: \'[Raiz do Verbo (sem \"masu\")] + \343\202\204\343\201\231\343\201\204 (f\303\241cil) / \343\201\253\343\201\217\343\201\204 (dif\303\255cil)\',\n    explanationPt: \'Comporta-se como um Adjetivo-I ap\303\263s a jun\303\247\303\243o com o verbo.\',\n    keyRulePt: \'\342\200\242 \350\252\255\343\201\277\343\202\204\343\201\231\343\201\204 (f\303\241cil de ler) \342\206\222 \350\252\255\343\201\277\343\202\204\343\201\231\343\201\213\343\201\243\343\201\237 (foi f\303\241cil de ler)\\n\342\200\242 \343\202\217\343\201\213\343\202\212\343\201\253\343\201\217\343\201\204 (dif\303\255cil de entender) \342\206\222 \343\202\217\343\201\213\343\202\212\343\201\253\343\201\217\343\201\213\343\201\243\343\201\237 (foi dif\303\255cil de entender)\',\n    examples: [\n      {\n        jp: \'\343\201\223\343\201\256\343\203\232\343\203\263\343\201\257\343\201\250\343\201\246\343\202\202\346\233\270\343\201\215\343\202\204\343\201\231\343\201\204\343\201\247\343\201\231\343\200\202\',\n        reading: \'\343\201\223\343\201\256 \343\203\232\343\203\263 \343\201\257 \343\201\250\343\201\246\343\202\202 \343\201\213\343\201\215\343\202\204\343\201\231\343\201\204 \343\201\247\343\201\231\343\200\202\',\n        romaji: \'Kono pen wa totemo kakiyasui desu.\',\n        meaningPt: \'Esta caneta \303\251 muito macia / f\303\241cil de escrever.\'\n      },\n      {\n        jp: \'\345\275\274\343\201\256\350\252\254\346\230\216\343\201\257\345\260\221\343\201\227\343\202\217\343\201\213\343\202\212\343\201\253\343\201\217\343\201\204\343\201\247\343\201\231\343\200\202\',\n        reading: \'\343\201\213\343\202\214 \343\201\256 \343\201\233\343\201\244\343\202\201\343\201\204 \343\201\257 \343\201\231\343\201\223\343\201\227 \343\202\217\343\201\213\343\202\212\343\201\253\343\201\217\343\201\204 \343\201\247\343\201\231\343\200\202\',\n        romaji: \'Kare no setsumei wa sukoshi wakarinikui desu.\',\n        meaningPt: \'A explica\303\247\303\243o dele \303\251 um pouco dif\303\255cil de entender.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n4_8\',\n    pattern: \'Verbo (Forma-TE) + \343\201\277\343\201\276\343\201\231 (~te mimasu)\',\n    titlePt: \'Tentativa / Experi\303\252ncia: \"Tentar fazer / Ver no que d\303\241\"\',\n    jlpt: \'N4\',\n    category: \'Tentativa & A\303\247\303\243o\',\n    formationFormula: \'[Verbo na forma-TE] + \343\201\277\343\202\213 / \343\201\277\343\201\276\343\201\231\',\n    explanationPt: \'Expressa a ideia de fazer algo a t\303\255tulo de teste para descobrir como \303\251 ou qual ser\303\241 o resultado.\',\n    keyRulePt: \'Derivado do verbo \350\246\213\343\202\213 (miru - ver/olhar).\',\n    examples: [\n      {\n        jp: \'\343\201\223\343\201\256\351\235\264\343\202\222\345\261\245\343\201\204\343\201\246\343\201\277\343\201\246\343\202\202\343\201\204\343\201\204\343\201\247\343\201\231\343\201\213\343\200\202\',\n        reading: \'\343\201\223\343\201\256 \343\201\217\343\201\244 \343\202\222 \343\201\257\343\201\204\343\201\246\343\201\277\343\201\246\343\202\202 \343\201\204\343\201\204\343\201\247\343\201\231\343\201\213\343\200\202\',\n        romaji: \'Kono kutsu o haite mite mo ii desu ka.\',\n        meaningPt: \'Posso experimentar este cal\303\247ado?\'\n      },\n      {\n        jp: \'\346\226\260\343\201\227\343\201\204\346\226\231\347\220\206\343\202\222\344\275\234\343\201\243\343\201\246\343\201\277\343\201\276\343\201\227\343\201\237\343\200\202\',\n        reading: \'\343\201\202\343\201\237\343\202\211\343\201\227\343\201\204 \343\202\212\343\202\207\343\201\206\343\202\212 \343\202\222 \343\201\244\343\201\217\343\201\243\343\201\246\343\201\277\343\201\276\343\201\227\343\201\237\343\200\202\',\n        romaji: \'Atarashii ryouri o tsukutte mimashita.\',\n        meaningPt: \'Tentei preparar um prato novo.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n4_9\',\n    pattern: \'Verbo (Forma-TE) + \343\201\227\343\201\276\343\201\204\343\201\276\343\201\231 (~te shimaimasu)\',\n    titlePt: \'Conclus\303\243o Total ou Arrependimento: \"Fiz sem querer / Conclu\303\255 tudo\"\',\n    jlpt: \'N4\',\n    category: \'Aspecto Verbal & Emo\303\247\303\243o\',\n    formationFormula: \'[Verbo na forma-TE] + \343\201\227\343\201\276\343\201\206 / \343\201\227\343\201\276\343\201\204\343\201\276\343\201\227\343\201\237\',\n    explanationPt: \'Tem dois sentidos centrais: 1) A\303\247\303\243o completamente finalizada (com foco no t\303\251rmino), 2) Acontecimento indesejado que gera frustra\303\247\303\243o ou remorso.\',\n    keyRulePt: \'Na linguagem coloquial casual torna-se: \343\200\234\343\201\241\343\202\203\343\201\206 (chau) para \343\201\246\343\201\227\343\201\276\343\201\206 e \343\200\234\343\201\230\343\202\203\343\201\206 (jau) para \343\201\247\343\201\227\343\201\276\343\201\206.\\n(ex: \345\277\230\343\202\214\343\201\246\343\201\227\343\201\276\343\201\243\343\201\237 \342\206\222 \345\277\230\343\202\214\343\201\241\343\202\203\343\201\243\343\201\237).\',\n    examples: [\n      {\n        jp: \'\351\233\273\350\273\212\343\201\253\350\262\241\345\270\203\343\202\222\345\277\230\343\202\214\343\201\246\343\201\227\343\201\276\343\201\204\343\201\276\343\201\227\343\201\237\343\200\202\',\n        reading: \'\343\201\247\343\202\223\343\201\227\343\202\203 \343\201\253 \343\201\225\343\201\204\343\201\265 \343\202\222 \343\202\217\343\201\231\343\202\214\343\201\246 \343\201\227\343\201\276\343\201\204\343\201\276\343\201\227\343\201\237\343\200\202\',\n        romaji: \'Densha ni saifu o wasurete shimaimashita.\',\n        meaningPt: \'Esqueci minha carteira no trem (e lamento muito por isso).\'\n      },\n      {\n        jp: \'\345\256\277\351\241\214\343\202\222\345\205\250\351\203\250\343\202\204\343\201\243\343\201\246\343\201\227\343\201\276\343\201\204\343\201\276\343\201\227\343\201\237\343\200\202\',\n        reading: \'\343\201\227\343\202\205\343\201\217\343\201\240\343\201\204 \343\202\222 \343\201\234\343\202\223\343\201\266 \343\202\204\343\201\243\343\201\246 \343\201\227\343\201\276\343\201\204\343\201\276\343\201\227\343\201\237\343\200\202\',\n        romaji: \'Shukudai o zenbu yatte shimaimashita.\',\n        meaningPt: \'Terminei toda a li\303\247\303\243o de casa de uma vez por todas.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n4_10\',\n    pattern: \'Verbo (Forma-TE) + \343\201\212\343\201\215\343\201\276\343\201\231 (~te okimasu)\',\n    titlePt: \'Prepara\303\247\303\243o Antecipada: \"Deixar pronto com anteced\303\252ncia\"\',\n    jlpt: \'N4\',\n    category: \'A\303\247\303\265es Preparat\303\263rias\',\n    formationFormula: \'[Verbo na forma-TE] + \343\201\212\343\201\217 / \343\201\212\343\201\215\343\201\276\343\201\231\',\n    explanationPt: \'Realizar uma a\303\247\303\243o agora para que ela seja \303\272til ou esteja pronta para uma situa\303\247\303\243o futura.\',\n    keyRulePt: \'Na fala casual frequentemente vira \343\200\234\343\201\250\343\201\217 (toku). Exemplo: \350\262\267\343\201\243\343\201\246\343\201\212\343\201\217 \342\206\222 \350\262\267\343\201\243\343\201\250\343\201\217 (kattoku).\',\n    examples: [\n      {\n        jp: \'\346\227\205\350\241\214\343\201\256\345\211\215\343\201\253\343\203\233\343\203\206\343\203\253\343\201\256\344\272\210\347\264\204\343\202\222\343\201\227\343\201\246\343\201\212\343\201\215\343\201\276\343\201\231\343\200\202\',\n        reading: \'\343\202\212\343\202\207\343\201\223\343\201\206 \343\201\256 \343\201\276\343\201\210 \343\201\253 \343\203\233\343\203\206\343\203\253 \343\201\256 \343\202\210\343\202\204\343\201\217 \343\202\222 \343\201\227\343\201\246 \343\201\212\343\201\215\343\201\276\343\201\231\343\200\202\',\n        romaji: \'Ryokou no mae ni hoteru no yoyaku o shite okimasu.\',\n        meaningPt: \'Vou deixar o hotel reservado com anteced\303\252ncia antes da viagem.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n4_11\',\n    pattern: \'A\303\247\303\265es de Dar e Receber Favor (\343\200\234\343\201\246\343\201\202\343\201\222\343\202\213, \343\200\234\343\201\246\343\201\217\343\202\214\343\202\213, \343\200\234\343\201\246\343\202\202\343\202\211\343\201\206)\',\n    titlePt: \'O Sistema de Favores e Benef\303\255cios em Japon\303\252s\',\n    jlpt: \'N4\',\n    category: \'Dar & Receber\',\n    formationFormula: \'[Verbo na forma-TE] + \343\201\202\343\201\222\343\202\213 (eu fa\303\247o para outro) / \343\201\217\343\202\214\343\202\213 (algu\303\251m faz para mim) / \343\202\202\343\202\211\343\201\206 (eu recebo a gentileza de algu\303\251m)\',\n    explanationPt: \'Em japon\303\252s \303\251 fundamental explicitar a dire\303\247\303\243o da gentileza e o sentimento de gratid\303\243o em rela\303\247\303\243o a quem realizou o favor.\',\n    keyRulePt: \'\342\200\242 \343\200\234\343\201\246\343\201\202\343\201\222\343\202\213: Eu ou algu\303\251m do meu grupo faz em benef\303\255cio de outro.\\n\342\200\242 \343\200\234\343\201\246\343\201\217\343\202\214\343\202\213: Algu\303\251m faz espontaneamente em meu benef\303\255cio (sou o recebedor).\\n\342\200\242 \343\200\234\343\201\246\343\202\202\343\202\211\343\201\206: Eu solicito/recebo a a\303\247\303\243o de outra pessoa (marcada por \343\201\253).\',\n    examples: [\n      {\n        jp: \'\345\217\213\351\201\224\343\201\214\346\227\245\346\234\254\350\252\236\343\202\222\346\225\231\343\201\210\343\201\246\343\201\217\343\202\214\343\201\276\343\201\227\343\201\237\343\200\202\',\n        reading: \'\343\201\250\343\202\202\343\201\240\343\201\241 \343\201\214 \343\201\253\343\201\273\343\202\223\343\201\224 \343\202\222 \343\201\212\343\201\227\343\201\210\343\201\246 \343\201\217\343\202\214\343\201\276\343\201\227\343\201\237\343\200\202\',\n        romaji: \'Tomodachi ga nihongo o oshiete kuremashita.\',\n        meaningPt: \'Meu amigo me ensinou japon\303\252s (fez esse favor para mim).\'\n      },\n      {\n        jp: \'\345\205\210\347\224\237\343\201\253\346\216\250\350\226\246\347\212\266\343\202\222\346\233\270\343\201\204\343\201\246\343\202\202\343\202\211\343\201\204\343\201\276\343\201\227\343\201\237\343\200\202\',\n        reading: \'\343\201\233\343\202\223\343\201\233\343\201\204 \343\201\253 \343\201\231\343\201\204\343\201\233\343\202\223\343\201\230\343\202\207\343\201\206 \343\202\222 \343\201\213\343\201\204\343\201\246 \343\202\202\343\202\211\343\201\204\343\201\276\343\201\227\343\201\237\343\200\202\',\n        romaji: \'Sensei ni suisenjou o kaite moraimashita.\',\n        meaningPt: \'Recebi do professor a gentileza de escrever a carta de recomenda\303\247\303\243o.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n4_12\',\n    pattern: \'Voz Passiva (\343\200\234\343\202\214\343\202\213 / \343\200\234\343\202\211\343\202\214\343\202\213)\',\n    titlePt: \'Voz Passiva: \"Ser feito por algu\303\251m\"\',\n    jlpt: \'N4\',\n    category: \'Vozes Verbais\',\n    formationFormula: \'Godan: troca \"u\" por \"a\" + \343\202\214\343\202\213 (\346\233\270\343\201\217 \342\206\222 \346\233\270\343\201\213\343\202\214\343\202\213) | Ichidan: tira \343\202\213 + \343\202\211\343\202\214\343\202\213 (\350\244\222\343\202\201\343\202\213 \342\206\222 \350\244\222\343\202\201\343\202\211\343\202\214\343\202\213) | Irregulares: \343\201\231\343\202\213 \342\206\222 \343\201\225\343\202\214\343\202\213 / \346\235\245\343\202\213 \342\206\222 \343\201\223\343\202\211\343\202\214\343\202\213\',\n    explanationPt: \'Expressa que o sujeito sofre a a\303\247\303\243o praticada por um agente (marcado pela part\303\255cula \343\201\253). Al\303\251m da passiva neutra, em japon\303\252s existe a famosa \"Passiva de Afli\303\247\303\243o / Infort\303\272nio\" (Miwaku Ukemi), onde a a\303\247\303\243o de algu\303\251m incomodou o sujeito.\',\n    keyRulePt: \'\342\200\242 Exemplo de Passiva de Infort\303\272nio: \351\233\250\343\201\253\351\231\215\343\202\211\343\202\214\343\201\237 (Fui pego pela chuva / A chuva me prejudicou).\',\n    examples: [\n      {\n        jp: \'\345\205\210\347\224\237\343\201\253\350\244\222\343\202\201\343\202\211\343\202\214\343\201\276\343\201\227\343\201\237\343\200\202\',\n        reading: \'\343\201\233\343\202\223\343\201\233\343\201\204 \343\201\253 \343\201\273\343\202\201\343\202\211\343\202\214\343\201\276\343\201\227\343\201\237\343\200\202\',\n        romaji: \'Sensei ni homeraremashita.\',\n        meaningPt: \'Fui elogiado pelo professor.\'\n      },\n      {\n        jp: \'\346\263\245\346\243\222\343\201\253\350\207\252\350\273\242\350\273\212\343\202\222\347\233\227\343\201\276\343\202\214\343\201\276\343\201\227\343\201\237\343\200\202\',\n        reading: \'\343\201\251\343\202\215\343\201\274\343\201\206 \343\201\253 \343\201\230\343\201\246\343\202\223\343\201\227\343\202\203 \343\202\222 \343\201\254\343\201\231\343\201\276\343\202\214\343\201\276\343\201\227\343\201\237\343\200\202\',\n        romaji: \'Dorobou ni jitensha o nusumaremashita.\',\n        meaningPt: \'Tive minha bicicleta roubada por um ladr\303\243o.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n4_13\',\n    pattern: \'Voz Causativa (\343\200\234\343\201\233\343\202\213 / \343\200\234\343\201\225\343\201\233\343\202\213)\',\n    titlePt: \'Voz Causativa: \"Fazer ou Deixar algu\303\251m fazer algo\"\',\n    jlpt: \'N4\',\n    category: \'Vozes Verbais\',\n    formationFormula: \'Godan: troca \"u\" por \"a\" + \343\201\233\343\202\213 (\351\243\262\343\201\276\343\201\233\343\202\213) | Ichidan: tira \343\202\213 + \343\201\225\343\201\233\343\202\213 (\351\243\237\343\201\271\343\201\225\343\201\233\343\202\213) | Irregulares: \343\201\225\343\201\233\343\202\213 / \343\201\223\343\201\225\343\201\233\343\202\213\',\n    explanationPt: \'Expressa coer\303\247\303\243o (\"mandar/fazer algu\303\251m executar\") ou permiss\303\243o (\"permitir/deixar algu\303\251m fazer\").\',\n    keyRulePt: \'Ao combinar causativa com passiva surge a Causativa-Passiva (\343\200\234\343\201\225\343\201\233\343\202\211\343\202\214\343\202\213 = \"ser for\303\247ado a fazer contra a vontade\").\',\n    examples: [\n      {\n        jp: \'\346\257\215\343\201\257\345\255\220\344\276\233\343\201\253\351\207\216\350\217\234\343\202\222\351\243\237\343\201\271\343\201\225\343\201\233\343\201\276\343\201\231\343\200\202\',\n        reading: \'\343\201\257\343\201\257 \343\201\257 \343\201\223\343\201\251\343\202\202 \343\201\253 \343\202\204\343\201\225\343\201\204 \343\202\222 \343\201\237\343\201\271\343\201\225\343\201\233\343\201\276\343\201\231\343\200\202\',\n        romaji: \'Haha wa kodomo ni yasai o tabesasemasu.\',\n        meaningPt: \'A m\303\243e faz o filho comer vegetais.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n4_14\',\n    pattern: \'Verbo (Potencial) + \343\202\210\343\201\206\343\201\253\343\201\252\343\202\213 / \343\202\210\343\201\206\343\201\253\343\201\231\343\202\213 (~you ni naru / you ni suru)\',\n    titlePt: \'Mudan\303\247a de Habilidade & Esfor\303\247o Cont\303\255nuo\',\n    jlpt: \'N4\',\n    category: \'Evolu\303\247\303\243o & H\303\241bitos\',\n    formationFormula: \'[Verbo na forma Dicion\303\241rio / Potencial] + \343\202\210\343\201\206\343\201\253\343\201\252\343\202\213 (mudan\303\247a que ocorreu) / \343\202\210\343\201\206\343\201\253\343\201\231\343\202\213 (esfor\303\247ar-se ativamente para)\',\n    explanationPt: \'Distin\303\247\303\243o crucial para o JLPT N4:\\n\342\200\242 \343\200\234\343\202\210\343\201\206\343\201\253\343\201\252\343\202\213: Passou a conseguir fazer (transforma\303\247\303\243o gradual).\\n\342\200\242 \343\200\234\343\202\210\343\201\206\343\201\253\343\201\231\343\202\213: Ter o h\303\241bito consciente de se esfor\303\247ar para fazer algo.\',\n    keyRulePt: \'Muito cobrado na interpreta\303\247\303\243o de textos do JLPT N4.\',\n    examples: [\n      {\n        jp: \'\346\227\245\346\234\254\350\252\236\343\201\256\346\226\260\350\201\236\343\201\214\350\252\255\343\202\201\343\202\213\343\202\210\343\201\206\343\201\253\343\201\252\343\202\212\343\201\276\343\201\227\343\201\237\343\200\202\',\n        reading: \'\343\201\253\343\201\273\343\202\223\343\201\224 \343\201\256 \343\201\227\343\202\223\343\201\266\343\202\223 \343\201\214 \343\202\210\343\202\201\343\202\213 \343\202\210\343\201\206 \343\201\253 \343\201\252\343\202\212\343\201\276\343\201\227\343\201\237\343\200\202\',\n        romaji: \'Nihongo no shinbun ga yomeru you ni narimashita.\',\n        meaningPt: \'Passei a conseguir ler jornais em japon\303\252s.\'\n      },\n      {\n        jp: \'\346\257\216\346\227\245\351\207\216\350\217\234\343\202\222\343\201\237\343\201\217\343\201\225\343\202\223\351\243\237\343\201\271\343\202\213\343\202\210\343\201\206\343\201\253\343\201\227\343\201\246\343\201\204\343\201\276\343\201\231\343\200\202\',\n        reading: \'\343\201\276\343\201\204\343\201\253\343\201\241 \343\202\204\343\201\225\343\201\204 \343\202\222 \343\201\237\343\201\217\343\201\225\343\202\223 \343\201\237\343\201\271\343\202\213 \343\202\210\343\201\206 \343\201\253 \343\201\227\343\201\246\343\201\204\343\201\276\343\201\231\343\200\202\',\n        romaji: \'Mainichi yasai o takusan taberu you ni shite imasu.\',\n        meaningPt: \'Estou me esfor\303\247ando para comer bastante verduras todos os dias.\'\n      }\n    ]\n  },\n  {\n    id: \'g_n4_15\',\n    pattern: \'\343\200\234\343\201\213\343\202\202\343\201\227\343\202\214\343\201\252\343\201\204 (~kamoshirenai)\',\n    titlePt: \'Possibilidade / Hip\303\263tese: \"Talvez / \303\211 poss\303\255vel que...\"\',\n    jlpt: \'N4\',\n    category: \'Probabilidade & Suposi\303\247\303\243o\',\n    formationFormula: \'[Forma Simples (sem \343\201\240 para Adj-NA e Substantivo)] + \343\201\213\343\202\202\343\201\227\343\202\214\343\201\276\343\201\233\343\202\223\',\n    explanationPt: \'Expressa uma probabilidade de aproximadamente 50% ou menos de algo ocorrer. Menos certo que \343\201\247\343\201\227\343\202\207\343\201\206 / \343\201\240\343\202\215\343\201\206.\',\n    keyRulePt: \'Na fala casual vira \343\201\213\343\202\202 (kamo). Ex: \351\233\250\343\201\213\343\202\202 (Talvez chova).\',\n    examples: [\n      {\n        jp: \'\345\215\210\345\276\214\343\201\213\343\202\211\351\233\250\343\201\214\351\231\215\343\202\213\343\201\213\343\202\202\343\201\227\343\202\214\343\201\276\343\201\233\343\202\223\343\200\202\',\n        reading: \'\343\201\224\343\201\224 \343\201\213\343\202\211 \343\201\202\343\202\201 \343\201\214 \343\201\265\343\202\213 \343\201\213\343\202\202\343\201\227\343\202\214\343\201\276\343\201\233\343\202\223\343\200\202\',\n        romaji: \'Gogo kara ame ga furu kamoshiremasen.\',\n        meaningPt: \'Talvez chova a partir da tarde.\'\n      }\n    ]\n  }\n];\n"
    }
