    replacement_chunks {
      replacement_content: "import { SentenceChallenge } from \'../types\';\n\nexport const SENTENCE_CHALLENGES: SentenceChallenge[] = [\n  // ===================== N5 SENTENCES =====================\n  {\n    id: \'s_1\',\n    jlpt: \'N5\',\n    meaningPt: \'Eu bebo \303\241gua todos os dias.\',\n    fullJp: \'\347\247\201\343\201\257\346\257\216\346\227\245\346\260\264\343\202\222\351\243\262\343\201\277\343\201\276\343\201\231\343\200\202\',\n    fullReading: \'\343\202\217\343\201\237\343\201\227\343\201\257 \343\201\276\343\201\204\343\201\253\343\201\241 \343\201\277\343\201\232\343\202\222 \343\201\256\343\201\277\343\201\276\343\201\231\343\200\202\',\n    fullRomaji: \'Watashi wa mainichi mizu o nomimasu.\',\n    parts: [\'\347\247\201\343\201\257\', \'\346\257\216\346\227\245\', \'\346\260\264\343\202\222\', \'\351\243\262\343\201\277\343\201\276\343\201\231\'],\n    correctOrder: [\'\347\247\201\343\201\257\', \'\346\257\216\346\227\245\', \'\346\260\264\343\202\222\', \'\351\243\262\343\201\277\343\201\276\343\201\231\'],\n    grammarHintPt: \'T\303\263pico (\347\247\201 + \343\201\257) \342\236\224 Adv\303\251rbio de tempo (\346\257\216\346\227\245) \342\236\224 Objeto (\346\260\264 + \343\202\222) \342\236\224 Verbo no final (\351\243\262\343\201\277\343\201\276\343\201\231)\'\n  },\n  {\n    id: \'s_2\',\n    jlpt: \'N5\',\n    meaningPt: \'Por favor, espere um pouco.\',\n    fullJp: \'\343\201\241\343\202\207\343\201\243\343\201\250\345\276\205\343\201\243\343\201\246\343\201\217\343\201\240\343\201\225\343\201\204\343\200\202\',\n    fullReading: \'\343\201\241\343\202\207\343\201\243\343\201\250 \343\201\276\343\201\243\343\201\246\343\201\217\343\201\240\343\201\225\343\201\204\343\200\202\',\n    fullRomaji: \'Chotto matte kudasai.\',\n    parts: [\'\343\201\241\343\202\207\343\201\243\343\201\250\', \'\345\276\205\343\201\243\343\201\246\', \'\343\201\217\343\201\240\343\201\225\343\201\204\'],\n    correctOrder: [\'\343\201\241\343\202\207\343\201\243\343\201\250\', \'\345\276\205\343\201\243\343\201\246\', \'\343\201\217\343\201\240\343\201\225\343\201\204\'],\n    grammarHintPt: \'Adv\303\251rbio (\343\201\241\343\202\207\343\201\243\343\201\250) \342\236\224 Verbo na forma-te (\345\276\205\343\201\243\343\201\246) \342\236\224 \343\201\217\343\201\240\343\201\225\343\201\204\'\n  },\n  {\n    id: \'s_3\',\n    jlpt: \'N5\',\n    meaningPt: \'Eu vou para o Jap\303\243o amanh\303\243.\',\n    fullJp: \'\346\230\216\346\227\245\346\227\245\346\234\254\343\201\270\350\241\214\343\201\215\343\201\276\343\201\231\343\200\202\',\n    fullReading: \'\343\201\202\343\201\227\343\201\237 \343\201\253\343\201\273\343\202\223\343\201\270 \343\201\204\343\201\215\343\201\276\343\201\231\343\200\202\',\n    fullRomaji: \'Ashita nihon e ikimasu.\',\n    parts: [\'\346\230\216\346\227\245\', \'\346\227\245\346\234\254\343\201\270\', \'\350\241\214\343\201\215\343\201\276\343\201\231\'],\n    correctOrder: [\'\346\230\216\346\227\245\', \'\346\227\245\346\234\254\343\201\270\', \'\350\241\214\343\201\215\343\201\276\343\201\231\'],\n    grammarHintPt: \'Tempo (\346\230\216\346\227\245) \342\236\224 Destino (\346\227\245\346\234\254 + \343\201\270) \342\236\224 Verbo de deslocamento (\350\241\214\343\201\215\343\201\276\343\201\231)\'\n  },\n  {\n    id: \'s_n5_4\',\n    jlpt: \'N5\',\n    meaningPt: \'Posso tirar uma foto aqui?\',\n    fullJp: \'\343\201\223\343\201\223\343\201\247\345\206\231\347\234\237\343\202\222\346\222\256\343\201\243\343\201\246\343\202\202\343\201\204\343\201\204\343\201\247\343\201\231\343\201\213\343\200\202\',\n    fullReading: \'\343\201\223\343\201\223\343\201\247 \343\201\227\343\202\203\343\201\227\343\202\223\343\202\222 \343\201\250\343\201\243\343\201\246\343\202\202 \343\201\204\343\201\204\343\201\247\343\201\231\343\201\213\343\200\202\',\n    fullRomaji: \'Koko de shashin o totte mo ii desu ka.\',\n    parts: [\'\343\201\223\343\201\223\343\201\247\', \'\345\206\231\347\234\237\343\202\222\', \'\346\222\256\343\201\243\343\201\246\343\202\202\', \'\343\201\204\343\201\204\343\201\247\343\201\231\343\201\213\'],\n    correctOrder: [\'\343\201\223\343\201\223\343\201\247\', \'\345\206\231\347\234\237\343\202\222\', \'\346\222\256\343\201\243\343\201\246\343\202\202\', \'\343\201\204\343\201\204\343\201\247\343\201\231\343\201\213\'],\n    grammarHintPt: \'Local de a\303\247\303\243o (\343\201\223\343\201\223\343\201\247) \342\236\224 Objeto (\345\206\231\347\234\237\343\202\222) \342\236\224 Permiss\303\243o (Forma-TE + \343\202\202\343\201\204\343\201\204\343\201\247\343\201\231\343\201\213)\'\n  },\n\n  // ===================== N4 SENTENCES =====================\n  {\n    id: \'s_4\',\n    jlpt: \'N4\',\n    meaningPt: \'Eu tenho que estudar kanji.\',\n    fullJp: \'\346\274\242\345\255\227\343\202\222\345\213\211\345\274\267\343\201\227\343\201\252\343\201\221\343\202\214\343\201\260\343\201\252\343\202\212\343\201\276\343\201\233\343\202\223\343\200\202\',\n    fullReading: \'\343\201\213\343\202\223\343\201\230\343\202\222 \343\201\271\343\202\223\343\201\215\343\202\207\343\201\206 \343\201\227\343\201\252\343\201\221\343\202\214\343\201\260 \343\201\252\343\202\212\343\201\276\343\201\233\343\202\223\343\200\202\',\n    fullRomaji: \'Kanji o benkyou shinakereba narimasen.\',\n    parts: [\'\346\274\242\345\255\227\343\202\222\', \'\345\213\211\345\274\267\', \'\343\201\227\343\201\252\343\201\221\343\202\214\343\201\260\', \'\343\201\252\343\202\212\343\201\276\343\201\233\343\202\223\'],\n    correctOrder: [\'\346\274\242\345\255\227\343\202\222\', \'\345\213\211\345\274\267\', \'\343\201\227\343\201\252\343\201\221\343\202\214\343\201\260\', \'\343\201\252\343\202\212\343\201\276\343\201\233\343\202\223\'],\n    grammarHintPt: \'Objeto (\346\274\242\345\255\227\343\202\222) \342\236\224 Verbo Suru na forma de obriga\303\247\303\243o (~shinakereba narimasen)\'\n  },\n  {\n    id: \'s_5\',\n    jlpt: \'N4\',\n    meaningPt: \'Voc\303\252 j\303\241 comeu sushi?\',\n    fullJp: \'\345\257\277\345\217\270\343\202\222\351\243\237\343\201\271\343\201\237\343\201\223\343\201\250\343\201\214\343\201\202\343\202\212\343\201\276\343\201\231\343\201\213\343\200\202\',\n    fullReading: \'\343\201\231\343\201\227\343\202\222 \343\201\237\343\201\271\343\201\237 \343\201\223\343\201\250\343\201\214 \343\201\202\343\202\212\343\201\276\343\201\231\343\201\213\343\200\202\',\n    fullRomaji: \'Sushi o tabeta koto ga arimasu ka.\',\n    parts: [\'\345\257\277\345\217\270\343\202\222\', \'\351\243\237\343\201\271\343\201\237\', \'\343\201\223\343\201\250\343\201\214\', \'\343\201\202\343\202\212\343\201\276\343\201\231\343\201\213\'],\n    correctOrder: [\'\345\257\277\345\217\270\343\202\222\', \'\351\243\237\343\201\271\343\201\237\', \'\343\201\223\343\201\250\343\201\214\', \'\343\201\202\343\202\212\343\201\276\343\201\231\343\201\213\'],\n    grammarHintPt: \'Objeto (\345\257\277\345\217\270\343\202\222) \342\236\224 Passado informal (\351\243\237\343\201\271\343\201\237) \342\236\224 koto ga arimasu ka\'\n  },\n  {\n    id: \'s_n4_6\',\n    jlpt: \'N4\',\n    meaningPt: \'Pretendo fazer interc\303\242mbio no Jap\303\243o no ano que vem.\',\n    fullJp: \'\346\235\245\345\271\264\346\227\245\346\234\254\343\201\270\347\225\231\345\255\246\343\201\231\343\202\213\343\201\244\343\202\202\343\202\212\343\201\247\343\201\231\343\200\202\',\n    fullReading: \'\343\202\211\343\201\204\343\201\255\343\202\223 \343\201\253\343\201\273\343\202\223\343\201\270 \343\202\212\343\202\205\343\201\206\343\201\214\343\201\217\343\201\231\343\202\213 \343\201\244\343\202\202\343\202\212\343\201\247\343\201\231\343\200\202\',\n    fullRomaji: \'Rainen nihon e ryuugaku suru tsumori desu.\',\n    parts: [\'\346\235\245\345\271\264\', \'\346\227\245\346\234\254\343\201\270\', \'\347\225\231\345\255\246\343\201\231\343\202\213\', \'\343\201\244\343\202\202\343\202\212\343\201\247\343\201\231\'],\n    correctOrder: [\'\346\235\245\345\271\264\', \'\346\227\245\346\234\254\343\201\270\', \'\347\225\231\345\255\246\343\201\231\343\202\213\', \'\343\201\244\343\202\202\343\202\212\343\201\247\343\201\231\'],\n    grammarHintPt: \'Tempo (\346\235\245\345\271\264) \342\236\224 Destino (\346\227\245\346\234\254\343\201\270) \342\236\224 Verbo Dicion\303\241rio (\347\225\231\345\255\246\343\201\231\343\202\213) \342\236\224 \343\201\244\343\202\202\343\202\212\343\201\247\343\201\231\'\n  },\n\n  // ===================== N3 SENTENCES =====================\n  {\n    id: \'s_6\',\n    jlpt: \'N3\',\n    meaningPt: \'Para resolver o problema, \303\251 preciso informa\303\247\303\243o.\',\n    fullJp: \'\345\225\217\351\241\214\343\202\222\350\247\243\346\261\272\343\201\231\343\202\213\343\201\237\343\202\201\343\201\253\346\203\205\345\240\261\343\201\214\345\277\205\350\246\201\343\201\247\343\201\231\343\200\202\',\n    fullReading: \'\343\202\202\343\202\223\343\201\240\343\201\204\343\202\222 \343\201\213\343\201\204\343\201\221\343\201\244\343\201\231\343\202\213\343\201\237\343\202\201\343\201\253 \343\201\230\343\202\207\343\201\206\343\201\273\343\201\206\343\201\214 \343\201\262\343\201\244\343\202\210\343\201\206\343\201\247\343\201\231\343\200\202\',\n    fullRomaji: \'Mondai o kaiketsu suru tame ni jouhou ga hitsuyou desu.\',\n    parts: [\'\345\225\217\351\241\214\343\202\222\', \'\350\247\243\346\261\272\343\201\231\343\202\213\343\201\237\343\202\201\343\201\253\', \'\346\203\205\345\240\261\343\201\214\', \'\345\277\205\350\246\201\343\201\247\343\201\231\'],\n    correctOrder: [\'\345\225\217\351\241\214\343\202\222\', \'\350\247\243\346\261\272\343\201\231\343\202\213\343\201\237\343\202\201\343\201\253\', \'\346\203\205\345\240\261\343\201\214\', \'\345\277\205\350\246\201\343\201\247\343\201\231\'],\n    grammarHintPt: \'Objetivo (~tame ni) \342\236\224 Sujeito com part\303\255cula ga \342\236\224 Hitsuyou desu\'\n  },\n  {\n    id: \'s_n3_7\',\n    jlpt: \'N3\',\n    meaningPt: \'Gra\303\247as ao professor, passei no exame.\',\n    fullJp: \'\345\205\210\347\224\237\343\201\256\343\201\212\343\201\213\343\201\222\343\201\247\350\251\246\351\250\223\343\201\253\345\220\210\346\240\274\343\201\247\343\201\215\343\201\276\343\201\227\343\201\237\343\200\202\',\n    fullReading: \'\343\201\233\343\202\223\343\201\233\343\201\204\343\201\256 \343\201\212\343\201\213\343\201\222\343\201\247 \343\201\227\343\201\221\343\202\223\343\201\253 \343\201\224\343\201\206\343\201\213\343\201\217 \343\201\247\343\201\215\343\201\276\343\201\227\343\201\237\343\200\202\',\n    fullRomaji: \'Sensei no okage de shiken ni goukaku dekimashita.\',\n    parts: [\'\345\205\210\347\224\237\343\201\256\', \'\343\201\212\343\201\213\343\201\222\343\201\247\', \'\350\251\246\351\250\223\343\201\253\', \'\345\220\210\346\240\274\343\201\247\343\201\215\343\201\276\343\201\227\343\201\237\'],\n    correctOrder: [\'\345\205\210\347\224\237\343\201\256\', \'\343\201\212\343\201\213\343\201\222\343\201\247\', \'\350\251\246\351\250\223\343\201\253\', \'\345\220\210\346\240\274\343\201\247\343\201\215\343\201\276\343\201\227\343\201\237\'],\n    grammarHintPt: \'Gratid\303\243o por causa ben\303\251fica (~no okage de) \342\236\224 Alvo do exame (\350\251\246\351\250\223\343\201\253) \342\236\224 Forma potencial passada\'\n  },\n  {\n    id: \'s_n3_8\',\n    jlpt: \'N3\',\n    meaningPt: \'Por favor, coma enquanto a comida ainda est\303\241 quente.\',\n    fullJp: \'\346\226\231\347\220\206\343\201\214\346\270\251\343\201\213\343\201\204\343\201\206\343\201\241\343\201\253\351\243\237\343\201\271\343\201\246\343\201\217\343\201\240\343\201\225\343\201\204\343\200\202\',\n    fullReading: \'\343\202\212\343\202\207\343\201\206\343\202\212\343\201\214 \343\201\202\343\201\237\343\201\237\343\201\213\343\201\204\343\201\206\343\201\241\343\201\253 \343\201\237\343\201\271\343\201\246\343\201\217\343\201\240\343\201\225\343\201\204\343\200\202\',\n    fullRomaji: \'Ryouri ga atatakai uchi ni tabete kudasai.\',\n    parts: [\'\346\226\231\347\220\206\343\201\214\', \'\346\270\251\343\201\213\343\201\204\', \'\343\201\206\343\201\241\343\201\253\', \'\351\243\237\343\201\271\343\201\246\343\201\217\343\201\240\343\201\225\343\201\204\'],\n    correctOrder: [\'\346\226\231\347\220\206\343\201\214\', \'\346\270\251\343\201\213\343\201\204\', \'\343\201\206\343\201\241\343\201\253\', \'\351\243\237\343\201\271\343\201\246\343\201\217\343\201\240\343\201\225\343\201\204\'],\n    grammarHintPt: \'Sujeito (\346\226\231\347\220\206\343\201\214) \342\236\224 Estado favor\303\241vel com Adjetivo-I + \343\201\206\343\201\241\343\201\253 \342\236\224 Pedido (\351\243\237\343\201\271\343\201\246\343\201\217\343\201\240\343\201\225\343\201\204)\'\n  }\n];\n"
