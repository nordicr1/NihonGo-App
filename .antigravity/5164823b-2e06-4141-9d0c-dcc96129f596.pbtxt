          text: "    formationFormula: \'[Substantivo A] + \343\201\257 (l\303\252-se \"wa\") + [Substantivo / Adjetivo B] + \343\201\247\343\201\231\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanationPt: \'A part\303\255cula \343\201\257 (escrita como \"ha\", mas pronunciada \"wa\") indica o T\303\263pico da frase (aquilo sobre o qual estamos falando). O termo \343\201\247\343\201\231 (desu) \303\251 a c\303\263pula formal que equivale a \"\303\251 / sou / somos\".\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    keyRulePt: \'\342\200\242 Forma Negativa: A \343\201\257 B \343\201\247\343\201\257\343\201\202\343\202\212\343\201\276\343\201\233\343\202\223 (dewa arimasen) ou \343\201\230\343\202\203\343\201\202\343\202\212\343\201\276\343\201\233\343\202\223 (ja arimasen).\\n\342\200\242 Forma Interrogativa: basta acrescentar a part\303\255cula \343\201\213 (ka) no final da frase sem ponto de interroga\303\247\303\243o.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
