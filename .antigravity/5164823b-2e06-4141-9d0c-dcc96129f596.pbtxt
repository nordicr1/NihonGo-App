      replacement_content: "import { KanaItem } from \'../types\';\n\nexport const HIRAGANA_DATA: KanaItem[] = [\n  // A-line\n  { id: \'h_a\', char: \'\343\201\202\', romaji: \'a\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Parece a letra \"A\" desenhada com uma ma\303\247\303\243.\', exampleWord: \'\343\201\202\343\201\225\', exampleReading: \'asa\', exampleMeaningPt: \'Manh\303\243\' },\n  { id: \'h_i\', char: \'\343\201\204\', romaji: \'i\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Duas linhas paralelas como dois dedos indicadores (I).\', exampleWord: \'\343\201\204\343\201\254\', exampleReading: \'inu\', exampleMeaningPt: \'Cachorro\' },\n  { id: \'h_u\', char: \'\343\201\206\', romaji: \'u\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Uma pessoa curvada carregando algo pesado dizendo \"Uff\".\', exampleWord: \'\343\201\206\343\201\277\', exampleReading: \'umi\', exampleMeaningPt: \'Mar / Oceano\' },\n  { id: \'h_e\', char: \'\343\201\210\', romaji: \'e\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Parece um atleta correndo com energia.\', exampleWord: \'\343\201\210\343\201\215\', exampleReading: \'eki\', exampleMeaningPt: \'Esta\303\247\303\243o de trem\' },\n  { id: \'h_o\', char: \'\343\201\212\', romaji: \'o\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Uma bola de golfe entrando no buraco circular (O).\', exampleWord: \'\343\201\212\350\214\266\', exampleReading: \'ocha\', exampleMeaningPt: \'Ch\303\241 verde\' },\n\n  // Ka-line\n  { id: \'h_ka\', char: \'\343\201\213\', romaji: \'ka\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Uma pessoa dan\303\247ando e chutando com for\303\247a.\', exampleWord: \'\343\201\213\343\202\217\', exampleReading: \'kawa\', exampleMeaningPt: \'Rio\' },\n  { id: \'h_ki\', char: \'\343\201\215\', romaji: \'ki\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Uma chave antiga desenhada (\"key\").\', exampleWord: \'\343\201\215\343\201\256\343\201\206\', exampleReading: \'kinou\', exampleMeaningPt: \'Ontem\' },\n  { id: \'h_ku\', char: \'\343\201\217\', romaji: \'ku\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Bico aberto de um p\303\241ssaro (\"Kuku!\").\', exampleWord: \'\343\201\217\343\202\213\343\201\276\', exampleReading: \'kuruma\', exampleMeaningPt: \'Carro\' },\n  { id: \'h_ke\', char: \'\343\201\221\', romaji: \'ke\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Um barril de chopp (\"keg\") visto de lado.\', exampleWord: \'\343\201\221\343\201\225\', exampleReading: \'kesa\', exampleMeaningPt: \'Esta manh\303\243\' },\n  { id: \'h_ko\', char: \'\343\201\223\', romaji: \'ko\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Dois tra\303\247os horizontais como uma cobra enrolada.\', exampleWord: \'\343\201\223\343\201\251\343\202\202\', exampleReading: \'kodomo\', exampleMeaningPt: \'Crian\303\247a\' },\n\n  // Sa-line\n  { id: \'h_sa\', char: \'\343\201\225\', romaji: \'sa\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Pessoa inclinada servindo saqu\303\252.\', exampleWord: \'\343\201\225\343\201\217\343\202\211\', exampleReading: \'sakura\', exampleMeaningPt: \'Flor de cerejeira\' },\n  { id: \'h_shi\', char: \'\343\201\227\', romaji: \'shi\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Um anzol de pescar mergulhado na \303\241gua.\', exampleWord: \'\343\201\227\343\202\215\', exampleReading: \'shiro\', exampleMeaningPt: \'Branco / Castelo\' },\n  { id: \'h_su\', char: \'\343\201\231\', romaji: \'su\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Um canudo dando um la\303\247o dentro de um suco.\', exampleWord: \'\343\201\231\343\201\227\', exampleReading: \'sushi\', exampleMeaningPt: \'Sushi\' },\n  { id: \'h_se\', char: \'\343\201\233\', romaji: \'se\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Pessoas sentadas lado a lado conversando.\', exampleWord: \'\343\201\233\343\202\223\343\201\233\343\201\204\', exampleReading: \'sensei\', exampleMeaningPt: \'Professor / Mestre\' },\n  { id: \'h_so\', char: \'\343\201\235\', romaji: \'so\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Linha em zigue-zague de costura (\"sew\").\', exampleWord: \'\343\201\235\343\202\211\', exampleReading: \'sora\', exampleMeaningPt: \'C\303\251u\' },\n\n  // Ta-line\n  { id: \'h_ta\', char: \'\343\201\237\', romaji: \'ta\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Letras \"t\" e \"a\" entrela\303\247adas.\', exampleWord: \'\343\201\237\343\201\271\343\202\213\', exampleReading: \'taberu\', exampleMeaningPt: \'Comer\' },\n  { id: \'h_chi\', char: \'\343\201\241\', romaji: \'chi\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Uma l\303\255der de torcida (\"cheerleader\") pulando.\', exampleWord: \'\343\201\241\343\201\232\', exampleReading: \'chizu\', exampleMeaningPt: \'Mapa\' },\n  { id: \'h_tsu\', char: \'\343\201\244\', romaji: \'tsu\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Uma onda curva de um Tsunami gigante.\', exampleWord: \'\343\201\244\343\201\215\', exampleReading: \'tsuki\', exampleMeaningPt: \'Lua / M\303\252s\' },\n  { id: \'h_te\', char: \'\343\201\246\', romaji: \'te\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Um bra\303\247o estendido com a m\303\243o (\"te\" significa m\303\243o).\', exampleWord: \'\343\201\246\343\202\223\343\201\215\', exampleReading: \'tenki\', exampleMeaningPt: \'Clima / Tempo\' },\n  { id: \'h_to\', char: \'\343\201\250\', romaji: \'to\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Um dedo com uma farpa espetada.\', exampleWord: \'\343\201\250\343\202\202\343\201\240\343\201\241\', exampleReading: \'tomodachi\', exampleMeaningPt: \'Amigo\' },\n\n  // Na-line\n  { id: \'h_na\', char: \'\343\201\252\', romaji: \'na\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Uma freira orando ajoelhada diante da cruz.\', exampleWord: \'\343\201\252\343\201\244\', exampleReading: \'natsu\', exampleMeaningPt: \'Ver\303\243o\' },\n  { id: \'h_ni\', char: \'\343\201\253\', romaji: \'ni\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Agulha e linha costurando.\', exampleWord: \'\343\201\253\343\201\273\343\202\223\', exampleReading: \'nihon\', exampleMeaningPt: \'Jap\303\243o\' },\n  { id: \'h_nu\', char: \'\343\201\254\', romaji: \'nu\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Macarr\303\243o noodles enrolado no hashi com la\303\247o.\', exampleWord: \'\343\201\254\343\201\276\', exampleReading: \'numa\', exampleMeaningPt: \'P\303\242ntano\' },\n  { id: \'h_ne\', char: \'\343\201\255\', romaji: \'ne\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Um gatinho (\"neko\") com o rabinho enrolado.\', exampleWord: \'\343\201\255\343\201\223\', exampleReading: \'neko\', exampleMeaningPt: \'Gato\' },\n  { id: \'h_no\', char: \'\343\201\256\', romaji: \'no\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Placa circular de proibido (\"NO\").\', exampleWord: \'\343\201\256\343\201\277\343\202\202\343\201\256\', exampleReading: \'nomimono\', exampleMeaningPt: \'Bebida\' },\n\n  // Ha-line\n  { id: \'h_ha\', char: \'\343\201\257\', romaji: \'ha\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Homem em p\303\251 rindo \"Ha Ha Ha\".\', exampleWord: \'\343\201\257\343\201\252\', exampleReading: \'hana\', exampleMeaningPt: \'Flor / Nariz\' },\n  { id: \'h_hi\', char: \'\343\201\262\', romaji: \'hi\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Um grande sorriso dizendo \"Hi!\".\', exampleWord: \'\343\201\262\343\201\250\', exampleReading: \'hito\', exampleMeaningPt: \'Pessoa\' },\n  { id: \'h_fu\', char: \'\343\201\265\', romaji: \'fu\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Monte Fuji com nuvens ao redor.\', exampleWord: \'\343\201\265\343\202\206\', exampleReading: \'fuyu\', exampleMeaningPt: \'Inverno\' },\n  { id: \'h_he\', char: \'\343\201\270\', romaji: \'he\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'A ponta de uma montanha subindo e descendo.\', exampleWord: \'\343\201\270\343\202\204\', exampleReading: \'heya\', exampleMeaningPt: \'Quarto / Sala\' },\n  { id: \'h_ho\', char: \'\343\201\273\', romaji: \'ho\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Papai Noel com seu chap\303\251u dizendo \"Ho Ho Ho\".\', exampleWord: \'\343\201\273\343\202\223\', exampleReading: \'hon\', exampleMeaningPt: \'Livro\' },\n\n  // Ma-line\n  { id: \'h_ma\', char: \'\343\201\276\', romaji: \'ma\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Uma m\303\241scara com duas tiras de amarra\303\247\303\243o.\', exampleWord: \'\343\201\276\343\201\241\', exampleReading: \'machi\', exampleMeaningPt: \'Cidade / Bairro\' },\n  { id: \'h_mi\', char: \'\343\201\277\', romaji: \'mi\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'O n\303\272mero 21 desenhado com fluidez.\', exampleWord: \'\343\201\277\343\201\232\', exampleReading: \'mizu\', exampleMeaningPt: \'\303\201gua\' },\n  { id: \'h_mu\', char: \'\343\202\200\', romaji: \'mu\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Vaca pastando e fazendo \"Muuu\".\', exampleWord: \'\343\202\200\343\201\227\', exampleReading: \'mushi\', exampleMeaningPt: \'Inseto\' },\n  { id: \'h_me\', char: \'\343\202\201\', romaji: \'me\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Um olho estilizado (\"me\" em japon\303\252s \303\251 olho).\', exampleWord: \'\343\202\201\', exampleReading: \'me\', exampleMeaningPt: \'Olho\' },\n  { id: \'h_mo\', char: \'\343\202\202\', romaji: \'mo\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Um anzol pescando mais minhocas (\"more\").\', exampleWord: \'\343\202\202\343\202\212\', exampleReading: \'mori\', exampleMeaningPt: \'Floresta\' },\n\n  // Ya-line\n  { id: \'h_ya\', char: \'\343\202\204\', romaji: \'ya\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Um iaque peludo com chifres compridos.\', exampleWord: \'\343\202\204\343\201\276\', exampleReading: \'yama\', exampleMeaningPt: \'Montanha\' },\n  { id: \'h_yu\', char: \'\343\202\206\', romaji: \'yu\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Um peixe dourado nadando graciosamente.\', exampleWord: \'\343\202\206\343\201\215\', exampleReading: \'yuki\', exampleMeaningPt: \'Neve\' },\n  { id: \'h_yo\', char: \'\343\202\210\', romaji: \'yo\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Um ioi\303\264 pendurado na corda.\', exampleWord: \'\343\202\210\343\202\213\', exampleReading: \'yoru\', exampleMeaningPt: \'Noite\' },\n\n  // Ra-line\n  { id: \'h_ra\', char: \'\343\202\211\', romaji: \'ra\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Um camelo com corcova (\"r\303\241\").\', exampleWord: \'\343\202\211\343\201\204\343\201\227\343\202\205\343\201\206\', exampleReading: \'raishuu\', exampleMeaningPt: \'Pr\303\263xima semana\' },\n  { id: \'h_ri\', char: \'\343\202\212\', romaji: \'ri\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Fitas de seda esvoa\303\247antes (\"ribbon\").\', exampleWord: \'\343\202\212\343\202\223\343\201\224\', exampleReading: \'ringo\', exampleMeaningPt: \'Ma\303\247\303\243\' },\n  { id: \'h_ru\', char: \'\343\202\213\', romaji: \'ru\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'N\303\272mero 3 segurando uma moeda de um rublo.\', exampleWord: \'\343\202\213\343\201\231\', exampleReading: \'rusu\', exampleMeaningPt: \'Aus\303\252ncia de casa\' },\n  { id: \'h_re\', char: \'\343\202\214\', romaji: \'re\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Uma pessoa correndo (\"relay race\").\', exampleWord: \'\343\202\214\343\202\223\343\201\227\343\202\205\343\201\206\', exampleReading: \'renshuu\', exampleMeaningPt: \'Treino / Pr\303\241tica\' },\n  { id: \'h_ro\', char: \'\343\202\215\', romaji: \'ro\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'O n\303\272mero 3 aberto (sem o la\303\247o do ru).\', exampleWord: \'\343\202\215\343\201\206\343\201\235\343\201\217\', exampleReading: \'rousoku\', exampleMeaningPt: \'Vela\' },\n\n  // Wa, Wo, N\n  { id: \'h_wa\', char: \'\343\202\217\', romaji: \'wa\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Um cisne branco com pesco\303\247o curvado.\', exampleWord: \'\343\202\217\343\201\237\343\201\227\', exampleReading: \'watashi\', exampleMeaningPt: \'Eu\' },\n  { id: \'h_wo\', char: \'\343\202\222\', romaji: \'wo (o)\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'Pessoa saltando comemorando \"Wohoo!\" (part\303\255cula de objeto).\', exampleWord: \'\346\234\254\343\202\222\343\202\210\343\202\200\', exampleReading: \'hon o yomu\', exampleMeaningPt: \'Ler o livro\' },\n  { id: \'h_n\', char: \'\343\202\223\', romaji: \'n\', type: \'hiragana\', category: \'gojuon\', mnemonicPt: \'A letra min\303\272scula \"n\" escrita em cursiva.\', exampleWord: \'\343\201\212\343\202\223\343\201\214\343\201\217\', exampleReading: \'ongaku\', exampleMeaningPt: \'M\303\272sica\' },\n\n  // Dakuon (Ga, Za, Da, Ba)\n  { id: \'h_ga\', char: \'\343\201\214\', romaji: \'ga\', type: \'hiragana\', category: \'dakuon\', mnemonicPt: \'\343\201\213 com dakuten (aspas)\', exampleWord: \'\343\201\214\343\201\243\343\201\223\343\201\206\', exampleReading: \'gakkou\', exampleMeaningPt: \'Escola\' },\n  { id: \'h_gi\', char: \'\343\201\216\', romaji: \'gi\', type: \'hiragana\', category: \'dakuon\', mnemonicPt: \'\343\201\215 com dakuten\', exampleWord: \'\343\201\216\343\202\223\343\201\223\343\201\206\', exampleReading: \'ginkou\', exampleMeaningPt: \'Banco\' },\n  { id: \'h_gu\', char: \'\343\201\220\', romaji: \'gu\', type: \'hiragana\', category: \'dakuon\', mnemonicPt: \'\343\201\217 com dakuten\', exampleWord: \'\343\201\220\343\201\202\343\201\204\', exampleReading: \'guai\', exampleMeaningPt: \'Condi\303\247\303\243o / Sa\303\272de\' },\n  { id: \'h_ge\', char: \'\343\201\222\', romaji: \'ge\', type: \'hiragana\', catego