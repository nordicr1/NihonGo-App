        }
        lines {
          text: "    explanationPt: \'As part\303\255culas s\303\243o sufixos gramaticais fundamentais no japon\303\252s que conectam palavras e definem seu papel na ora\303\247\303\243o.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    keyRulePt: \'\342\200\242 \343\202\222 (o): Marca o Objeto Direto da a\303\247\303\243o (\346\234\254\343\202\222\350\252\255\343\202\200 - ler livro).\\n\342\200\242 \343\201\253 (ni): Destino exato, tempo pontual (7\346\231\202\343\201\253) ou localiza\303\247\303\243o est\303\241tica (\351\203\250\345\261\213\343\201\253\343\201\204\343\202\213).\\n\342\200\242 \343\201\247 (de): Local de a\303\247\303\243o din\303\242mica (\345\255\246\346\240\241\343\201\247\345\213\211\345\274\267\343\201\231\343\202\213) ou meio/instrumento (\343\203\220\343\202\271\343\201\247\350\241\214\343\201\217).\\n\342\200\242 \343\201\270 (e): Dire\303\247\303\243o geral do movimento (\346\227\245\346\234\254\343\201\270\350\241\214\343\201\217).\\n\342\200\242 \343\201\250 (to): Conjun\303\247\303\243o \"e\" e companhia \"com\" (\345\217\213\351\201\224\343\201\250).\\n\342\200\242 \343\202\202 (mo): \"Tamb\303\251m / Nem\" (substitui \343\201\257, \343\201\214 e \343\202\222).\\n\342\200\242 \343\201\214 (ga): Sujeito ativo ou foco de identifica\303\247\303\243o.\\n\342\200\242 \343\201\213\343\202\211 / \343\201\276\343\201\247 (kara / made): \"De / A partir de\" e \"At\303\251\".\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
