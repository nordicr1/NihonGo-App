        lines {
          text: "    formationFormula: \'Godan: troca \"u\" por \"a\" + \343\202\214\343\202\213 (\346\233\270\343\201\217 \342\206\222 \346\233\270\343\201\213\343\202\214\343\202\213) | Ichidan: tira \343\202\213 + \343\202\211\343\202\214\343\202\213 (\350\244\222\343\202\201\343\202\213 \342\206\222 \350\244\222\343\202\201\343\202\211\343\202\214\343\202\213) | Irregulares: \343\201\231\343\202\213 \342\206\222 \343\201\225\343\202\214\343\202\213 / \346\235\245\343\202\213 \342\206\222 \343\201\223\343\202\211\343\202\214\343\202\213\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanationPt: \'Expressa que o sujeito sofre a a\303\247\303\243o praticada por um agente (marcado pela part\303\255cula \343\201\253). Al\303\251m da passiva neutra, em japon\303\252s existe a famosa \"Passiva de Afli\303\247\303\243o / Infort\303\272nio\" (Miwaku Ukemi), onde a a\303\247\303\243o de algu\303\251m incomodou o sujeito.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
