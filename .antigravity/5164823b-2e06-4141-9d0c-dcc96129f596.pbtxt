    replacement_chunks {
      replacement_content: "import { VocabItem } from \'../types\';\n\nexport const VOCAB_N2_N1: VocabItem[] = [\n  // ================= N2 VOCABULARY =================\n  {\n    id: \'v_n2_1\',\n    word: \'\350\262\277\346\230\223\',\n    reading: \'\343\201\274\343\201\206\343\201\210\343\201\215\',\n    romaji: \'boueki\',\n    meaningPt: \'Com\303\251rcio exterior / Rela\303\247\303\265es comerciais internacionais\',\n    category: \'substantivo\',\n    jlpt: \'N2\',\n    categoryLabelPt: \'Substantivo N2\',\n    exampleSentence: {\n      jp: \'\344\272\214\345\233\275\351\226\223\343\201\256\350\262\277\346\230\223\345\215\224\345\256\232\343\201\214\346\255\243\345\274\217\343\201\253\347\267\240\347\265\220\343\201\225\343\202\214\343\201\276\343\201\227\343\201\237\343\200\202\',\n      reading: \'\343\201\253\343\201\223\343\201\217\343\201\213\343\202\223 \343\201\256 \343\201\274\343\201\206\343\201\210\343\201\215 \343\201\215\343\202\207\343\201\206\343\201\246\343\201\204 \343\201\214 \343\201\233\343\201\204\343\201\227\343\201\215 \343\201\253 \343\201\246\343\201\204\343\201\221\343\201\244 \343\201\225\343\202\214\343\201\276\343\201\227\343\201\237\343\200\202\',\n      romaji: \'Nikokukan no boueki kyoutei ga seishiki ni teiketsu saremashita.\',\n      meaningPt: \'O acordo de com\303\251rcio exterior entre as duas na\303\247\303\265es foi formalmente firmado.\'\n    }\n  },\n  {\n    id: \'v_n2_2\',\n    word: \'\346\206\262\346\263\225\',\n    reading: \'\343\201\221\343\202\223\343\201\275\343\201\206\',\n    romaji: \'kenpou\',\n    meaningPt: \'Constitui\303\247\303\243o nacional / Carta magna\',\n    category: \'substantivo\',\n    jlpt: \'N2\',\n    categoryLabelPt: \'Substantivo N2\',\n    exampleSentence: {\n      jp: \'\346\206\262\346\263\225\346\224\271\346\255\243\343\201\253\343\201\244\343\201\204\343\201\246\343\201\256\350\255\260\350\253\226\343\201\214\346\264\273\347\231\272\343\201\253\350\241\214\343\202\217\343\202\214\343\201\246\343\201\204\343\201\276\343\201\231\343\200\202\',\n      reading: \'\343\201\221\343\202\223\343\201\275\343\201\206 \343\201\213\343\201\204\343\201\233\343\201\204 \343\201\253 \343\201\244\343\201\204\343\201\246 \343\201\256 \343\201\216\343\202\215\343\202\223 \343\201\214 \343\201\213\343\201\243\343\201\261\343\201\244 \343\201\253 \343\201\212\343\201\223\343\201\252\343\202\217\343\202\214\343\201\246 \343\201\204\343\201\276\343\201\231\343\200\202\',\n      romaji: \'Kenpou kaisei ni tsuite no giron ga kappatsu ni okonawarete imasu.\',\n      meaningPt: \'O debate a respeito da emenda constitucional est\303\241 sendo realizado intensamente.\'\n    }\n  },\n  {\n    id: \'v_n2_3\',\n    word: \'\346\212\212\346\217\241\343\201\231\343\202\213\',\n    reading: \'\343\201\257\343\201\202\343\201\217\343\201\231\343\202\213\',\n    romaji: \'haaku suru\',\n    meaningPt: \'Compreender com clareza / Mapear a situa\303\247\303\243o\',\n    category: \'verbo_irregular\',\n    jlpt: \'N2\',\n    categoryLabelPt: \'Verbo Irregular N2\',\n    exampleSentence: {\n      jp: \'\347\217\276\345\240\264\343\201\256\347\212\266\346\263\201\343\202\222\346\255\243\347\242\272\343\201\253\346\212\212\346\217\241\343\201\231\343\202\213\345\277\205\350\246\201\343\201\214\343\201\202\343\202\212\343\201\276\343\201\231\343\200\202\',\n      reading: \'\343\201\222\343\202\223\343\201\260 \343\201\256 \343\201\230\343\202\207\343\201\206\343\201\215\343\202\207\343\201\206 \343\202\222 \343\201\233\343\201\204\343\201\213\343\201\217 \343\201\253 \343\201\257\343\201\202\343\201\217 \343\201\231\343\202\213 \343\201\262\343\201\244\343\202\210\343\201\206 \343\201\214 \343\201\202\343\202\212\343\201\276\343\201\231\343\200\202\',\n      romaji: \'Genba no joukyou o seikaku ni haaku suru hitsuyou ga arimasu.\',\n      meaningPt: \'\303\211 necess\303\241rio compreender com precis\303\243o a situa\303\247\303\243o real no local de trabalho.\'\n    }\n  },\n\n  // ================= N1 VOCABULARY =================\n  {\n    id: \'v_n1_1\',\n    word: \'\346\206\202\351\254\261\',\n    reading: \'\343\202\206\343\201\206\343\201\206\343\201\244\',\n    romaji: \'yuuutsu\',\n    meaningPt: \'Melancolia / Depress\303\243o / Des\303\242nimo profundo\',\n    category: \'adjetivo_na\',\n    jlpt: \'N1\',\n    categoryLabelPt: \'Adjetivo-Na N1\',\n    exampleSentence: {\n      jp: \'\351\233\250\343\201\214\351\231\215\343\202\212\347\266\232\343\201\217\346\227\245\343\201\257\346\206\202\351\254\261\343\201\252\346\260\227\345\210\206\343\201\253\343\201\252\343\202\212\343\202\204\343\201\231\343\201\204\343\200\202\',\n      reading: \'\343\201\202\343\202\201 \343\201\214 \343\201\265\343\202\212\343\201\244\343\201\245\343\201\217 \343\201\262 \343\201\257 \343\202\206\343\201\206\343\201\206\343\201\244 \343\201\252 \343\201\215\343\201\266\343\202\223 \343\201\253 \343\201\252\343\202\212\343\202\204\343\201\231\343\201\204\343\200\202\',\n      romaji: \'Ame ga furitsuzuku hi wa yuuutsu na kibun ni nariyasui.\',\n      meaningPt: \'Nos dias em que a chuva n\303\243o para de cair, \303\251 f\303\241cil ficar tomado por uma sensa\303\247\303\243o melanc\303\263lica.\'\n    }\n  },\n  {\n    id: \'v_n1_2\',\n    word: \'\351\221\221\350\263\236\',\n    reading: \'\343\201\213\343\202\223\343\201\227\343\202\207\343\201\206\',\n    romaji: \'kanshou\',\n    meaningPt: \'Aprecia\303\247\303\243o art\303\255stica (cinema, m\303\272sica, pintura)\',\n    category: \'substantivo\',\n    jlpt: \'N1\',\n    categoryLabelPt: \'Substantivo N1\',\n    exampleSentence: {\n      jp: \'\344\274\221\346\227\245\343\201\257\347\276\216\350\241\223\351\244\250\343\201\247\347\265\265\347\224\273\343\201\256\351\221\221\350\263\236\343\202\222\346\245\275\343\201\227\343\201\277\343\201\276\343\201\231\343\200\202\',\n      reading: \'\343\201\215\343\202\205\343\201\206\343\201\230\343\201\244 \343\201\257 \343\201\263\343\201\230\343\202\205\343\201\244\343\201\213\343\202\223 \343\201\247 \343\201\213\343\201\204\343\201\214 \343\201\256 \343\201\213\343\202\223\343\201\227\343\202\207\343\201\206 \343\202\222 \343\201\237\343\201\256\343\201\227\343\201\277\343\201\276\343\201\231\343\200\202\',\n      romaji: \'Kyuujitsu wa bijutsukan de kaiga no kanshou o tanoshimimasu.\',\n      meaningPt: \'Nos dias de folga, desfruto da aprecia\303\247\303\243o de pinturas em museus de arte.\'\n    }\n  }\n];\n"
    }
