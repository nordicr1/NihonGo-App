      replacement_content: "import { KanjiItem } from \'../types\';\n\nexport const KANJI_N3: KanjiItem[] = [\n  // Emo\303\247\303\265es, Mente e Sensa\303\247\303\265es\n  {\n    id: \'k_n3_1\',\n    kanji: \'\345\226\234\',\n    onyomi: [\'\343\202\255 (ki)\'],\n    kunyomi: [\'\343\202\210\343\202\215\343\201\223.\343\201\266 (yoroko.bu)\'],\n    meaningPt: \'Alegria, Ficar feliz\',\n    strokes: 12,\n    radical: \'\345\217\243 (boca)\',\n    jlpt: \'N3\',\n    examples: [\n      { word: \'\345\226\234\343\201\266\', reading: \'\343\202\210\343\202\215\343\201\223\343\201\266 (yorokobu)\', meaningPt: \'Ficar feliz / Alegrar-se\' },\n      { word: \'\345\226\234\343\201\263\', reading: \'\343\202\210\343\202\215\343\201\223\343\201\263 (yorokobi)\', meaningPt: \'Alegria / J\303\272bilo\' },\n      { word: \'\345\244\247\345\226\234\343\201\263\', reading: \'\343\201\212\343\201\212\343\202\210\343\202\215\343\201\223\343\201\263 (ooyorokobi)\', meaningPt: \'Grande contentamento\' }\n    ]\n  },\n  {\n    id: \'k_n3_2\',\n    kanji: \'\346\200\222\',\n    onyomi: [\'\343\203\211 (do)\', \'\343\203\214 (nu)\'],\n    kunyomi: [\'\343\201\204\343\201\213.\343\202\213 (ika.ru)\', \'\343\201\212\343\201\223.\343\202\213 (oko.ru)\'],\n    meaningPt: \'Raiva, F\303\272ria, Ficar bravo\',\n    strokes: 9,\n    radical: \'\345\277\203 (cora\303\247\303\243o)\',\n    jlpt: \'N3\',\n    examples: [\n      { word: \'\346\200\222\343\202\213\', reading: \'\343\201\212\343\201\223\343\202\213 (okoru)\', meaningPt: \'Ficar bravo / Zangar-se\' },\n      { word: \'\346\200\222\343\202\212\', reading: \'\343\201\204\343\201\213\343\202\212 (ikari)\', meaningPt: \'Ira / F\303\272ria\' },\n      { word: \'\346\277\200\346\200\222\', reading: \'\343\201\222\343\201\215\343\201\251 (gekido)\', meaningPt: \'F\303\272ria incontrol\303\241vel\' }\n    ]\n  },\n  {\n    id: \'k_n3_3\',\n    kanji: \'\346\263\243\',\n    onyomi: [\'\343\202\255\343\203\245\343\202\246 (kyuu)\'],\n    kunyo