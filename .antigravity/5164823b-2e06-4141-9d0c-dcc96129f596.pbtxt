        lines {
          text: "    pattern: \'Part\303\255culas Principais (\343\202\222, \343\201\253, \343\201\247, \343\201\270, \343\201\250, \343\202\202, \343\201\214, \343\201\213\343\202\211, \343\201\276\343\201\247)\',"
