          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanationPt: \'A part\303\255cula \343\201\257 (escrita como \"ha\", mas pronunciada \"wa\") indica o T\303\263pico da frase (aquilo sobre o qual estamos falando). O termo \343\201\247\343\201\231 (desu) \303\251 a c\303\263pula formal que equivale a \"\303\251 / sou / somos\".\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    keyRulePt: \'Na negativa vira \"A \343\201\257 B \343\201\247\343\201\257\343\201\202\343\202\212\343\201\276\343\201\233\343\202\223\" (dewa arimasen) ou \"\343\201\230\343\202\203\343\201\202\343\202\212\343\201\276\343\201\233\343\202\223\" (ja arimasen). Para fazer perguntas, basta adicionar \343\201\213 (ka) no final.\',"
