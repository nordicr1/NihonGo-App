      replacement_content: "import { VocabItem } from \'../types\';\n\nexport const VOCAB_N3: VocabItem[] = [\n  // ================= VERBOS GODAN & ICHIDAN N3 =================\n  {\n    id: \'v_n3_1\',\n    word: \'\346\226\255\343\202\213\',\n    reading: \'\343\201\223\343\201\250\343\202\217\343\202\213\',\n    romaji: \'kotowaru\',\n    meaningPt: \'Recusar / Rejeitar / Pedir dispensa pr\303\251via\',\n    category: \'verbo_godan\',\n    jlpt: \'N3\',\n    categoryLabelPt: \'Verbo Godan (Grupo 1)\',\n    exampleSentence: {\n      jp: \'\350\252\230\343\201\204\343\202\222\344\270\201\345\257\247\343\201\253\346\226\255\343\202\212\343\201\276\343\201\227\343\201\237\343\200\202\',\n      reading: \'\343\201\225\343\201\235\343\201\204 \343\202\222 \343\201\246\343\201\204\343\201\255\343\201\204 \343\201\253 \343\201\223\343\201\250\343\202\217\343\202\212\343\201\276\343\201\227\343\201\237\343\200\202\',\n      romaji: \'Sasoi o teinei ni kotowarimashita.\',\n      meaningPt: \'Recusei educadamente o convite.\'\n    }\n  },\n  {\n    id: \'v_n3_2\',\n    word: \'\351\240\274\343\202\213\',\n    reading: \'\343\201\237\343\202\210\343\202\213\',\n    romaji: \'tayoru\',\n    meaningPt: \'Depender de / Confiar em / Apoiar-se em\',\n    category: \'verbo_godan\',\n    jlpt: \'N3\',\n    categoryLabelPt: \'Verbo Godan (Grupo 1)\',\n    exampleSentence: {\n      jp: \'\345\233\260\343\201\243\343\201\237\343\201\250\343\201\215\343\201\257\343\200\201\351\201\240\346\205\256\343\201\252\343\201\217\345\217\213\351\201\224\343\202\222\351\240\274\343\201\243\343\201\246\343\201\217\343\201\240\343\201\225\343\201\204\343\200\202\',\n      reading: \'\343\201\223\343\201\276\343\201\243\343\201\237 \343\201\250\343\201\215 \343\201\257\343\200\201\343\201\210\343\202\223\343\202\212\343\202\207 \343\201\252\343\201\217 \343\201\250\343\202\202\343\201\240\343\201\241 \343\202\222 \343\201\237\343\202\210\343\201\243\343\201\246 \343\201\217\343\201\240\343\201\225\343\201\204\343\200\202\',\n      romaji: \'Komatta toki wa, enryo naku tomodachi o tayotte kudasai.\',\n      meaningPt: \'Quando estiver em apuros, conte com os amigos sem hesitar.\'\n    }\n  },\n  {\n    id: \'v_n3_3\',\n    word: \'\347\242\272\343\201\213\343\202\201\343\202\213\',\n    reading: \'\343\201\237\343\201\227\343\201\213\343\202\201\343\202\213\',\n    romaji: \'tashikameru\',\n    meaningPt: \'Verificar / Checar / Assegurar-se\',\n    category: \'verbo_ichidan\',\n    jlpt: \'N3\',\n    categoryLabelPt: \'Verbo Ichidan (Grupo 2)\',\n    exampleSentence: {\n      jp: \'\346\233\270\351\241\236\343\201\253\351\226\223\351\201\225\343\201\204\343\201\214\343\201\252\343\201\204\343\201\213\347\242\272\343\201\213\343\202\201\343\201\276\343\201\227\343\201\237\343\200\202\',\n      reading: \'\343\201\227\343\202\207\343\202\213\343\201\204 \343\201\253 \343\201\276\343\201\241\343\201\214\343\201\204 \343\201\214 \343\201\252\343\201\204 \343\201\213 \343\201\237\343\201\227\343\201\213\343\202\201\343\201\276\343\201\227\343\201\237\343\200\202\',\n      romaji: \'Shorui ni machigai ga nai ka tashikamemashita.\',\n      meaningPt: \'Verifiquei se n\303\243o havia erros nos documentos.\'\n    }\n  },\n  {\n    id: \'v_n3_4\',\n    word: \'\350\252\215\343\202\201\343\202\213\',\n    reading: \'\343\201\277\343\201\250\343\202\201\343\202\213\',\n    romaji: \'mitomeru\',\n    meaningPt: \'Reconhecer / Admitir / Aprovar\',\n    category: \'verbo_ichidan\',\n    jlpt: \'N3\',\n    categoryLabelPt: \'Verbo Ichidan (Grupo 2)\',\n    exampleSentence: {\n      jp: \'\350\207\252\345\210\206\343\201\256\343\203\237\343\202\271\343\202\222\347\264\240\347\233\264\343\201\253\350\252\215\343\202\201\343\201\276\343\201\227\343\201\237\343\200\202\',\n      reading: \'\343\201\230\343\201\266\343\202\223 \343\201\256 \343\203\237\343\202\271 \343\202\222 \343\201\231\343\201\252\343\201\212 \343\201\253 \343\201\277\343\201\250\343\202\201\343\201\276\343\201\227\343\201\237\343\200\202\',\n      romaji: \'Jibun no misu o sunao ni mitomemashita.\',\n      meaningPt: \'Admiti meu pr\303\263prio erro com sinceridade.\'\n    }\n  },\n  {\n    id: \'v_n3_5\',\n    word: \'\347\224\263\343\201\227\350\276\274\343\202\200\',\n    reading: \'\343\202\202\343\201\206\343\201\227\343\201\223\343\202\200\',\n    romaji: \'moushikomu\',\n    meaningPt: \'Inscrever-se / Solicitar formalmente\',\n    category: \'verbo_godan\',\n    jlpt: \'N3\',\n    categoryLabelPt: \'Verbo Godan (Grupo 1)\',\n    exampleSentence: {\n      jp: \'\346\227\245\346\234\254\350\252\236\350\203\275\345\212\233\350\251\246\351\250\223\343\201\253\347\224\263\343\201\227\350\276\274\343\201\277\343\201\276\343\201\227\343\201\237\343\200\202\',\n      reading: \'\343\201\253\343\201\273\343\202\223\343\201\224 \343\201\256\343\201\206\343\202\212\343\202\207\343\201\217 \343\201\227\343\201\221\343\202\223 \343\201\253 \343\202\202\343\201\206\343\201\227\343\201\223\343\201\277\343\201\276\343\201\227\343\201\237\343\200\202\',\n      romaji: \'Nihongo nouryoku shiken ni moushikomimashita.\',\n      meaningPt: \'Inscrevi-me para o Exame de Profici\303\252ncia em L\303\255ngua Japonesa (JLPT).\'\n    }\n  },\n\n  // ================= VERBOS IRREGULARES (SURU) =================\n  {\n    id: \'v_n3_6\',\n    word: \'\347\242\272\350\252\215\343\201\231\343\202\213\',\n    reading: \'\343\201\213\343\201\217\343\201\253\343\202\223\343\201\231\343\202\213\',\n    romaji: \'kakunin suru\',\n    meaningPt: \'Confirmar / Fazer checagem\',\n    category: \'verbo_irregular\',\n    jlpt: \'N3\',\n    categoryLabelPt: \'Verbo Irregular (Grupo 3)\',\n    exampleSentence: {\n      jp: \'\343\203\241\343\203\274\343\203\253\343\201\256\345\206\205\345\256\271\343\202\222\343\202\202\343\201\206\344\270\200\345\272\246\347\242\272\350\252\215\343\201\227\343\201\246\343\201\217\343\201\240\343\201\225\343\201\204\343\200\202\',\n      reading: \'\343\203\241\343\203\274\343\203\253 \343\201\256 \343\201\252\343\201\204\343\202\210\343\201\206 \343\202\222 \343\202\202\343\201\206\343\201\204\343\201\241\343\201\251 \343\201\213\343\201\217\343\201\253\343\202\223 \343\201\227\343\201\246 \343\201\217\343\201\240\343\201\225\343\201\204\343\200\202\',\n      romaji: \'Meeru no naiyou o mou ichido kakunin shite kudasai.\',\n      meaningPt: \'Por favor, confirme mais uma vez o conte\303\272do do e-mail.\'\n    }\n  },\n  {\n    id: \'v_n3_7\',\n    word: \'\350\247\243\346\261\272\343\201\231\343\202\213\',\n    reading: \'\343\201\213\343\201\204\343\201\221\343\201\244\343\201\231\343\202\213\',\n    romaji: \'kaiketsu suru\',\n    meaningPt: \'Resolver / Solucionar um problema\',\n    category: \'verbo_irregular\',\n    jlpt: \'N3\',\n    categoryLabelPt: \'Verbo Irregular (Grupo 3)\',\n    exampleSentence: {\n      jp: \'\343\201\277\343\202\223\343\201\252\343\201\247\350\251\261\343\201\227\345\220\210\343\201\243\343\201\246\343\200\201\345\225\217\351\241\214\343\202\222\350\247\243\346\261\272\343\201\227\343\201\276\343\201\227\343\201\237\343\200\202\',\n      reading: \'\343\201\277\343\202\223\343\201\252 \343\201\247 \343\201\257\343\201\252\343\201\227\343\201\202\343\201\243\343\201\246\343\200\201\343\202\202\343\202\223\343\201\240\343\201\204 \343\202\222 \343\201\213\343\201\204\343\201\221\343\201\244 \343\201\227\343\201\276\343\201\227\343\201\237\343\200\202\',\n      romaji: \'Minna de hanashiatte, mondai o kaiketsu shimashita.\',\n      meaningPt: \'Conversamos todos juntos e solucionamos o problema.\'\n    }\n  },\n\n  // ================= ADJETIVOS-I (\343\201\204) & ADJETIVOS-NA (\343\201\252) =================\n  {\n    id: \'v_n3_8\',\n    word: \'\346\203\234\343\201\227\343\201\204\',\n    reading: \'\343\201\212\343\201\227\343\201\204\',\n    romaji: \'oshii\',\n    meaningPt: \'Quase! / Uma pena / Lament\303\241vel perder por pouco\',\n    category: \'adjetivo_i\',\n    jlpt: \'N3\',\n    categoryLabelPt: \'Adjetivo-I (\343\201\204)\',\n    exampleSentence: {\n      jp: \'\343\201\202\343\201\250\344\270\200\346\255\251\343\201\256\343\201\250\343\201\223\343\202\215\343\201\247\350\262\240\343\201\221\343\201\246\343\201\227\343\201\276\343\201\204\343\200\201\343\201\250\343\201\246\343\202\202\346\203\234\343\201\227\343\201\213\343\201\243\343\201\237\343\201\247\343\201\231\343\200\202\',\n      reading: \'\343\201\202\343\201\250 \343\201\204\343\201\243\343\201\275 \343\201\256 \343\201\250\343\201\223\343\202\215 \343\201\247 \343\201\276\343\201\221\343\201\246 \343\201\227\343\201\276\343\201\204\343\200\201\343\201\250\343\201\246\343\202\202 \343\201\212\343\201\227\343\201\213\343\201\243\343\201\237 \343\201\247\343\201\231\343\200\202\',\n      romaji: \'Ato ippo no tokoro de makete shimai, totemo oshikatta desu.\',\n      meaningPt: \'Perdemos por apenas um passo de diferen\303\247a; foi por muito pouco!\'\n    }\n  },\n  {\n    id: \'v_n3_9\',\n    word: \'\346\200\252\343\201\227\343\201\204\',\n    reading: \'\343\201\202\343\202\204\343\201\227\343\201\204\',\n    romaji: \'ayashii\',\n    meaningPt: \'Suspeito / Duvidoso\',\n    category: \'adjetivo_i\',\n    jlpt: \'N3\',\n    categoryLabelPt: \'Adjetivo-I (\343\201\204)\',\n    exampleSentence: {\n      jp: \'\345\244\234\344\270\255\343\201\253\346\200\252\343\201\227\343\201\204\344\272\272\343\202\222\350\246\213\343\201\213\343\201\221\343\201\276\343\201\227\343\201\237\343\200\202\',\n      reading: \'\343\202\210\343\201\252\343\201\213 \343\201\253 \343\201\202\343\202\204\343\201\227\343\201\204 \343\201\262\343\201\250 \343\202\222 \343\201\277\343\201\213\343\201\221\343\201\276\343\201\227\343\201\237\343\200\202\',\n      romaji: \'Yonaka ni ayashii hito o mikakemashita.\',\n      meaningPt: \'Vi uma pessoa suspeita no meio da noite.\'\n    }\n  },\n  {\n    id: \'v_n3_10\',\n    word: \'\351\201\251\345\275\223\',\n    reading: \'\343\201\246\343\201\215\343\201\250\343\201\206\',\n    romaji: \'tekitou\',\n    meaningPt: \'Apropriado / Adequado (ou informalmente: feito de qualquer jeito)\',\n    category: \'adjetivo_na\',\n    jlpt: \'N3\',\n    categoryLabelPt: \'Adjetivo-Na (\343\201\252)\',\n    exampleSentence: {\n      jp: \'\346\226\231\347\220\206\343\201\253\351\201\251\345\275\223\343\201\252\351\207\217\343\201\256\345\241\251\343\202\222\345\212\240\343\201\210\343\201\276\343\201\231\343\200\202\',\n      reading: \'\343\202\212\343\202\207\343\201\206\343\202\212 \343\201\253 \343\201\246\343\201\215\343\201\250\343\201\206 \343\201\252 \343\202\212\343\202\207\343\201\206 \343\201\256 \343\201\227\343\201\212 \343\202\222 \343\201\217\343\202\217\343\201\210\343\201\276\343\201\231\343\200\202\',\n      romaji: \'Ryouri ni tekitou na ryou no shio o kuwaemasu.\',\n      meaningPt: \'Adicione uma quantidade adequada de sal \303\240 comida.\'\n    }\n  },\n\n  // ================= SUBSTANTIVOS SOCIAIS & PROFISSIONAIS =================\n  {\n    id: \'v_n3_11\',\n    word: \'\347\265\214\346\270\210\',\n    reading: \'\343\201\221\343\201\204\343\201\226\343\201\204\',\n    romaji: \'keizai\',\n    meaningPt: \'Economia / Finan\303\247as\',\n    category: \'substantivo\',\n    jlpt: \'N3\',\n    categoryLabelPt: \'Substantivo\',\n    exampleSentence: {\n      jp: \'\344\270\226\347\225\214\343\201\256\347\265\214\346\270\210\346\203\205\345\213\242\343\201\253\343\201\244\343\201\204\343\201\246\350\255\260\350\253\226\343\201\227\343\201\276\343\201\227\343\201\237\343\200\202\',\n      reading: \'\343\201\233\343\201\213\343\201\204 \343\201\256 \343\201\221\343\201\204\343\201\226\343\201\204 \343\201\230\343\202\207\343\201\206\343\201\233\343\201\204 \343\201\253 \343\201\244\343\201\204\343\201\246 \343\201\216\343\202\215\343\202\223 \343\201\227\343\201\276\343\201\227\343\201\237\343\200\202\',\n      romaji: \'Sekai no keizai jousei ni tsuite giron shimashita.\',\n      meaningPt: \'Debatemos sobre o cen\303\241rio econ\303\264mico mundial.\'\n    }\n  },\n  {\n    id: \'v_n3_12\',\n    word: \'\347\222\260\345\242\203\',\n    reading: \'\343\201\213\343\202\223\343\201\215\343\202\207\343\201\206\',\n    romaji: \'kankyou\',\n    meaningPt: \'Meio ambiente / Entorno\',\n    category: \'substantivo\',\n    jlpt: \'N3\',\n    categoryLabelPt: \'Substantivo\',\n    exampleSentence: {\n      jp: \'\345\234\260\347\220\203\347\222\260\345\242\203\343\202\222\345\256\210\343\202\213\343\201\237\343\202\201\343\201\256\346\264\273\345\213\225\343\201\253\345\217\202\345\212\240\343\201\227\343\201\246\343\201\204\343\201\276\343\201\231\343\200\202\',\n      reading: \'\343\201\241\343\201\215\343\202\205\343\201\206 \343\201\213\343\202\223\343\201\215\343\202\207\343\201\206 \343\202\222 \343\201\276\343\202\202\343\202\213 \343\201\237\343\202\201 \343\201\256 \343\201\213\343\201\244\343\201\251\343\201\206 \343\201\253 \343\201\225\343\202\223\343\201\213 \343\201\227\343\201\246\343\201\204\343\201\276\343\201\231\343\200\202\',\n      romaji: \'Chikyuu kankyou o mamoru tame no katsudou ni sanka shite imasu.\',\n      meaningPt: \'Participo de atividades voltadas \303\240 preserva\303\247\303\243o do meio ambiente do planeta.\'\n    }\n  },\n  {\n    id: \'v_n3_13\',\n    word: \'\346\212\200\350\241\223\',\n    reading: \'\343\201\216\343\201\230\343\202\205\343\201\244\',\n    romaji: \'gijutsu\',\n    meaningPt: \'Tecnologia / T\303\251cnica / Engenharia\',\n    category: \'substantivo\',\n    jlpt: \'N3\',\n    categoryLabelPt: \'Substantivo\',\n    exampleSentence: {\n      jp: \'\346\227\245\346\234\254\343\201\256\345\205\210\347\253\257\346\212\200\350\241\223\343\201\257\344\270\226\347\225\214\344\270\255\343\201\247\351\253\230\343\201\217\350\251\225\344\276\241\343\201\225\343\202\214\343\201\246\343\201\204\343\201\276\343\201\231\343\200\202\',\n      reading: \'\343\201\253\343\201\273\343\202\223 \343\201\256 \343\201\233\343\202\223\343\201\237\343\202\223 \343\201\216\343\201\230\343\202\205\343\201\244 \343\201\257 \343\201\233\343\201\213\343\201\204\343\201\230\343\202\205\343\201\206 \343\201\247 \343\201\237\343\201\213\343\201\217 \343\201\262\343\202\207\343\201\206\343\201\213 \343\201\225\343\202\214\343\201\246\343\201\204\343\201\276\343\201\231\343\200\202\',\n      romaji: \'Nihon no sentan gijutsu wa sekaijuu de takaku hyouka sarete imasu.\',\n      meaningPt: \'A tecnologia de ponta japonesa \303\251 altamente valorizada no mundo inteiro.\'\n    }\n  },\n  {\n    id: \'v_n3_14\',\n    word: \'\350\262\254\344\273\273\',\n    reading: \'\343\201\233\343\201\215\343\201\253\343\202\223\',\n    romaji: \'sekinin\',\n    meaningPt: \'Responsabilidade / Dever\',\n    category: \'substantivo\',\n    jlpt: \'N3\',\n    categoryLabelPt: \'Substantivo\',\n    exampleSentence: {\n      jp: \'\343\203\252\343\203\274\343\203\200\343\203\274\343\201\250\343\201\227\343\201\246\347\265\220\346\236\234\343\201\253\350\262\254\344\273\273\343\202\222\346\214\201\343\201\241\343\201\276\343\201\231\343\200\202\',\n      reading: \'\343\203\252\343\203\274\343\203\200\343\203\274 \343\201\250\343\201\227\343\201\246 \343\201\221\343\201\243\343\201\213 \343\201\253 \343\201\233\343\201\215\343\201\253\343\202\223 \343\202\222 \343\202\202\343\201\241\343\201\276\343\201\231\343\200\202\',\n      romaji: \'Riidaa to shite kekka ni sekinin o mochimasu.\',\n      meaningPt: \'Como l\303\255der, assumo a responsabilidade pelos resultados.\'\n    }\n  },\n\n  // ================= ADV\303\211RBIOS & CONECTIVOS DE TEXTO =================\n  {\n    id: \'v_n3_15\',\n    word: \'\345\201\266\347\204\266\',\n    reading: \'\343\201\220\343\201\206\343\201\234\343\202\223\',\n    romaji: \'guuzen\',\n    meaningPt: \'Por coincid\303\252ncia / Por acaso\',\n    category: \'adverbio\',\n    jlpt: \'N3\',\n    categoryLabelPt: \'Adv\303\251rbio\',\n    exampleSentence: {\n      jp: \'\351\247\205\343\201\247\345\201\266\347\204\266\343\200\201\346\230\224\343\201\256\345\220\214\347\264\232\347\224\237\343\201\253\344\274\232\343\201\204\343\201\276\343\201\227\343\201\237\343\200\202\',\n      reading: \'\343\201\210\343\201\215 \343\201\247 \343\201\220\343\201\206\343\201\234\343\202\223\343\200\201\343\202\200\343\201\213\343\201\227 \343\201\256 \343\201\251\343\201\206\343\201\215\343\202\205\343\201\206\343\201\233\343\201\204 \343\201\253 \343\201\202\343\201\204\343\201\276\343\201\227\343\201\237\343\200\202\',\n      romaji: \'Eki de guuzen, mukashi no doukyuusei ni aimashita.\',\n      meaningPt: \'Por coincid\303\252ncia encontrei um antigo colega de classe na esta\303\247\303\243o.\'\n    }\n  },\n  {\n    id: \'v_n3_16\',\n    word: \'\343\201\234\343\201\262\',\n    reading: \'\343\201\234\343\201\262\',\n    romaji: \'zehi\',\n    meaningPt: \'Com certeza / Sem falta / Fa\303\247a quest\303\243o de...\',\n    category: \'adverbio\',\n    jlpt: \'N3\',\n    categoryLabelPt: \'Adv\303\251rbio\',\n    exampleSentence: {\n      jp: \'\346\227\245\346\234\254\343\201\253\346\235\245\343\201\237\343\202\211\343\200\201\343\201\234\343\201\262\346\210\221\343\201\214\345\256\266\343\201\253\351\201\212\343\201\263\343\201\253\346\235\245\343\201\246\343\201\217\343\201\240\343\201\225\343\201\204\343\200\202\',\n      reading: \'\343\201\253\343\201\273\343\202\223 \343\201\253 \343\201\215\343\201\237\343\202\211\343\200\201\343\201\234\343\201\262 \343\202\217\343\201\214\343\202\204 \343\201\253 \343\201\202\343\201\235\343\201\263 \343\201\253 \343\201\215\343\201\246 \343\201\217\343\201\240\343\201\225\343\201\204\343\200\202\',\n      romaji: \'Nihon ni kitara, zehi wagaya ni asobi ni kite kudasai.\',\n      meaningPt: \'Quando vier ao Jap\303\243o, fa\303\247a absoluta quest\303\243o de vir nos visitar em nossa casa.\'\n    }\n  }\n];\n"
    }
