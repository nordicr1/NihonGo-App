        }
        lines {
          text: "    explanationPt: \'Utilizado para fazer pedidos cordiais e instru\303\247\303\265es no dia a dia. Para formar, transforma-se o verbo na Forma-TE e adiciona-se \343\201\217\343\201\240\343\201\225\343\201\204.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    keyRulePt: \'Regras da Forma-TE:\\n\342\200\242 Ichidan: troca \343\202\213 por \343\201\246 (\351\243\237\343\201\271\343\202\213 \342\206\222 \351\243\237\343\201\271\343\201\246).\\n\342\200\242 Godan (\343\201\206, \343\201\244, \343\202\213): \343\201\243\343\201\246 (\345\276\205\343\201\244 \342\206\222 \345\276\205\343\201\243\343\201\246).\\n\342\200\242 Godan (\343\202\200, \343\201\266, \343\201\254): \343\202\223\343\201\247 (\351\243\262\343\202\200 \342\206\222 \351\243\262\343\202\223\343\201\247).\\n\342\200\242 Godan (\343\201\217): \343\201\204\343\201\246 (\346\233\270\343\201\217 \342\206\222 \346\233\270\343\201\204\343\201\246; exce\303\247\303\243o: \350\241\214\343\201\217 \342\206\222 \350\241\214\343\201\243\343\201\246).\\n\342\200\242 Godan (\343\201\220): \343\201\204\343\201\247 (\346\263\263\343\201\220 \342\206\222 \346\263\263\343\201\204\343\201\247).\\n\342\200\242 Godan (\343\201\231): \343\201\227\343\201\246 (\350\251\261\343\201\231 \342\206\222 \350\251\261\343\201\227\343\201\246).\\n\342\200\242 Irregulares: \343\201\231\343\202\213 \342\206\222 \343\201\227\343\201\246 / \346\235\245\343\202\213 \342\206\222 \343\201\215\343\201\246.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
