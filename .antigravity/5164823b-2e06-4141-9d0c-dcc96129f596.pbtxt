_3\',\n    jlpt: \'N2\',\n    meaningPt: \'A economia est\303\241 melhorando gradualmente.\',\n    fullJp: \'\346\231\257\346\260\227\343\201\257\345\260\221\343\201\227\343\201\232\343\201\244\345\233\236\345\276\251\343\201\227\343\201\244\343\201\244\343\201\202\343\202\213\343\200\202\',\n    fullReading: \'\343\201\221\343\201\204\343\201\215\343\201\257 \343\201\231\343\201\223\343\201\227\343\201\232\343\201\244 \343\201\213\343\201\204\343\201\265\343\201\217 \343\201\227\343\201\244\343\201\244\343\201\202\343\202\213\343\200\202\',\n    fullRomaji: \'Keiki wa sukoshizutsu kaifuku shitsutsu aru.\',\n    parts: [\'\346\231\257\346\260\227\343\201\257\', \'\345\260\221\343\201\227\343\201\232\343\201\244\', \'\345\233\236\345\276\251\', \'\343\201\227\343\201\244\343\201\244\343\201\202\343\202\213\'],\n    correctOrder: [\'\346\231\257\346\260\227\343\201\257\', \'\345\260\221\343\201\227\343\201\232\343\201\244\', \'\345\233\236\345\276\251\', \'\343\201\227\343\201\244\343\201\244\343\201\202\343\202\213\'],\n    grammarHintPt: \'T\303\263pico econ\303\264mico \342\236\224 Adv\303\251rbio gradual \342\236\224 Raiz verbal + \343\200\234\343\201\244\343\201\244\343\201\202\343\202\213 (mudan\303\247a em andamento cont\303\255nuo)\'\n  },\n\n  // ===================== N1 SENTENCES =====================\n  {\n    id: \'s_n1_1\',\n    jlpt: \'N1\',\n    meaningPt: \'N\303\243o importa qual seja o motivo, a viol\303\252ncia \303\251 imperdo\303\241vel.\',\n    fullJp: \'\347\220\206\347\224\261\343\201\214\344\275\225\343\201\247\343\201\202\343\202\214\346\232\264\345\212\233\343\201\257\350\250\261\343\201\225\343\202\214\343\201\252\343\201\204\343\200\202\',\n    fullReading: \'\343\202\212\343\202\206\343\201\206\343\201\214 \343\201\252\343\201\253\343\201\247\343\201\202\343\202\214 \343\201\274\343\201\206\343\202\212\343\202\207\343\201\217\343\201\257 \343\202\206\343\202\213\343\201\225\343\202\214\343\201\252\343\201\204\343\200\202\',\n    fullRomaji: \'Riyuu ga nani de are bouryoku wa yurusarenai.\',\n    parts: [\'\347\220\206\347\224\261\343\201\214\', \'\344\275\225\343\201\247\343\201\202\343\202\214\', \'\346\232\264\345\212\233\343\201\257\', \'\350\250\261\343\201\225\343\202\214\343\201\252\343\201\204\'],\n    correctOrder: [\'\347\220\206\347\224\261\343\201\214\', \'\344\275\225\343\201\247\343\201\202\343\202\214\', \'\346\232\264\345\212\233\343\201\257\', \'\350\250\261\343\201\225\343\202\214\343\201\252\343\201\204\'],\n    grammarHintPt: \'Interrogativo + \343\201\247\343\201\202\343\202\214 (seja o que for / n\303\243o importa o que) \342\236\224 T\303\263pico + Verbo na voz passiva negativa\'\n  },\n  {\n    id: \'s_n1_2\',\n    jlpt: \'N1\',\n    meaningPt: \'Devido ao grande tuf\303\243o, o evento foi for\303\247ado ao cancelamento.\',\n    fullJp: \'\345\244\247\345\236\213\345\217\260\351\242\250\343\201\256\343\201\237\343\202\201\343\202\244\343\203\231\343\203\263\343\203\210\343\201\257\344\270\255\346\255\242\343\202\222\344\275\231\345\204\200\343\201\252\343\201\217\343\201\225\343\202\214\343\201\237\343\200\202\',\n    fullReading: \'\343\201\212\343\201\212\343\201\214\343\201\237\343\201\237\343\201\204\343\201\265\343\201\206\343\201\256\343\201\237\343\202\201 \343\202\244\343\203\231\343\203\263\343\203\210\343\201\257 \343\201\241\343\202\205\343\201\206\343\201\227\343\202\222 \343\202\210\343\201\216\343\201\252\343\201\217\343\201\225\343\202\214\343\201\237\343\200\202\',\n    fullRomaji: \'Oogata taifuu no tame ibento wa chuushi o yogi naku sareta.\',\n    parts: [\'\345\244\247\345\236\213\345\217\260\351\242\250\343\201\256\343\201\237\343\202\201\', \'\343\202\244\343\203\231\343\203\263\343\203\210\343\201\257\', \'\344\270\255\346\255\242\343\202\222\', \'\344\275\231\345\204\200\343\201\252\343\201\217\343\201\225\343\202\214\343\201\237\'],\n    correctOrder: [\'\345\244\247\345\236\213\345\217\260\351\242\250\343\201\256\343\201\237\343\202\201\', \'\343\202\