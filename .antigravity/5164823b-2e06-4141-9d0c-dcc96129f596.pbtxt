        lines {
          text: "    titlePt: \'O Sistema de Favores e Benef\303\255cios em Japon\303\252s\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    jlpt: \'N4\',"
