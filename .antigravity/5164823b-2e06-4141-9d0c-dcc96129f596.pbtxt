    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { AudioButton } from \'./AudioButton\';\nimport { Sparkles, Search, BookOpen, Layers, CheckCircle2, ArrowRight } from \'lucide-react\';\nimport { playJapaneseAudio } from \'../utils/audio\';\n\ninterface BreakdownToken {\n  token: string;\n  reading: string;\n  romaji: string;\n  type: string;\n  meaning: string;\n}\n\ninterface AnalysisResult {\n  original: string;\n  romaji: string;\n  translation: string;\n  literalTranslation?: string;\n  jlptLevel?: string;\n  breakdown: BreakdownToken[];\n  grammarNotes: string;\n  culturalNote?: string;\n}\n\nconst PRESET_SENTENCES = [\n  \'\347\247\201\343\201\257\346\257\216\346\234\235\344\270\203\346\231\202\343\201\253\350\265\267\343\201\215\343\201\246\343\200\201\346\260\264\343\202\222\351\243\262\343\201\277\343\201\276\343\201\231\343\200\202\',\n  \'\345\257\214\345\243\253\345\261\261\343\201\253\347\231\273\343\201\243\343\201\237\343\201\223\343\201\250\343\201\214\343\201\202\343\202\212\343\201\276\343\201\231\343\201\213\343\200\202\',\n  \'\343\201\223\343\201\256\346\227\245\346\234\254\346\226\231\347\220\206\343\201\257\343\201\250\343\201\246\343\202\202\347\276\216\345\221\263\343\201\227\343\201\204\343\201\247\343\201\231\343\201\213\343\202\211\343\200\201\346\257\216\346\227\245\351\243\237\343\201\271\343\201\237\343\201\204\343\201\247\343\201\231\343\200\202\',\n  \'\351\233\250\343\201\214\351\231\215\343\201\243\343\201\246\343\201\204\343\202\213\343\201\213\343\202\211\343\200\201\345\202\230\343\202\222\346\214\201\343\201\243\343\201\246\350\241\214\343\201\213\343\201\252\343\201\221\343\202\214\343\201\260\343\201\252\343\202\212\343\201\276\343\201\233\343\202\223\343\200\202\',\n  \'\347\224\260\344\270\255\345\205\210\347\224\237\343\201\257\343\201\204\343\201\244\343\202\202\350\246\252\345\210\207\343\201\253\346\227\245\346\234\254\350\252\236\343\202\222\346\225\231\343\201\210\343\201\246\343\201\217\343\202\214\343\201\276\343\201\231\343\200\202\',\n];\n\nexport const SentenceAnalyzer: React.FC<{ onGainXp: (amt: number, reason: string) => void }> = ({\n  onGainXp,\n}) => {\n  const [inputText, setInputText] = useState(\'\347\247\201\343\201\257\346\257\216\346\234\235\344\270\203\346\231\202\343\201\253\350\265\267\343\201\215\343\201\246\343\200\201\346\260\264\343\202\222\351\243\262\343\201\277\343\201\276\343\201\231\343\200\202\');\n  const [isLoading, setIsLoading] = useState(false);\n  const [result, setResult] = useState<AnalysisResult | null>(null);\n\n  const handleAnalyze = async (textToAnalyze = inputText) => {\n    if (!textToAnalyze.trim()) return;\n    setIsLoading(true);\n\n    try {\n      const response = await fetch(\'/api/sensei/analyze-sentence\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ sentence: textToAnalyze }),\n      });\n\n      const data = await response.json();\n      setResult(data);\n      onGainXp(10, \'Analisou Frase em Japon\303\252s\');\n    } catch (err) {\n      console.error(\'Error analyzing sentence:\', err);\n      // Fallback offline analysis\n      setResult({\n        original: textToAnalyze,\n        romaji: \'Watashi wa maiasa shichiji ni okite, mizu o nomimasu.\',\n        translation: \'Eu acordo \303\240s sete horas toda manh\303\243 e bebo \303\241gua.\',\n        literalTranslation: \'Eu (t\303\263pico) toda manh\303\243 sete horas em acordando, \303\241gua (objeto) bebo.\',\n        jlptLevel: \'N5\',\n        breakdown: [\n          { token: \'\347\247\201\', reading: \'\343\202\217\343\201\237\343\201\227\', romaji: \'watashi\', type: \'Substantivo\', meaning: \'Eu\' },\n          { token: \'\343\201\257\', reading: \'\343\201\257 (wa)\', romaji: \'wa\', type: \'Part\303\255cula de T\303\263pico\', meaning: \'quanto a / \303\251\' },\n          { token: \'\346\257\216\346\234\235\', reading: \'\343\201\276\343\201\204\343\201\202\343\201\225\', romaji: \'maiasa\', type: \'Adv\303\251rbio de Tempo\', meaning: \'Toda manh\303\243\' },\n          { token: \'\344\270\203\346\231\202\', reading: \'\343\201\227\343\201\241\343\201\230\', romaji: \'shichiji\', type: \'Substantivo de Hor\303\241rio\', meaning: \'Sete horas\' },\n          { token: \'\343\201\253\', reading: \'\343\201\253\', romaji: \'ni\', type: \'Part\303\255cula de Tempo\', meaning: \'\303\240s (momento exato)\' },\n          { token: \'\350\265\267\343\201\215\343\201\246\', reading: \'\343\201\212\343\201\215\343\201\246\', romaji: \'okite\', type: \'Verbo Ichidan (Forma-TE)\', meaning: \'Acordando e...\' },\n          { token: \'\346\260\264\', reading: \'\343\201\277\343\201\232\', romaji: \'mizu\', type: \'Substantivo\', meaning: \'\303\201gua\' },\n          { token: \'\343\202\222\', reading: \'\343\202\222 (o)\', romaji: \'o\', type: \'Part\303\255cula de Objeto\', meaning: \'marca objeto direto\' },\n          { token: \'\351\243\262\343\201\277\343\201\276\343\201\231\', reading: \'\343\201\256\343\201\277\343\201\276\343\201\231\', romaji: \'nomimasu\', type: \'Verbo Godan (Polido)\', meaning: \'Bebo / Tomo\' },\n        ],\n        grammarNotes:\n          \'A frase utiliza a part\303\255cula de t\303\263pico \343\201\257 (wa), part\303\255cula de tempo espec\303\255fico \343\201\253 (ni), conex\303\243o de a\303\247\303\265es usando a forma-TE (\350\265\267\343\201\215\343\201\246) e part\303\255cula de objeto direto \343\202\222 (o).\',\n        culturalNote: \'O uso de \351\243\262\343\201\277\343\201\276\343\201\231 (forma \343\201\276\343\201\231) demonstra polidez padr\303\243o (teineigo), ideal para conversas respeitosas no dia a dia.\',\n      });\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 py-6 space-y-6\">\n      {/* Header */}\n      <div className=\"bg-gradient-to-r from-stone-900 via-stone-800 to-purple-950 text-white rounded-2xl p-6 sm:p-8 border border-purple-900/30 shadow-lg relative overflow-hidden\">\n        <div className=\"absolute right-4 top-2 opacity-10 text-9xl font-serif select-none pointer-events-none\">\n          \350\247\243\346\236\220\n        </div>\n        <div className=\"max-w-3xl space-y-3 relative z-10\">\n          <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/20 border border-purple-500/40 text-purple-300 text-xs font-semibold\">\n            <Sparkles size={14} />\n            <span>An\303\241lise Morfol\303\263gica & Furigana</span>\n          </div>\n          <h1 className=\"text-2xl sm:text-3xl font-extrabold tracking-tight\">\n            Analisador Inteligente de Frases em Japon\303\252s\n          </h1>\n          <p className=\"text-stone-300 text-sm sm:text-base leading-relaxed\">\n            Cole ou digite qualquer frase em japon\303\252s para obter a quebra palavra por palavra, furigana, romaji, classe gramatical de cada part\303\255cula e tradu\303\247\303\243o completa para o Portugu\303\252s Brasileiro.\n          </p>\n        </div>\n      </div>\n\n      {/* Input Box & Presets */}\n      <div className=\"bg-white rounded-2xl p-6 border border-stone-200 shadow-sm space-y-4\">\n        <div className=\"space-y-2\">\n          <label className=\"text-xs font-bold uppercase tracking-wider text-stone-500\">\n            Digite ou cole uma frase em Japon\303\252s:\n          </label>\n          <div className=\"flex gap-2 flex-col sm:flex-row\">\n            <input\n              type=\"text\"\n              value={inputText}\n              onChange={(e) => setInputText(e.target.value)}\n              placeholder=\"Ex: \347\247\201\343\201\257\346\227\245\346\234\254\350\252\236\343\202\222\345\213\211\345\274\267\343\201\227\343\201\246\343\201\204\343\201\276\343\201\231\343\200\202\"\n              className=\"flex-1 px-4 py-3 text-base bg-stone-50 border border-stone-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-500 focus:bg-white transition\"\n            />\n            <button\n              type=\"button\"\n              onClick={() => handleAnalyze()}\n              disabled={isLoading}\n              className=\"px-6 py-3 bg-purple-600 hover:bg-purple-500 text-white font-bold text-sm rounded-xl shadow-md transition disabled:opacity-50 flex items-center justify-center gap-2 cursor-pointer whitespace-nowrap\"\n            >\n              <Sparkles size={16} />\n              <span>{isLoading ? \'Analisando...\' : \'Analisar Frase\'}</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Presets */}\n        <div className=\"space-y-1.5 pt-1\">\n          <span className=\"text-[11px] font-bold text-stone-400 uppercase\">\n            Ou escolha um exemplo did\303\241tico pronto:\n          </span>\n          <div className=\"flex flex-wrap gap-2\">\n            {PRESET_SENTENCES.map((p, i) => (\n              <button\n                key={i}\n                type=\"button\"\n                onClick={() => {\n                  setInputText(p);\n                  handleAnalyze(p);\n                }}\n                className=\"px-3 py-1.5 bg-stone-100 hover:bg-purple-50 hover:text-purple-700 hover:border-purple-200 border border-stone-200 rounded-lg text-xs font-medium text-stone-700 transition cursor-pointer\"\n              >\n                {p}\n              </button>\n            ))}\n          </div>\n        </div>\n      </div>\n\n      {/* Analysis Output Result */}\n      {result && (\n        <div className=\"bg-white rounded-2xl p-6 sm:p-8 border border-stone-200 shadow-sm space-y-6 animate-fadeIn\">\n          {/* Main Original & Translation */}\n          <div className=\"p-5 rounded-2xl bg-gradient-to-br from-purple-50 to-stone-50 border border-purple-100 space-y-3\">\n            <div className=\"flex items-start justify-between\">\n              <div>\n                <span className=\"text-xs px-2 py-0.5 rounded bg-purple-200 text-purple-900 font-bold\">\n                  {result.jlptLevel || \'JLPT N5\'}\n                </span>\n                <h2 className=\"text-2xl sm:text-3xl font-black text-stone-900 mt-2\">\n                  {result.original}\n                </h2>\n                {result.romaji && (\n                  <p className=\"text-xs text-stone-500 font-mono mt-1\">{result.romaji}</p>\n                )}\n              </div>\n              <AudioButton text={result.original} size=\"lg\" label=\"Ouvir Frase\" />\n            </div>\n\n            <div className=\"pt-2 border-t border-purple-200/60 space-y-1\">\n              <span className=\"text-[11px] font-bold uppercase text-purple-800 tracking-wider\">\n                Tradu\303\247\303\243o em Portugu\303\252s (PT-BR)\n              </span>\n              <p className=\"text-lg font-bold text-stone-800\">\n                \"{result.translation}\"\n              </p>\n              {result.literalTranslation && (\n                <p className=\"text-xs text-stone-500 italic\">\n                  <strong>Tradu\303\247\303\243o Literal:</strong> {result.literalTranslation}\n                </p>\n              )}\n            </div>\n          </div>\n\n          {/* Morphological Token Breakdown */}\n          <div className=\"space-y-3\">\n            <div className=\"flex items-center gap-2\">\n              <Layers size={18} className=\"text-purple-600\" />\n              <h3 className=\"font-extrabold text-stone-900 text-base\">\n                Quebra de Palavras & Part\303\255culas (\345\275\242\346\205\213\347\264\240\350\247\243\346\236\220)\n              </h3>\n            </div>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3\">\n              {result.breakdown?.map((token, idx) => (\n                <div\n                  key={idx}\n                  className=\"p-4 rounded-xl bg-stone-50 border border-stone-200 hover:border-purple-300 transition flex flex-col justify-between space-y-2\"\n                >\n                  <div className=\"flex items-start justify-between\">\n                    <div>\n                      <span className=\"text-xl font-bold text-stone-900 block\">\n                        {token.token}\n                      </span>\n                      {token.reading && token.reading !== token.token && (\n                        <span className=\"text-xs text-stone-500 font-mono\">\n                          ({token.reading})\n                        </span>\n                      )}\n                    </div>\n                    <AudioButton text={token.token} size=\"sm\" />\n                  </div>\n\n                  <div>\n                    <span className=\"text-[10px] font-bold px-1.5 py-0.5 rounded bg-purple-100 text-purple-800\">\n                      {token.type}\n                    </span>\n                    <p className=\"text-xs font-semibold text-stone-700 mt-1\">\n                      {token.meaning}\n                    </p>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n\n          {/* Grammar & Cultural Notes */}\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            {result.grammarNotes && (\n              <div className=\"p-4 rounded-xl bg-stone-50 border border-stone-200 space-y-1.5\">\n                <span className=\"text-xs font-bold text-stone-800 uppercase flex items-center gap-1.5\">\n                  <BookOpen size={14} className=\"text-purple-600\" />\n                  <span>Explica\303\247\303\243o da Estrutura Gramatical</span>\n                </span>\n                <p className=\"text-xs text-stone-600 leading-relaxed\">\n                  {result.grammarNotes}\n                </p>\n              </div>\n            )}\n\n            {result.culturalNote && (\n              <div className=\"p-4 rounded-xl bg-amber-50 border border-amber-200/80 space-y-1.5\">\n                <span className=\"text-xs font-bold text-amber-900 uppercase flex items-center gap-1.5\">\n                  <Sparkles size={14} className=\"text-amber-600\" />\n                  <span>Nuance Cultural & N\303\255vel de Polidez</span>\n                </span>\n                <p className=\"text-xs text-amber-800 leading-relaxed\">\n                  {result.culturalNote}\n                </p>\n              </div>\n            )}\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
